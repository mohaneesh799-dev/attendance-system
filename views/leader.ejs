<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leader Dashboard — Attendance</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root{
            --primary:#1a2a4a;--accent:#3b82f6;--success:#16a34a;
            --danger:#dc2626;--warning:#d97706;--wa:#25D366;
            --bg:#f1f5f9;--card:#fff;--border:#e2e8f0;--text:#1e293b;--muted:#64748b;
        }
        [data-theme="dark"]{
            --bg:#0f1117;--card:#1c1e2a;--border:#2a2d3e;--text:#e1e4eb;--muted:#8892a4;
            --accent:#60a5fa;--success:#4ade80;--danger:#f87171;
        }
        *{box-sizing:border-box;}
        body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);margin:0;padding:0;color:var(--text);}

        /* ── Layout ── */
        .page{max-width:1080px;margin:0 auto;padding:16px;}

        /* ── Header ── */
        .topbar{
            display:flex;justify-content:space-between;align-items:center;
            background:linear-gradient(135deg,var(--primary),#1d4ed8);
            color:#fff;border-radius:16px;padding:18px 22px;
            margin-bottom:18px;flex-wrap:wrap;gap:12px;
        }
        .topbar h1{margin:0;font-size:1.25rem;font-weight:800;}
        .topbar p{margin:4px 0 0;font-size:13px;opacity:.8;}
        .topbar-btns{display:flex;gap:8px;flex-wrap:wrap;}
        .tb-btn{
            display:inline-flex;align-items:center;gap:6px;padding:8px 14px;
            border-radius:8px;font-size:12px;font-weight:700;text-decoration:none;border:none;cursor:pointer;transition:.2s;
        }
        .tb-btn:hover{opacity:.85;transform:translateY(-1px);}
        .tb-white{background:rgba(255,255,255,.15);color:#fff;}
        .tb-danger{background:rgba(255,100,100,.2);color:#fecaca;}

        /* ── Alerts ── */
        .alert{padding:11px 15px;border-radius:10px;font-size:13px;display:flex;align-items:center;gap:9px;margin-bottom:14px;}
        .alert-ok {background:#f0fdf4;color:#15803d;border:1px solid #bbf7d0;}
        .alert-err{background:#fef2f2;color:#b91c1c;border:1px solid #fecaca;}
        [data-theme="dark"] .alert-ok {background:rgba(74,222,128,.1);color:#4ade80;border-color:rgba(74,222,128,.2);}
        [data-theme="dark"] .alert-err{background:rgba(248,113,113,.1);color:#f87171;border-color:rgba(248,113,113,.2);}

        /* ── Cards ── */
        .card{background:var(--card);border-radius:14px;border:1px solid var(--border);padding:20px;margin-bottom:16px;box-shadow:0 2px 8px rgba(0,0,0,.05);}

        /* ── Quick mark ── */
        .qm-box{background:linear-gradient(135deg,#eff6ff,#dbeafe);border:1px solid #bfdbfe;border-radius:14px;padding:18px;margin-bottom:16px;}
        [data-theme="dark"] .qm-box{background:linear-gradient(135deg,rgba(59,130,246,.08),rgba(37,99,235,.12));border-color:rgba(96,165,250,.25);}
        .qm-box h4{margin:0 0 10px 0;font-size:.9rem;font-weight:700;display:flex;align-items:center;gap:7px;}
        .qm-row{display:flex;gap:10px;flex-wrap:wrap;}
        .qm-row input{flex:1;min-width:160px;}
        .qm-tip{font-size:11.5px;color:var(--muted);margin:7px 0 0;}

        /* ── Form fields ── */
        .grid-inputs{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin-bottom:14px;}
        .fg{display:flex;flex-direction:column;gap:5px;}
        .fg label{font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;}
        .fc{
            padding:11px 13px;border-radius:9px;border:1.5px solid var(--border);
            font-size:14px;font-family:inherit;background:var(--bg);color:var(--text);outline:none;transition:.2s;
            width:100%;
        }
        .fc:focus{border-color:var(--accent);background:var(--card);box-shadow:0 0 0 3px rgba(59,130,246,.12);}

        /* ── Section heading ── */
        .sec-heading{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin:20px 0 12px;}
        .sec-heading h3{margin:0;font-size:1rem;font-weight:700;border-left:4px solid var(--accent);padding-left:10px;}

        /* ── Table ── */
        .tbl-wrap{overflow-x:auto;border-radius:10px;border:1px solid var(--border);}
        table{width:100%;border-collapse:collapse;background:var(--card);}
        thead th{background:var(--primary);color:#fff;padding:12px 14px;font-size:12px;text-transform:uppercase;letter-spacing:.4px;text-align:left;white-space:nowrap;}
        tbody td{padding:12px 14px;border-bottom:1px solid var(--border);font-size:13px;vertical-align:middle;}
        tbody tr:last-child td{border-bottom:none;}
        tbody tr:hover{background:rgba(59,130,246,.03);}
        tbody tr.qm-hit{background:#f0fdf4!important;}
        [data-theme="dark"] tbody tr.qm-hit{background:rgba(74,222,128,.08)!important;}

        /* ── Checkbox ── */
        .cb-wrap{display:flex;align-items:center;gap:8px;cursor:pointer;}
        input[type="checkbox"]{width:17px;height:17px;accent-color:var(--accent);cursor:pointer;flex-shrink:0;}

        /* ── Buttons ── */
        .btn{display:inline-flex;align-items:center;gap:7px;padding:10px 18px;border:none;border-radius:9px;font-size:14px;font-weight:700;cursor:pointer;transition:.2s;text-decoration:none;}
        .btn:hover{opacity:.88;transform:translateY(-1px);}
        .btn-primary{background:var(--primary);color:#fff;}
        .btn-accent {background:var(--accent);color:#fff;}
        .btn-success{background:var(--success);color:#fff;}
        .btn-danger {background:var(--danger);color:#fff;}
        .btn-wa     {background:var(--wa);color:#fff;}
        .btn-ghost  {background:var(--bg);color:var(--text);border:1.5px solid var(--border);}
        .btn-ghost:hover{border-color:var(--accent);color:var(--accent);}
        .btn-full{width:100%;justify-content:center;}

        /* ── Action bar ── */
        .action-bar{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px;}
        .action-bar .btn{flex:1;min-width:130px;}

        /* ── Report card ── */
        .report-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
        @media(max-width:500px){.report-grid{grid-template-columns:1fr;}}

        /* ── Badge ── */
        .badge{padding:3px 9px;border-radius:20px;font-size:11px;font-weight:700;}
        .badge-leader{background:#ede9fe;color:#7c3aed;}

        /* ── Present counter ── */
        #presentCount{font-size:13px;font-weight:600;color:var(--accent);}

        /* ── Quick mark feedback ── */
        .qm-feedback{
            display:none;padding:10px 14px;border-radius:9px;font-size:13px;
            font-weight:600;margin-top:10px;align-items:center;gap:8px;
        }
        .qm-feedback.show{display:flex;}
        .qm-feedback.ok {background:#f0fdf4;color:#15803d;border:1px solid #bbf7d0;}
        .qm-feedback.no {background:#fef2f2;color:#b91c1c;border:1px solid #fecaca;}

        @media(max-width:640px){
            .topbar{padding:14px 16px;}
            .topbar h1{font-size:1.1rem;}
            .card{padding:14px;}
            .qm-box{padding:14px;}
        }
    </style>
    <script>(function(){var t=localStorage.getItem('rku-theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
</head>
<body>
<div class="page">

    <!-- Header -->
    <div class="topbar">
        <div>
            <h1><i class="fas fa-clipboard-check"></i> Attendance Entry</h1>
            <p>Leader: <strong><%= user.name %></strong> &nbsp;·&nbsp; Section: <strong><%= user.section %></strong></p>
        </div>
        <div class="topbar-btns">
            <% var leaderRoles = user.roles && user.roles.length > 1 ? user.roles : null; %>
            <% if (leaderRoles) { %>
            <form action="/switch-role" method="POST" style="display:flex;gap:6px;align-items:center;">
                <select name="targetRole" style="padding:7px 10px;border-radius:8px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.1);color:#fff;font-size:12px;font-weight:700;outline:none;cursor:pointer;">
                    <% leaderRoles.forEach(function(r){ %>
                        <option value="<%= r %>" style="background:#1a2a4a;" <%= r === user.role ? 'selected' : '' %>><%= r %></option>
                    <% }); %>
                </select>
                <button type="submit" style="padding:7px 12px;background:rgba(59,130,246,.3);color:#93c5fd;border:1px solid rgba(59,130,246,.3);border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;">
                    <i class="fas fa-exchange-alt"></i> Switch
                </button>
            </form>
            <% } %>
            <a href="/attendance-history" class="tb-btn tb-white"><i class="fas fa-history"></i> History</a>
            <a href="/settings" class="tb-btn tb-white"><i class="fas fa-cog"></i> Settings</a>
            <a href="/logout" class="tb-btn tb-danger"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </div>

    <!-- Flash messages -->
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-ok"><i class="fas fa-check-circle"></i> <%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-err"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>

    <!-- ── Quick Mark Panel ── -->
    <div class="qm-box">
        <h4><i class="fas fa-bolt" style="color:#f59e0b;"></i> Quick Mark Present by Roll Numbers</h4>
        <div class="qm-row">
            <input type="text" id="quickInput" class="fc" placeholder="e.g. 101, 102, 105 or paste a list…">
            <button type="button" class="btn btn-accent" onclick="applyQuickMark()">
                <i class="fas fa-check-double"></i> Mark Present
            </button>
        </div>
        <p class="qm-tip"><i class="fas fa-info-circle"></i> Enter comma-separated roll numbers. Supports leading zeros (01 = 1). Hit <strong>Mark Present</strong> to highlight matching students in the table below.</p>
        <div class="qm-feedback" id="qmFeedback"></div>
    </div>

    <!-- ── Attendance Form ── -->
    <form action="/lock-attendance" method="POST" id="attendanceForm">
        <input type="hidden" name="section" value="<%= user.section %>">

        <div class="card">
            <div class="sec-heading">
                <h3><i class="fas fa-info-circle"></i> Session Details</h3>
            </div>
            <div class="grid-inputs">
                <div class="fg">
                    <label>Assigned Lecturer</label>
                    <select name="lecturerEmail" class="fc" required>
                        <option value="">— Select Lecturer —</option>
                        <% const lecturerList = typeof lecturers !== 'undefined' ? lecturers : [];
                           lecturerList.forEach(function(l){ %>
                            <option value="<%= l.email %>"><%= l.name %> &lt;<%= l.email %>&gt;</option>
                        <% }); %>
                    </select>
                </div>
                <div class="fg">
                    <label>Period / Time Slot</label>
                    <input type="text" name="manualTime" class="fc" placeholder="e.g. 09:00 AM – 10:00 AM" required>
                </div>
                <div class="fg">
                    <label>Class Date</label>
                    <input type="date" name="date" id="currentDate" class="fc" value="<%= new Date().toISOString().split('T')[0] %>" required>
                </div>
                <div class="fg">
                    <label>Subject</label>
                    <select name="subject" class="fc" required>
                        <option value="">— Select Subject —</option>
                        <% if (masterSubjects && masterSubjects.length > 0) {
                               masterSubjects.forEach(function(sub){ %>
                            <option value="<%= sub.name %>"><%= sub.name %><% if(sub.code){ %> (<%= sub.code %>)<% } %></option>
                        <% }); } else { %>
                            <option disabled>No subjects — ask Master to add subjects</option>
                        <% } %>
                    </select>
                </div>
            </div>
        </div>

        <!-- ── Student Table ── -->
        <div class="card">
            <div class="sec-heading">
                <h3><i class="fas fa-users"></i> Students — Section <%= user.section %></h3>
                <span id="presentCount">0 marked present</span>
            </div>

            <% if (allUsers && allUsers.length > 0) { %>
                <!-- Desktop table -->
                <div class="tbl-wrap">
                    <table id="studentTable">
                        <thead>
                            <tr>
                                <th style="width:50px;">#</th>
                                <th style="width:110px;">Roll No</th>
                                <th>Student Name</th>
                                <th style="width:160px;">Present</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% let idx = 0;
                               allUsers.forEach(function(u){
                                 if(u.role==='Master'||u.role==='Lecturer'||u.role==='SuperAdmin') return; %>
                            <tr id="row-<%= idx %>">
                                <td style="color:var(--muted);font-size:12px;"><%= idx + 1 %></td>
                                <td class="roll-col" style="font-family:monospace;font-weight:700;color:var(--accent);">
                                    <%= u.rollNo || u.rollno || '—' %>
                                </td>
                                <td>
                                    <%= u.name %>
                                    <% if(u.role==='Leader'){ %>
                                        <span class="badge badge-leader">Leader</span>
                                    <% } %>
                                </td>
                                <td>
                                    <input type="hidden" name="students[<%= idx %>][id]"   value="<%= u.rollNo || u.rollno || '' %>">
                                    <input type="hidden" name="students[<%= idx %>][name]" value="<%= u.name %>">
                                    <label class="cb-wrap">
                                        <input type="checkbox"
                                               name="students[<%= idx %>][status]"
                                               value="Present"
                                               class="student-checkbox"
                                               data-row="<%= idx %>"
                                               onchange="updateCount()">
                                        <span>Present</span>
                                    </label>
                                </td>
                            </tr>
                            <% idx++; }); %>
                        </tbody>
                    </table>
                </div>

                <div class="action-bar">
                    <button type="button" class="btn btn-success" onclick="markAll(true)">
                        <i class="fas fa-check-double"></i> Mark All Present
                    </button>
                    <button type="button" class="btn btn-ghost" onclick="markAll(false)">
                        <i class="fas fa-times"></i> Clear All
                    </button>
                </div>

            <% } else { %>
                <div style="text-align:center;padding:50px 20px;color:var(--muted);">
                    <i class="fas fa-user-slash" style="font-size:2.5rem;opacity:.3;display:block;margin-bottom:12px;"></i>
                    <p>No students found in Section <%= user.section %>.<br>Ask your Master to add students.</p>
                </div>
            <% } %>

            <button type="submit" class="btn btn-danger btn-full" style="margin-top:18px;padding:15px;font-size:15px;">
                <i class="fas fa-lock"></i> Finalize &amp; Lock Attendance
            </button>
        </div>
    </form>

    <!-- ── Reports ── -->
    <div class="card">
        <div class="sec-heading">
            <h3><i class="fas fa-file-alt"></i> Report Management</h3>
        </div>
        <div class="report-grid">
            <div class="fg">
                <label>Filter By Status</label>
                <select id="reportFilter" class="fc">
                    <option value="">Full List (All Students)</option>
                    <option value="Present">Present Students Only</option>
                    <option value="Absent">Absent Students Only</option>
                </select>
            </div>
            <div class="fg" style="justify-content:flex-end;">
                <label>&nbsp;</label>
                <button type="button" class="btn btn-accent" onclick="downloadPDF()">
                    <i class="fas fa-file-pdf"></i> Download PDF
                </button>
            </div>
        </div>
        <button type="button" class="btn btn-wa btn-full" style="margin-top:12px;" onclick="submitToWhatsApp()">
            <i class="fab fa-whatsapp"></i> Share Report via WhatsApp
        </button>
    </div>

</div><!-- /page -->

<script>
document.addEventListener('DOMContentLoaded', function() {
    updateCount();

    // ── Form submit: append Absent for unchecked students ──
    document.getElementById('attendanceForm').addEventListener('submit', function(e) {
        if (!confirm('Lock this attendance? This cannot be undone.')) {
            e.preventDefault();
            return;
        }
        var form = this;
        document.querySelectorAll('.student-checkbox').forEach(function(cb) {
            if (!cb.checked) {
                var h = document.createElement('input');
                h.type  = 'hidden';
                h.name  = cb.name;
                h.value = 'Absent';
                form.appendChild(h);
            }
        });
    });
});

// ── Live present counter ──
function updateCount() {
    var total   = document.querySelectorAll('.student-checkbox').length;
    var present = document.querySelectorAll('.student-checkbox:checked').length;
    var el = document.getElementById('presentCount');
    if (el) el.textContent = present + ' / ' + total + ' marked present';
}

// ── Mark All / Clear All ──
function markAll(val) {
    document.querySelectorAll('.student-checkbox').forEach(function(cb) {
        cb.checked = val;
        var row = cb.closest('tr');
        if (row) row.classList.toggle('qm-hit', val);
    });
    updateCount();
}

// ── Normalize roll numbers (strips leading zeros, trims whitespace) ──
function normalizeRoll(r) {
    return String(r).replace(/\s+/g, '').toLowerCase().replace(/^0+/, '') || '0';
}

// ── Quick Mark ──
function applyQuickMark() {
    var input = (document.getElementById('quickInput').value || '').trim();
    var feedback = document.getElementById('qmFeedback');

    // Reset feedback
    feedback.className = 'qm-feedback';
    feedback.textContent = '';

    if (!input) {
        feedback.className = 'qm-feedback show no';
        feedback.innerHTML = '<i class="fas fa-exclamation-circle"></i> Please enter at least one roll number.';
        return;
    }

    // Parse input — supports commas, spaces, newlines as separators
    var rollsToMark = input.split(/[\s,;|\n\t]+/)
        .map(function(r){ return normalizeRoll(r); })
        .filter(function(r){ return r && r !== '0' || r === '0'; });

    // Remove duplicates
    rollsToMark = rollsToMark.filter(function(v, i, a){ return a.indexOf(v) === i; });

    if (rollsToMark.length === 0) {
        feedback.className = 'qm-feedback show no';
        feedback.innerHTML = '<i class="fas fa-exclamation-circle"></i> No valid roll numbers found in input.';
        return;
    }

    var rows = document.querySelectorAll('#studentTable tbody tr');
    var matchedCount = 0;
    var notFound = [];

    rows.forEach(function(row) {
        var cellEl = row.querySelector('.roll-col');
        if (!cellEl) return;
        // Use textContent (more reliable than innerText) and normalize
        var cellRoll = normalizeRoll(cellEl.textContent || cellEl.innerText || '');
        if (!cellRoll || cellRoll === '—' || cellRoll === '-') return;

        var checkbox = row.querySelector('.student-checkbox');
        if (!checkbox) return;

        if (rollsToMark.indexOf(cellRoll) !== -1) {
            checkbox.checked = true;
            row.classList.add('qm-hit');
            matchedCount++;
        }
    });

    // Find which rolls were NOT found in the table
    var foundRolls = [];
    rows.forEach(function(row) {
        var cellEl = row.querySelector('.roll-col');
        if (cellEl) foundRolls.push(normalizeRoll(cellEl.textContent || ''));
    });
    notFound = rollsToMark.filter(function(r){ return foundRolls.indexOf(r) === -1; });

    updateCount();

    if (matchedCount > 0) {
        document.getElementById('quickInput').value = '';
        var msg = '<i class="fas fa-check-circle"></i> ' + matchedCount + ' student(s) marked Present.';
        if (notFound.length > 0) {
            msg += ' &nbsp;<span style="font-weight:400;opacity:.8;">Not found: ' + notFound.join(', ') + '</span>';
        }
        feedback.className = 'qm-feedback show ok';
        feedback.innerHTML = msg;
    } else {
        feedback.className = 'qm-feedback show no';
        feedback.innerHTML = '<i class="fas fa-times-circle"></i> No matching roll numbers found. Entered: ' + rollsToMark.join(', ');
    }

    // Auto-hide feedback after 5 seconds
    setTimeout(function() {
        feedback.className = 'qm-feedback';
    }, 5000);
}

// ── Allow pressing Enter in quick input ──
document.addEventListener('DOMContentLoaded', function() {
    var qi = document.getElementById('quickInput');
    if (qi) {
        qi.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') { e.preventDefault(); applyQuickMark(); }
        });
    }
});

function downloadPDF() {
    var date   = document.getElementById('currentDate').value;
    var filter = document.getElementById('reportFilter').value;
    if (!date) { alert('Please select a date first.'); return; }
    window.open('/generate-day-pdf/' + date + '?filter=' + encodeURIComponent(filter), '_blank');
}

function submitToWhatsApp() {
    var date   = document.getElementById('currentDate').value;
    var filter = document.getElementById('reportFilter').value;
    if (!date) { alert('Please select a date first.'); return; }
    var pdfUrl = window.location.origin + '/generate-day-pdf/' + date + '?filter=' + encodeURIComponent(filter);
    var msg = '*Attendance Report — ' + date + '*\nSection: <%= user.section %>\nType: ' + (filter || 'Full List') + '\n\nPDF Link:\n' + pdfUrl;
    window.open('https://api.whatsapp.com/send?text=' + encodeURIComponent(msg), '_blank');
}
</script>
</body>
</html>
