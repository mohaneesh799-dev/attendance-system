<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Error | RKU Attendance Portal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --danger: #e74c3c; --primary: #2c3e50; --bg: #f8f9fa; }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg);
            min-height: 100vh; display: flex; align-items: center; justify-content: center;
            padding: 20px;
        }
        .error-card {
            background: white; padding: 44px 40px;
            border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            max-width: 520px; width: 100%; text-align: center;
            border-top: 6px solid var(--danger);
        }
        .error-icon { font-size: 72px; color: var(--danger); margin-bottom: 18px; }
        h1 { color: var(--primary); margin: 0 0 12px 0; font-size: 22px; }
        .message {
            color: #7f8c8d; line-height: 1.6; margin-bottom: 28px; font-size: 14px;
            background: #fef9f9; border-radius: 8px; padding: 12px 16px;
            border: 1px solid #fde8e8; word-break: break-word;
        }
        .btn-group { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 16px; }
        .btn {
            padding: 11px 22px; border-radius: 8px; text-decoration: none; font-weight: 600;
            transition: 0.25s; font-size: 13px; display: inline-flex; align-items: center;
            gap: 7px; cursor: pointer; border: none;
        }
        .btn-home { background: var(--primary); color: white; }
        .btn-home:hover { background: #34495e; transform: translateY(-1px); }
        .btn-back { background: #ecf0f1; color: var(--primary); }
        .btn-back:hover { background: #d5dbdb; }
        .btn-clear { background: #fff3cd; color: #856404; border: 1px solid #ffc107; margin-top: 6px; }
        .btn-clear:hover { background: #ffc107; color: #000; transform: translateY(-1px); }
        .hint { font-size: 12px; color: #95a5a6; margin-top: 14px; padding: 10px 14px; background: #f8f9fa; border-radius: 8px; }
        .error-code { margin-top: 20px; font-family: monospace; font-size: 11px; color: #bdc3c7; text-transform: uppercase; }
    </style>
</head>
<body>
<div class="error-card">
    <div class="error-icon"><i class="fas fa-exclamation-circle"></i></div>
    <h1>Oops! Something went wrong</h1>
    <div class="message">
        <%= typeof message !== 'undefined' && message
            ? message
            : "The server encountered an unexpected error. Please clear your session and try logging in again." %>
    </div>
    <div class="btn-group">
        <button onclick="window.history.back()" class="btn btn-back">
            <i class="fas fa-arrow-left"></i> Go Back
        </button>
        <a href="/login" class="btn btn-home">
            <i class="fas fa-sign-in-alt"></i> Back to Login
        </a>
    </div>
    <a href="/clear-session" class="btn btn-clear"
       onclick="return confirm('Clear your session and go to login page?')">
        <i class="fas fa-sync-alt"></i> Fix: Clear Session &amp; Re-login
    </a>
    <div class="hint">
        <i class="fas fa-lightbulb"></i>
        <strong>Tip:</strong> The "Clear Session &amp; Re-login" button above fixes most errors — it resets your login state safely.
    </div>
    <div class="error-code">Error Logged: <%= new Date().toLocaleTimeString() %></div>
</div>
</body>
</html>
