<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Settings</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* ── CSS Variables — Light & Dark ── */
        :root{
            --bg:#f0f4f8;--card:#fff;--border:#e2e8f0;--text:#1e293b;
            --muted:#64748b;--input-bg:#f8fafc;--input-bd:#e2e8f0;
            --accent:#3b82f6;--accent-d:#2563eb;--success:#16a34a;--danger:#dc2626;
            --shadow:0 8px 24px rgba(0,0,0,.08);
            --tog-off:#d1d5db;--tog-on:#3b82f6;
        }
        [data-theme="dark"]{
            /* Eye-comfort dark: warm deep blue-gray, no harsh whites */
            --bg:#0d1117;--card:#161b22;--border:#21262d;--text:#c9d1d9;
            --muted:#8b949e;--input-bg:#0d1117;--input-bd:#30363d;
            --accent:#58a6ff;--accent-d:#388bfd;--success:#3fb950;--danger:#f85149;
            --shadow:0 8px 24px rgba(0,0,0,.4);
            --tog-off:#30363d;--tog-on:#58a6ff;
        }
        *{box-sizing:border-box;margin:0;padding:0;}
        html,body{transition:background .25s,color .25s;}
        body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;padding:16px;}

        .page{max-width:600px;margin:20px auto;}

        .back-link{
            display:inline-flex;align-items:center;gap:7px;
            color:var(--muted);text-decoration:none;font-size:13px;font-weight:600;
            padding:6px 0;margin-bottom:18px;transition:.15s;
        }
        .back-link:hover{color:var(--accent);}

        .card{
            background:var(--card);border-radius:16px;border:1px solid var(--border);
            box-shadow:var(--shadow);margin-bottom:14px;overflow:hidden;
        }
        .card-hdr{
            padding:18px 22px;border-bottom:1px solid var(--border);
            display:flex;align-items:center;gap:12px;
        }
        .card-icon{
            width:38px;height:38px;border-radius:10px;
            display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;
        }
        .ic-blue  {background:rgba(59,130,246,.12);color:var(--accent);}
        .ic-purple{background:rgba(139,92,246,.12);color:#8b5cf6;}
        .card-hdr-text h3{margin:0;font-size:.95rem;font-weight:700;}
        .card-hdr-text p {margin:2px 0 0;font-size:12px;color:var(--muted);}
        .card-body{padding:20px 22px;}

        /* ── Alerts ── */
        .msg{
            display:flex;align-items:center;gap:9px;padding:12px 16px;
            border-radius:10px;font-size:13px;font-weight:500;margin-bottom:16px;
        }
        .msg.ok {background:rgba(22,163,74,.1);color:var(--success);border:1px solid rgba(22,163,74,.25);}
        .msg.err{background:rgba(220,38,38,.08);color:var(--danger);border:1px solid rgba(220,38,38,.2);}

        /* ── Form fields ── */
        .fg{margin-bottom:16px;}
        .fg label{display:block;font-size:11.5px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.45px;margin-bottom:6px;}
        .fc{
            width:100%;padding:11px 14px;border-radius:10px;border:1.5px solid var(--input-bd);
            font-size:14px;font-family:inherit;background:var(--input-bg);color:var(--text);
            outline:none;transition:.2s;
        }
        .fc:focus{border-color:var(--accent);background:var(--card);box-shadow:0 0 0 3px rgba(59,130,246,.1);}
        .fc[readonly]{opacity:.55;cursor:not-allowed;}
        .divider{border:none;border-top:1px solid var(--border);margin:18px 0;}

        .btn-save{
            width:100%;padding:13px;border:none;border-radius:11px;
            font-size:15px;font-weight:700;cursor:pointer;transition:.2s;
            background:linear-gradient(135deg,var(--accent),var(--accent-d));color:#fff;
            display:flex;align-items:center;justify-content:center;gap:8px;
        }
        .btn-save:hover{transform:translateY(-2px);box-shadow:0 6px 18px rgba(59,130,246,.3);}

        /* ── Theme rows ── */
        .theme-row{
            display:flex;align-items:center;justify-content:space-between;
            padding:14px 0;border-bottom:1px solid var(--border);
        }
        .theme-row:last-child{border-bottom:none;}
        .theme-info{display:flex;align-items:center;gap:14px;}
        .theme-emoji{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;}
        .te-sun {background:#fef3c7;}
        .te-moon{background:#1e1b4b;}
        .t-label{font-weight:700;font-size:14px;}
        .t-desc {font-size:12px;color:var(--muted);margin-top:3px;}

        /* Toggle switch */
        .tog-wrap{display:flex;align-items:center;gap:10px;}
        .tog-label{font-size:11px;font-weight:700;color:var(--muted);min-width:34px;}
        .tog{
            width:50px;height:26px;border-radius:13px;border:none;cursor:pointer;
            background:var(--tog-off);position:relative;transition:background .25s;outline:none;flex-shrink:0;
        }
        .tog::after{
            content:'';position:absolute;width:20px;height:20px;
            background:#fff;border-radius:50%;top:3px;left:3px;
            transition:transform .25s;box-shadow:0 1px 4px rgba(0,0,0,.25);
        }
        .tog.on{background:var(--tog-on);}
        .tog.on::after{transform:translateX(24px);}

        /* Active theme indicator */
        .active-tag{
            font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;
        }
        .at-light{background:#fef9c3;color:#854d0e;}
        .at-dark {background:rgba(88,166,255,.15);color:var(--accent);}

        @media(max-width:460px){
            .card-body,.card-hdr{padding:16px;}
        }
    </style>
    <script>(function(){var t=localStorage.getItem('rku-theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
</head>
<body>
<div class="page">

    <a href="/<%= user.role.toLowerCase() %>" class="back-link">
        <i class="fas fa-arrow-left"></i> Back to Dashboard
    </a>

    <% if (typeof message !== 'undefined' && message) { %>
        <div class="msg <%= messageType === 'success' ? 'ok' : 'err' %>">
            <i class="fas fa-<%= messageType === 'success' ? 'check-circle' : 'exclamation-circle' %>"></i>
            <%= message %>
        </div>
    <% } %>

    <!-- Profile Card -->
    <div class="card">
        <div class="card-hdr">
            <div class="card-icon ic-blue"><i class="fas fa-user-circle"></i></div>
            <div class="card-hdr-text">
                <h3>Profile Settings</h3>
                <p>Update your name, phone and password</p>
            </div>
        </div>
        <div class="card-body">
            <form action="/update-settings" method="POST">
                <div class="fg">
                    <label>Full Name</label>
                    <input type="text" name="name" class="fc" value="<%= user.name %>" required>
                </div>
                <div class="fg">
                    <label>Email Address</label>
                    <input type="email" class="fc" value="<%= user.email %>" readonly>
                </div>
                <div class="fg">
                    <label>WhatsApp / Phone</label>
                    <input type="text" name="phone" class="fc" value="<%= user.phone || '' %>" placeholder="e.g. 919876543210">
                </div>
                <div class="fg">
                    <label>Role</label>
                    <input type="text" class="fc" value="<%= user.role %>" readonly>
                </div>
                <% if (user.section) { %>
                <div class="fg">
                    <label>Division / Section</label>
                    <input type="text" class="fc" value="<%= user.section %>" readonly>
                </div>
                <% } %>

                <hr class="divider">
                <div style="font-size:.85rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:14px;">
                    <i class="fas fa-lock"></i> &nbsp;Change Password
                </div>
                <% if (user.googleId && !user.password) { %>
                <div class="msg ok" style="margin-bottom:14px;">
                    <i class="fas fa-info-circle"></i> You signed in with Google — password change is not available.
                </div>
                <% } else { %>
                <div class="fg">
                    <label>Current Password</label>
                    <input type="password" name="currentPassword" class="fc" placeholder="Required to authorize changes">
                </div>
                <div class="fg">
                    <label>New Password <span style="font-weight:400;text-transform:none;">(leave blank to keep current)</span></label>
                    <input type="password" name="newPassword" class="fc" placeholder="Min. 6 characters">
                </div>
                <% } %>
                <button type="submit" class="btn-save">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </form>
        </div>
    </div>

    <!-- Appearance Card -->
    <div class="card">
        <div class="card-hdr">
            <div class="card-icon ic-purple"><i class="fas fa-palette"></i></div>
            <div class="card-hdr-text">
                <h3>Appearance</h3>
                <p>Choose your preferred theme</p>
            </div>
        </div>
        <div class="card-body">

            <div class="theme-row">
                <div class="theme-info">
                    <div class="theme-emoji te-sun">☀️</div>
                    <div>
                        <div class="t-label">Light Mode</div>
                        <div class="t-desc">Clean white background — default</div>
                    </div>
                </div>
                <span class="active-tag at-light" id="lightTag" style="display:none;">Active</span>
            </div>

            <div class="theme-row">
                <div class="theme-info">
                    <div class="theme-emoji te-moon">🌙</div>
                    <div>
                        <div class="t-label">Dark Mode</div>
                        <div class="t-desc">Warm deep-blue — reduces eye strain at night</div>
                    </div>
                </div>
                <span class="active-tag at-dark" id="darkTag" style="display:none;">Active</span>
            </div>

            <div style="display:flex;align-items:center;gap:14px;padding-top:16px;border-top:1px solid var(--border);margin-top:14px;">
                <span style="font-size:13px;font-weight:600;color:var(--muted);">☀️ Light</span>
                <button class="tog" id="themeToggle" onclick="toggleTheme()" type="button" aria-label="Toggle dark mode"></button>
                <span style="font-size:13px;font-weight:600;color:var(--muted);">🌙 Dark</span>
                <span id="themeStatus" style="margin-left:auto;font-size:12px;color:var(--muted);"></span>
            </div>

        </div>
    </div>

</div>

<script>
    document.addEventListener('DOMContentLoaded', syncThemeUI);

    function syncThemeUI() {
        var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        var tog = document.getElementById('themeToggle');
        var lt  = document.getElementById('lightTag');
        var dt  = document.getElementById('darkTag');
        var st  = document.getElementById('themeStatus');
        if (tog) tog.className = 'tog' + (isDark ? ' on' : '');
        if (lt)  lt.style.display  = isDark ? 'none'  : 'inline-block';
        if (dt)  dt.style.display  = isDark ? 'inline-block' : 'none';
        if (st)  st.textContent = isDark ? 'Dark mode active' : 'Light mode active';
    }

    function toggleTheme() {
        var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        var next   = isDark ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('rku-theme', next);
        syncThemeUI();
    }
</script>
</body>
</html>
