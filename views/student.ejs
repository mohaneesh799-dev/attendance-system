<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Attendance — <%= user.name %></title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<script>(function(){var t=localStorage.getItem('rku-theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
<style>
:root{
  --pri:#0d1b3e;--pri2:#162d5a;
  --acc:#4f7ef7;--acc2:#2563eb;--acc-glow:rgba(79,126,247,.18);
  --suc:#10b981;--dan:#ef4444;--war:#f59e0b;
  --bg:#f0f4fb;--card:#fff;--border:#e4eaf4;
  --text:#0e1526;--muted:#64748b;
  --input-bg:#f6f9ff;--input-bd:#d4daea;
  --shadow:0 2px 16px rgba(14,21,38,.07);
  --shadow-lg:0 8px 36px rgba(14,21,38,.13);
  --radius:16px;--radius-sm:10px;
}
[data-theme="dark"]{
  --bg:#080e1d;--card:#0e1828;--border:#172035;
  --text:#cdd9ee;--muted:#5e7898;
  --input-bg:#0a1120;--input-bd:#1b2d4a;
  --shadow:0 2px 20px rgba(0,0,0,.35);
  --shadow-lg:0 8px 40px rgba(0,0,0,.55);
  --pri:#060e20;--pri2:#0d1b36;
  --acc:#6b93fa;--acc2:#4f7ef7;--acc-glow:rgba(107,147,250,.15);
  --suc:#34d399;--dan:#f87171;--war:#fbbf24;
}
*{box-sizing:border-box;margin:0;padding:0;}
html,body{transition:background .25s,color .25s;}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;padding:20px 16px 40px;}

.page{max-width:1040px;margin:0 auto;}

/* ── HEADER ── */
.hero{
  background:linear-gradient(135deg,var(--pri) 0%,var(--pri2) 60%,#1e4fd8 100%);
  border-radius:var(--radius);padding:24px 28px;margin-bottom:22px;
  display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;
  box-shadow:0 8px 32px rgba(13,27,62,.35);position:relative;overflow:hidden;
}
.hero::before{
  content:'';position:absolute;right:-60px;top:-60px;
  width:220px;height:220px;border-radius:50%;
  background:rgba(255,255,255,.04);pointer-events:none;
}
.hero-left h1{font-size:1.35rem;font-weight:800;color:#fff;letter-spacing:-.2px;}
.hero-left p{font-size:13px;color:rgba(255,255,255,.65);margin-top:5px;}
.hero-right{display:flex;gap:8px;flex-wrap:wrap;align-items:center;}
.chip{background:rgba(255,255,255,.12);color:#fff;padding:6px 14px;border-radius:20px;font-size:12px;font-weight:700;border:1px solid rgba(255,255,255,.15);}
.hero-btn{
  display:inline-flex;align-items:center;gap:7px;padding:8px 15px;
  border-radius:var(--radius-sm);font-size:12.5px;font-weight:700;
  text-decoration:none;border:none;cursor:pointer;transition:.2s;
  background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.18);
}
.hero-btn:hover{background:rgba(255,255,255,.22);}
.hero-btn.danger{background:rgba(239,68,68,.2);border-color:rgba(239,68,68,.3);color:#fca5a5;}
.hero-btn.danger:hover{background:rgba(239,68,68,.35);}

/* ── BANNERS ── */
.banner{display:flex;align-items:flex-start;gap:12px;padding:13px 16px;border-radius:var(--radius-sm);font-size:13.5px;font-weight:500;margin-bottom:16px;}
.ban-warn{background:rgba(245,158,11,.08);color:#92400e;border:1px solid rgba(245,158,11,.25);border-left:4px solid var(--war);}
.ban-good{background:rgba(16,185,129,.07);color:#064e3b;border:1px solid rgba(16,185,129,.2);border-left:4px solid var(--suc);}
[data-theme="dark"] .ban-warn{background:rgba(245,158,11,.1);color:#fbbf24;}
[data-theme="dark"] .ban-good{background:rgba(16,185,129,.08);color:#34d399;}

/* ── STATS ── */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:22px;}
.stat-card{
  background:var(--card);border:1px solid var(--border);border-radius:var(--radius);
  padding:20px 18px;box-shadow:var(--shadow);transition:.22s;display:flex;flex-direction:column;gap:10px;
}
.stat-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg);}
.stat-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.15rem;flex-shrink:0;}
.stat-val{font-size:2.1rem;font-weight:900;letter-spacing:-1px;line-height:1;}
.stat-lbl{font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);font-weight:700;}
.pbar{height:6px;background:var(--border);border-radius:4px;overflow:hidden;margin-top:8px;}
.pfill{height:100%;border-radius:4px;transition:width 1.2s cubic-bezier(.4,0,.2,1);}

/* ── CARD ── */
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);margin-bottom:20px;overflow:hidden;}
.card-hdr{padding:18px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;}
.card-hdr h3{font-size:1rem;font-weight:800;display:flex;align-items:center;gap:9px;margin:0;}
.card-body{padding:20px 22px;}

/* ── SUBJECT GRID ── */
.subj-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px;margin-bottom:22px;}
.sc{
  background:var(--card);border:1.5px solid var(--border);border-radius:var(--radius-sm);
  padding:18px;transition:.22s;position:relative;overflow:hidden;
}
.sc::after{content:'';position:absolute;top:0;left:0;width:3px;height:100%;background:currentColor;opacity:.35;}
.sc:hover{border-color:var(--acc);box-shadow:var(--shadow-lg);}
.sc .sn{font-weight:800;font-size:.95rem;margin-bottom:4px;}
.sc .sc2{font-size:12px;color:var(--muted);margin-bottom:12px;}
.sc .sp{font-size:2rem;font-weight:900;letter-spacing:-1px;line-height:1;}
.sc-tag{font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;display:inline-block;margin-top:8px;}
.t-ok{color:#047857;background:rgba(16,185,129,.1);}
.t-risk{color:#b45309;background:rgba(245,158,11,.1);}
.t-low{color:#b91c1c;background:rgba(239,68,68,.1);}
[data-theme="dark"] .t-ok{color:#34d399;background:rgba(52,211,153,.12);}
[data-theme="dark"] .t-risk{color:#fbbf24;background:rgba(251,191,36,.12);}
[data-theme="dark"] .t-low{color:#f87171;background:rgba(248,113,113,.12);}

/* ── TABLE ── */
.tbl-wrap{overflow-x:auto;}
table{width:100%;border-collapse:collapse;}
thead th{
  background:var(--input-bg);color:var(--muted);
  font-size:11px;text-transform:uppercase;letter-spacing:.5px;
  padding:12px 16px;border-bottom:2px solid var(--border);text-align:left;white-space:nowrap;
}
tbody td{padding:13px 16px;border-bottom:1px solid var(--border);font-size:13.5px;vertical-align:middle;}
tbody tr:last-child td{border-bottom:none;}
tbody tr:hover td{background:rgba(79,126,247,.025);}
.tfoot-row td{background:var(--input-bg);font-weight:700;}

/* ── PILLS / STATUS ── */
.pill{padding:4px 11px;border-radius:7px;font-size:11.5px;font-weight:700;white-space:nowrap;display:inline-flex;align-items:center;gap:5px;}
.p-present{background:rgba(16,185,129,.1);color:#047857;}
.p-absent{background:rgba(239,68,68,.08);color:#b91c1c;}
.p-na{background:var(--input-bg);color:var(--muted);}
[data-theme="dark"] .p-present{background:rgba(52,211,153,.12);color:#34d399;}
[data-theme="dark"] .p-absent{background:rgba(248,113,113,.1);color:#f87171;}

/* ── BUTTONS ── */
.btn-sm{display:inline-flex;align-items:center;gap:6px;padding:8px 15px;border-radius:var(--radius-sm);font-size:13px;font-weight:700;text-decoration:none;border:1.5px solid var(--border);cursor:pointer;transition:.2s;background:var(--card);color:var(--text);}
.btn-sm:hover{border-color:var(--acc);color:var(--acc);}
.btn-sm.filled{background:var(--acc);color:#fff;border-color:var(--acc);}
.btn-sm.filled:hover{background:var(--acc2);border-color:var(--acc2);}

/* ── THEME TOGGLE ── */
.theme-btn{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);color:#fff;padding:7px 11px;border-radius:var(--radius-sm);cursor:pointer;font-size:14px;transition:.2s;}
.theme-btn:hover{background:rgba(255,255,255,.2);}

@media(max-width:600px){
  body{padding:14px 10px 32px;}
  .hero{padding:18px 16px;border-radius:14px;}
  .hero-left h1{font-size:1.1rem;}
  .stats-grid{grid-template-columns:repeat(2,1fr);}
  .card-hdr,.card-body{padding:15px 16px;}
  .subj-grid{grid-template-columns:1fr;}
}
</style>
</head>
<body>
<%
  var pct = totalCount > 0 ? +((presentCount / totalCount) * 100).toFixed(1) : 0;
  var barColor = pct >= 75 ? 'var(--suc)' : (pct >= 60 ? 'var(--war)' : 'var(--dan)');
%>
<div class="page">

<!-- Hero Header -->
<div class="hero">
  <div class="hero-left">
    <h1><i class="fas fa-graduation-cap" style="margin-right:8px;opacity:.8;"></i><%= user.name %></h1>
    <p><i class="fas fa-id-card" style="opacity:.5;"></i> Roll No: <strong style="color:#fff;"><%= user.rollNo %></strong> &nbsp;·&nbsp; <i class="fas fa-layer-group" style="opacity:.5;"></i> <%= user.section %></p>
  </div>
  <div class="hero-right">
    <% var _myRoles = (user.roles && user.roles.length > 1) ? user.roles : null; %>
    <% if (_myRoles) { %>
    <form action="/switch-role" method="POST" style="display:inline-flex;align-items:center;gap:6px;">
      <select name="targetRole" style="background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.2);border-radius:8px;padding:6px 10px;font-size:12px;font-family:inherit;outline:none;cursor:pointer;">
        <% _myRoles.forEach(function(r){ %><option value="<%= r %>" style="background:#0d1b3e;" <%= r===user.role?'selected':'' %>><%= r %></option><% }); %>
      </select>
      <button type="submit" class="hero-btn">Switch</button>
    </form>
    <% } %>
    <span class="chip"><i class="fas fa-user-graduate"></i> Student</span>
    <button class="theme-btn" id="themeToggle" aria-label="Toggle theme"><i class="fas fa-moon" id="themeIco"></i></button>
    <a href="/settings" class="hero-btn"><i class="fas fa-cog"></i> Settings</a>
    <a href="/logout" class="hero-btn danger"><i class="fas fa-power-off"></i> Logout</a>
  </div>
</div>

<!-- Attendance Warning Banner -->
<% if (pct > 0 && pct < 75) { %>
<div class="banner ban-warn">
  <i class="fas fa-triangle-exclamation" style="font-size:1.1rem;flex-shrink:0;margin-top:1px;"></i>
  <div>
    <strong>Attendance Alert!</strong> Your overall attendance is <strong><%= pct %>%</strong>.
    <% if (pct < 60) { %> You are at critical risk. Attend all remaining classes immediately.
    <% } else { %> Improve attendance to reach the required 75% threshold.
    <% } %>
  </div>
</div>
<% } else if (pct >= 75) { %>
<div class="banner ban-good">
  <i class="fas fa-circle-check" style="font-size:1.1rem;flex-shrink:0;margin-top:1px;"></i>
  <strong>Great work!</strong> Your attendance is <strong><%= pct %>%</strong> — above the required 75%.
</div>
<% } %>

<!-- Stats Grid -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon" style="background:rgba(79,126,247,.1);color:var(--acc);"><i class="fas fa-chart-pie"></i></div>
    <div>
      <div class="stat-lbl">Overall</div>
      <div class="stat-val" style="color:<%= barColor %>;"><%= pct %>%</div>
      <div class="pbar"><div class="pfill" style="width:<%= pct %>%;background:<%= barColor %>;"></div></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:rgba(16,185,129,.1);color:var(--suc);"><i class="fas fa-circle-check"></i></div>
    <div>
      <div class="stat-lbl">Present</div>
      <div class="stat-val" style="color:var(--suc);"><%= presentCount %></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:rgba(239,68,68,.1);color:var(--dan);"><i class="fas fa-circle-xmark"></i></div>
    <div>
      <div class="stat-lbl">Absent</div>
      <div class="stat-val" style="color:var(--dan);"><%= totalCount - presentCount %></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:rgba(245,158,11,.1);color:var(--war);"><i class="fas fa-calendar-days"></i></div>
    <div>
      <div class="stat-lbl">Total Classes</div>
      <div class="stat-val"><%= totalCount %></div>
    </div>
  </div>
  <% var subCount = typeof subjectStats !== 'undefined' ? subjectStats.length : 0; %>
  <div class="stat-card">
    <div class="stat-icon" style="background:rgba(139,92,246,.1);color:#8b5cf6;"><i class="fas fa-book-open"></i></div>
    <div>
      <div class="stat-lbl">Subjects</div>
      <div class="stat-val" style="color:#8b5cf6;"><%= subCount %></div>
    </div>
  </div>
</div>

<!-- Subject-wise Attendance -->
<div class="card">
  <div class="card-hdr">
    <h3><i class="fas fa-book-open" style="color:var(--acc);"></i> Subject-wise Attendance</h3>
    <span style="font-size:12px;color:var(--muted);"><%= subCount %> subject(s)</span>
  </div>
  <div class="card-body">
    <% if (typeof subjectStats !== 'undefined' && subjectStats.length > 0) { %>
      <div class="subj-grid">
        <% subjectStats.forEach(function(s) {
          var sc   = s.percentage >= 75 ? 't-ok' : (s.percentage >= 60 ? 't-risk' : 't-low');
          var slbl = s.percentage >= 75 ? '✓ On Track' : (s.percentage >= 60 ? '⚠ At Risk' : '✗ Critical');
          var sp   = s.percentage >= 75 ? 'var(--suc)' : (s.percentage >= 60 ? 'var(--war)' : 'var(--dan)');
        %>
        <div class="sc" style="color:<%= sp %>">
          <div class="sn"><%= s.subject %></div>
          <div class="sc2"><%= s.present %> present · <%= s.absent %> absent · <%= s.total %> total</div>
          <div class="sp"><%= s.percentage %>%</div>
          <div class="pbar"><div class="pfill" style="width:<%= s.percentage %>%;background:<%= sp %>;"></div></div>
          <span class="sc-tag <%= sc %>"><%= slbl %></span>
        </div>
        <% }); %>
      </div>

      <div class="tbl-wrap">
        <table>
          <thead>
            <tr>
              <th>Subject</th>
              <th style="text-align:center;">Present</th>
              <th style="text-align:center;">Absent</th>
              <th style="text-align:center;">Total</th>
              <th>Percentage</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% subjectStats.forEach(function(s) {
              var sc2  = s.percentage >= 75 ? 't-ok' : (s.percentage >= 60 ? 't-risk' : 't-low');
              var slb2 = s.percentage >= 75 ? '✓ On Track' : (s.percentage >= 60 ? '⚠ At Risk' : '✗ Critical');
              var sp2  = s.percentage >= 75 ? 'var(--suc)' : (s.percentage >= 60 ? 'var(--war)' : 'var(--dan)');
            %>
            <tr>
              <td><strong><%= s.subject %></strong></td>
              <td style="text-align:center;color:var(--suc);font-weight:700;"><%= s.present %></td>
              <td style="text-align:center;color:var(--dan);font-weight:700;"><%= s.absent %></td>
              <td style="text-align:center;"><%= s.total %></td>
              <td>
                <div style="display:flex;align-items:center;gap:9px;">
                  <strong style="color:<%= sp2 %>;min-width:44px;"><%= s.percentage %>%</strong>
                  <div style="flex:1;max-width:80px;" class="pbar">
                    <div class="pfill" style="width:<%= s.percentage %>%;background:<%= sp2 %>;"></div>
                  </div>
                </div>
              </td>
              <td><span class="sc-tag <%= sc2 %>"><%= slb2 %></span></td>
            </tr>
            <% }); %>
            <tr class="tfoot-row">
              <td><strong>OVERALL</strong></td>
              <td style="text-align:center;color:var(--suc);font-weight:700;"><%= presentCount %></td>
              <td style="text-align:center;color:var(--dan);font-weight:700;"><%= totalCount - presentCount %></td>
              <td style="text-align:center;font-weight:700;"><%= totalCount %></td>
              <td>
                <div style="display:flex;align-items:center;gap:9px;">
                  <strong style="color:<%= barColor %>;min-width:44px;"><%= pct %>%</strong>
                  <div style="flex:1;max-width:80px;" class="pbar">
                    <div class="pfill" style="width:<%= pct %>%;background:<%= barColor %>;"></div>
                  </div>
                </div>
              </td>
              <td><span class="sc-tag <%= pct>=75?'t-ok':(pct>=60?'t-risk':'t-low') %>"><%= pct>=75?'✓ Good':(pct>=60?'⚠ At Risk':'✗ Low') %></span></td>
            </tr>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div style="text-align:center;padding:50px 20px;color:var(--muted);">
        <i class="fas fa-book-open" style="font-size:2.5rem;opacity:.2;display:block;margin-bottom:12px;"></i>
        <p>No attendance records found yet.</p>
      </div>
    <% } %>
  </div>
</div>

<!-- Recent Activity -->
<div class="card">
  <div class="card-hdr">
    <h3><i class="fas fa-clock-rotate-left" style="color:var(--acc);"></i> Recent Activity</h3>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <a href="/attendance-history" class="btn-sm filled"><i class="fas fa-calendar-alt"></i> Full History</a>
    </div>
  </div>
  <div class="tbl-wrap">
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Subject</th>
          <th>Time Slot</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (records && records.length > 0) { %>
          <% records.forEach(function(rec) {
            var me = rec.students.find(function(s){ return s.studentId === user.rollNo; });
          %>
          <tr>
            <td style="font-weight:700;white-space:nowrap;"><%= rec.date %></td>
            <td><strong><%= rec.subject || '—' %></strong></td>
            <td style="color:var(--muted);font-size:12.5px;white-space:nowrap;"><i class="far fa-clock"></i> <%= rec.manualTime || 'N/A' %></td>
            <td>
              <% if (me) { %>
                <span class="pill <%= me.status === 'Present' ? 'p-present' : 'p-absent' %>">
                  <i class="fas fa-<%= me.status === 'Present' ? 'check' : 'xmark' %>"></i> <%= me.status %>
                </span>
              <% } else { %>
                <span class="pill p-na">Not Marked</span>
              <% } %>
            </td>
          </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="4" style="text-align:center;padding:50px;color:var(--muted);">
              <i class="fas fa-folder-open" style="font-size:2rem;opacity:.25;display:block;margin-bottom:10px;"></i>
              No records found for your roll number.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% if (records && records.length >= 50) { %>
    <div style="text-align:center;padding:12px;font-size:12.5px;color:var(--muted);border-top:1px solid var(--border);">
      Showing recent 50 entries. <a href="/attendance-history" style="color:var(--acc);font-weight:700;">View all →</a>
    </div>
  <% } %>
</div>

</div><!-- /page -->

<script>
(function(){
  function setTheme(t){
    document.documentElement.setAttribute('data-theme',t);
    localStorage.setItem('rku-theme',t);
    var i=document.getElementById('themeIco');
    if(i) i.className = t==='dark'?'fas fa-sun':'fas fa-moon';
  }
  document.addEventListener('DOMContentLoaded',function(){
    var t=document.documentElement.getAttribute('data-theme')||'light';
    var i=document.getElementById('themeIco');
    if(i) i.className = t==='dark'?'fas fa-sun':'fas fa-moon';
    var btn=document.getElementById('themeToggle');
    if(btn) btn.addEventListener('click',function(){
      var cur=document.documentElement.getAttribute('data-theme')||'light';
      setTheme(cur==='dark'?'light':'dark');
    });
  });
})();
</script>
</body>
</html>
