<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lecturer Portal — <%= user.name %></title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<script>(function(){var t=localStorage.getItem('rku-theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
<style>
:root{
  --pri:#0d1b3e;--pri2:#162d5a;
  --acc:#4f7ef7;--acc2:#2563eb;--acc-glow:rgba(79,126,247,.18);
  --suc:#10b981;--dan:#ef4444;--war:#f59e0b;--pur:#8b5cf6;
  --bg:#f0f4fb;--card:#fff;--border:#e4eaf4;
  --text:#0e1526;--muted:#64748b;
  --input-bg:#f6f9ff;--input-bd:#d4daea;
  --shadow:0 2px 16px rgba(14,21,38,.07);
  --shadow-lg:0 8px 36px rgba(14,21,38,.13);
  --radius:16px;--radius-sm:10px;--sidebar-w:260px;
}
[data-theme="dark"]{
  --bg:#080e1d;--card:#0e1828;--border:#172035;
  --text:#cdd9ee;--muted:#5e7898;
  --input-bg:#0a1120;--input-bd:#1b2d4a;
  --shadow:0 2px 20px rgba(0,0,0,.35);
  --shadow-lg:0 8px 40px rgba(0,0,0,.55);
  --pri:#060e20;--pri2:#0d1b36;
  --acc:#6b93fa;--acc2:#4f7ef7;--acc-glow:rgba(107,147,250,.15);
  --suc:#34d399;--dan:#f87171;--war:#fbbf24;--pur:#a78bfa;
}
*{box-sizing:border-box;margin:0;padding:0;}
html,body{transition:background .25s,color .25s;}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);display:flex;min-height:100vh;}

/* ══ SIDEBAR ══ */
.sidebar{
  width:var(--sidebar-w);background:linear-gradient(180deg,var(--pri) 0%,var(--pri2) 100%);
  height:100vh;position:fixed;top:0;left:0;
  display:flex;flex-direction:column;z-index:400;overflow-y:auto;
  transition:transform .28s cubic-bezier(.4,0,.2,1);
  box-shadow:4px 0 30px rgba(0,0,0,.25);
}
.sb-top{padding:22px 16px 0;}
.brand{display:flex;align-items:center;gap:11px;margin-bottom:20px;}
.brand-icon{
  width:42px;height:42px;flex-shrink:0;border-radius:12px;
  background:linear-gradient(135deg,var(--acc),var(--pur));
  display:flex;align-items:center;justify-content:center;font-size:18px;color:#fff;
  box-shadow:0 4px 14px rgba(79,126,247,.4);
}
.brand-name{font-size:.9rem;font-weight:800;color:#fff;letter-spacing:-.2px;}
.brand-sub{font-size:10.5px;color:rgba(255,255,255,.4);margin-top:2px;}

.user-chip{
  background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);
  border-radius:var(--radius-sm);padding:12px 13px;margin-bottom:18px;
}
.user-chip small{font-size:10px;color:rgba(255,255,255,.35);text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:4px;}
.user-chip strong{color:#fff;font-size:13px;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:7px;}
.role-badge{display:inline-flex;align-items:center;gap:5px;background:linear-gradient(135deg,rgba(79,126,247,.3),rgba(139,92,246,.2));border:1px solid rgba(79,126,247,.3);color:#93c5fd;padding:4px 10px;border-radius:20px;font-size:10.5px;font-weight:700;}

.role-sw{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:var(--radius-sm);padding:11px 13px;margin-bottom:16px;}
.role-sw label{font-size:10px;color:rgba(255,255,255,.35);text-transform:uppercase;letter-spacing:.5px;display:flex;align-items:center;gap:5px;margin-bottom:7px;}
.role-sw-row{display:flex;gap:6px;}
.role-sel{flex:1;padding:7px 10px;border-radius:7px;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.08);color:#fff;font-size:12.5px;font-family:inherit;outline:none;cursor:pointer;}
.role-sel option{background:#0d1b3e;color:#fff;}
.role-go{padding:7px 12px;border-radius:7px;background:var(--acc);color:#fff;border:none;font-size:12px;font-weight:700;cursor:pointer;transition:.18s;}
.role-go:hover{background:var(--acc2);}

.sb-nav{padding:0 10px 16px;flex:1;}
.nav-lbl{font-size:10px;text-transform:uppercase;letter-spacing:.6px;color:rgba(255,255,255,.28);padding:12px 8px 5px;}
.nav-link{
  display:flex;align-items:center;gap:10px;padding:10px 11px;
  border-radius:var(--radius-sm);margin-bottom:2px;
  color:rgba(255,255,255,.52);text-decoration:none;font-size:13px;font-weight:600;
  transition:.18s;border:none;background:none;cursor:pointer;width:100%;text-align:left;
}
.nav-link:hover{background:rgba(255,255,255,.08);color:#fff;}
.nav-link.active{background:rgba(79,126,247,.22);color:#fff;border-left:3px solid var(--acc);padding-left:8px;}
.nav-link i{width:18px;text-align:center;flex-shrink:0;font-size:13.5px;}
.nav-link.danger{color:rgba(248,113,113,.65);}
.nav-link.danger:hover{background:rgba(239,68,68,.12);color:var(--dan);}
.nav-link.export{color:rgba(52,211,153,.65);}
.nav-link.export:hover{background:rgba(16,185,129,.12);color:var(--suc);}

.sb-foot{padding:12px 14px;border-top:1px solid rgba(255,255,255,.07);}
.clock-txt{font-size:.78rem;color:rgba(255,255,255,.3);text-align:center;font-variant-numeric:tabular-nums;}

/* ══ OVERLAY + HAMBURGER ══ */
.sb-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:350;}
.sb-overlay.open{display:block;}
.ham{
  display:none;position:fixed;top:14px;left:14px;z-index:500;
  background:var(--pri);border:none;color:#fff;
  padding:10px 13px;border-radius:var(--radius-sm);font-size:18px;cursor:pointer;
  box-shadow:0 3px 14px rgba(0,0,0,.35);
}

/* ══ MOBILE TOPBAR ══ */
.mob-topbar{
  display:none;position:fixed;top:0;left:0;right:0;height:54px;z-index:300;
  background:var(--pri);padding:0 16px 0 60px;
  align-items:center;justify-content:space-between;
  box-shadow:0 2px 12px rgba(0,0,0,.2);
}
.mob-topbar span{color:#fff;font-size:13.5px;font-weight:700;}
.btn-theme{background:rgba(255,255,255,.1);border:none;color:rgba(255,255,255,.7);padding:7px 11px;border-radius:7px;cursor:pointer;font-size:14px;transition:.18s;}
.btn-theme:hover{background:rgba(255,255,255,.18);color:#fff;}

/* ══ MAIN ══ */
.main{margin-left:var(--sidebar-w);flex:1;padding:28px 28px 50px;min-width:0;}

/* ══ PAGE HEADER ══ */
.pg-hdr{
  background:linear-gradient(135deg,var(--pri) 0%,var(--pri2) 60%,#1e4fd8 100%);
  border-radius:var(--radius);padding:22px 26px;margin-bottom:24px;
  display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;
  box-shadow:0 6px 28px rgba(13,27,62,.35);position:relative;overflow:hidden;
}
.pg-hdr::before{content:'';position:absolute;right:-50px;top:-50px;width:180px;height:180px;border-radius:50%;background:rgba(255,255,255,.04);pointer-events:none;}
.pg-hdr h1{font-size:1.3rem;font-weight:900;color:#fff;letter-spacing:-.2px;}
.pg-hdr p{font-size:13px;color:rgba(255,255,255,.65);margin-top:4px;}
.hdr-right{display:flex;align-items:center;gap:10px;}

/* ══ STATS ══ */
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px;}
.stat-card{
  background:var(--card);border:1px solid var(--border);border-radius:var(--radius);
  padding:18px;box-shadow:var(--shadow);transition:.22s;display:flex;align-items:center;gap:14px;
}
.stat-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg);}
.stat-icon{width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;}
.stat-body small{font-size:10.5px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);font-weight:700;display:block;margin-bottom:3px;}
.stat-body h2{font-size:1.85rem;font-weight:900;line-height:1;}

/* ══ CARD ══ */
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden;margin-bottom:20px;}
.card-hdr{padding:16px 22px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;background:var(--input-bg);}
.card-hdr h3{font-size:.95rem;font-weight:800;display:flex;align-items:center;gap:8px;margin:0;}
.card-body{padding:22px;}

/* ══ LIVE TAG ══ */
.live-tag{background:rgba(16,185,129,.1);color:var(--suc);border:1px solid rgba(16,185,129,.2);padding:4px 12px;border-radius:20px;font-size:11.5px;font-weight:700;display:inline-flex;align-items:center;gap:6px;}
.live-dot{width:7px;height:7px;border-radius:50%;background:var(--suc);animation:blink 1.5s infinite;}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:.2;}}

/* ══ DIVISION TABS ══ */
.div-tabs{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:18px;}
.tab-btn{padding:7px 16px;border:1.5px solid var(--border);border-radius:20px;cursor:pointer;font-weight:700;font-size:12.5px;background:var(--card);color:var(--muted);transition:.18s;font-family:inherit;}
.tab-btn:hover,.tab-btn.active{background:var(--acc);color:#fff;border-color:var(--acc);}
.hidden{display:none!important;}

/* ══ GROUP HEADER ══ */
.grp-hdr{
  background:linear-gradient(135deg,var(--input-bg),var(--card));
  border:1px solid var(--border);border-radius:var(--radius-sm);
  padding:12px 18px;margin-bottom:12px;
  display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;
}
.grp-hdr h4{font-size:.9rem;font-weight:800;display:flex;align-items:center;gap:8px;margin:0;}
.grp-hdr-right{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}

/* ══ TABLE ══ */
.tbl-wrap{overflow-x:auto;}
table{width:100%;border-collapse:collapse;min-width:400px;}
thead th{background:var(--input-bg);padding:11px 15px;text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);border-bottom:2px solid var(--border);white-space:nowrap;}
tbody td{padding:12px 15px;border-bottom:1px solid var(--border);font-size:13.5px;vertical-align:middle;}
tbody tr:last-child td{border-bottom:none;}
tbody tr:hover td{background:rgba(79,126,247,.025);}

/* ══ STATUS ══ */
.sp{display:inline-flex;align-items:center;gap:5px;padding:4px 11px;border-radius:7px;font-size:11.5px;font-weight:700;}
.sp.Present{background:rgba(16,185,129,.1);color:#047857;}
.sp.Absent{background:rgba(239,68,68,.08);color:#b91c1c;}
[data-theme="dark"] .sp.Present{background:rgba(52,211,153,.12);color:var(--suc);}
[data-theme="dark"] .sp.Absent{background:rgba(248,113,113,.1);color:var(--dan);}

/* ══ TOGGLE BTN ══ */
.toggle-btn{padding:4px 10px;font-size:11px;font-weight:700;border-radius:6px;border:none;cursor:pointer;transition:.18s;background:rgba(79,126,247,.1);color:var(--acc);}
.toggle-btn:hover{background:var(--acc);color:#fff;}

/* ══ ALERTS ══ */
.alert{display:flex;align-items:center;gap:10px;padding:13px 16px;border-radius:var(--radius-sm);margin-bottom:18px;font-size:13.5px;animation:slideIn .3s ease;}
@keyframes slideIn{from{opacity:0;transform:translateY(-6px);}to{opacity:1;transform:none;}}

/* ══ EMPTY ══ */
.empty{text-align:center;padding:60px 20px;color:var(--muted);}
.empty i{font-size:3rem;opacity:.15;display:block;margin-bottom:14px;}
.empty h3{font-size:1rem;font-weight:700;margin-bottom:8px;color:var(--text);}
.empty p{font-size:13.5px;max-width:360px;margin:0 auto 18px;}

/* ══ BUTTONS ══ */
.btn{display:inline-flex;align-items:center;gap:7px;padding:9px 16px;border:none;border-radius:var(--radius-sm);font-size:13px;font-weight:700;cursor:pointer;transition:.18s;text-decoration:none;white-space:nowrap;}
.btn:hover{opacity:.88;transform:translateY(-1px);}
.btn:active{transform:scale(.98);}
.btn-acc{background:var(--acc);color:#fff;}

/* ══ RESPONSIVE ══ */
@media(max-width:1060px){.stats-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:768px){
  .sidebar{transform:translateX(-100%);}
  .sidebar.open{transform:translateX(0);}
  .main{margin-left:0;padding:68px 14px 40px;}
  .ham{display:flex;}
  .mob-topbar{display:flex;}
  .stats-grid{grid-template-columns:repeat(2,1fr);gap:10px;}
  .stat-card{padding:14px;}
  .stat-icon{width:40px;height:40px;font-size:1rem;}
  .stat-body h2{font-size:1.5rem;}
  .card-body,.card-hdr{padding:14px 16px;}
  .pg-hdr{padding:18px 16px;border-radius:14px;}
  .pg-hdr h1{font-size:1.1rem;}
}
@media(max-width:480px){
  .stats-grid{grid-template-columns:1fr 1fr;}
}
</style>
</head>
<body>

<!-- Hamburger -->
<button class="ham" id="hamBtn" aria-label="Menu"><i class="fas fa-bars"></i></button>

<!-- Mobile Topbar -->
<div class="mob-topbar" id="mobTopbar">
  <span><i class="fas fa-chalkboard-teacher" style="color:var(--acc);margin-right:6px;"></i> Lecturer Portal</span>
  <button id="themeToggleMob" class="btn-theme" aria-label="Toggle theme"><i class="fas fa-moon" id="themeIconMob"></i></button>
</div>

<!-- Sidebar Overlay -->
<div class="sb-overlay" id="sidebarOverlay"></div>

<!-- Sidebar -->
<aside class="sidebar" id="sidebar">
  <div class="sb-top">
    <div class="brand">
      <div class="brand-icon"><i class="fas fa-chalkboard-teacher"></i></div>
      <div>
        <div class="brand-name">LECTURER</div>
        <div class="brand-sub">RKU Attendance</div>
      </div>
    </div>
    <div class="user-chip">
      <small>Faculty Member</small>
      <strong><%= user.name %></strong>
      <span class="role-badge"><i class="fas fa-circle" style="font-size:6px;"></i> <%= user.role %></span>
    </div>

    <% var lecRoles = user.roles && user.roles.length > 1 ? user.roles : null; %>
    <% if (lecRoles) { %>
    <div class="role-sw">
      <label><i class="fas fa-shuffle"></i> Switch Role</label>
      <form action="/switch-role" method="POST" class="role-sw-row">
        <select name="targetRole" class="role-sel">
          <% lecRoles.forEach(function(r){ %>
            <option value="<%= r %>" <%= r===user.role?'selected':'' %>><%= r %></option>
          <% }); %>
        </select>
        <button type="submit" class="role-go">Go</button>
      </form>
    </div>
    <% } %>
  </div>

  <nav class="sb-nav">
    <div class="nav-lbl">Navigation</div>
    <a href="/lecturer" class="nav-link active"><i class="fas fa-house"></i> Dashboard</a>
    <a href="/attendance-history" class="nav-link"><i class="fas fa-clock-rotate-left"></i> History</a>
    <a href="/settings" class="nav-link"><i class="fas fa-gear"></i> Settings</a>
    <a href="/export-attendance" class="nav-link export"><i class="fas fa-file-csv"></i> Export CSV</a>
    <div class="nav-lbl" style="margin-top:8px;">Account</div>
    <a href="/logout" class="nav-link danger"><i class="fas fa-power-off"></i> Logout</a>
  </nav>

  <div class="sb-foot">
    <div class="clock-txt" id="sbClock">--:--:--</div>
  </div>
</aside>

<!-- Main Content -->
<main class="main">

  <!-- Page Header -->
  <div class="pg-hdr">
    <div>
      <h1><i class="fas fa-chalkboard-teacher" style="margin-right:8px;opacity:.8;"></i> Lecturer Dashboard</h1>
      <p>Welcome back, <strong style="color:#fff;"><%= user.name %></strong> — Today's attendance records are shown below.</p>
    </div>
    <div class="hdr-right">
      <span id="desktopClock" style="font-size:13px;color:rgba(255,255,255,.6);font-variant-numeric:tabular-nums;"></span>
      <button id="themeToggle" class="btn-theme" aria-label="Toggle theme"><i class="fas fa-moon" id="themeIcon"></i></button>
    </div>
  </div>

  <!-- Stats -->
  <%
    var totalStudents = 0;
    var totalPresent = 0;
    var totalAbsent = 0;
    if (todayRecords && todayRecords.length > 0) {
      todayRecords.forEach(function(rec){
        rec.students.forEach(function(s){
          totalStudents++;
          if (s.status === 'Present') totalPresent++; else totalAbsent++;
        });
      });
    }
  %>
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(79,126,247,.1);color:var(--acc);"><i class="fas fa-clipboard-list"></i></div>
      <div class="stat-body"><small>Today's Classes</small><h2><%= todayRecords ? todayRecords.length : 0 %></h2></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(16,185,129,.1);color:var(--suc);"><i class="fas fa-circle-check"></i></div>
      <div class="stat-body"><small>Present Today</small><h2 style="color:var(--suc);"><%= totalPresent %></h2></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(239,68,68,.1);color:var(--dan);"><i class="fas fa-circle-xmark"></i></div>
      <div class="stat-body"><small>Absent Today</small><h2 style="color:var(--dan);"><%= totalAbsent %></h2></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(139,92,246,.1);color:var(--pur);"><i class="fas fa-layer-group"></i></div>
      <div class="stat-body"><small>Sections Today</small><h2 style="color:var(--pur);"><%= sectionsToday ? sectionsToday.length : 0 %></h2></div>
    </div>
  </div>

  <!-- Today's Attendance -->
  <div class="card">
    <div class="card-hdr">
      <h3>
        <i class="fas fa-calendar-day" style="color:var(--acc);"></i>
        Today's Attendance
        <% if (todayRecords && todayRecords.length > 0) { %>
          <span class="live-tag"><span class="live-dot"></span> Live</span>
        <% } %>
      </h3>
      <div style="display:flex;gap:8px;align-items:center;">
        <span style="font-size:12px;color:var(--muted);"><%= new Date().toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long'}) %></span>
      </div>
    </div>
    <div class="card-body">

      <% if (todayRecords && todayRecords.length > 0) { %>

        <!-- Division tabs -->
        <% if (sectionsToday && sectionsToday.length > 1) { %>
        <div class="div-tabs" id="divTabs">
          <button class="tab-btn active" data-div="all">All Sections (<%= sectionsToday.length %>)</button>
          <% sectionsToday.forEach(function(sec){ %>
            <button class="tab-btn" data-div="<%= sec %>"><i class="fas fa-layer-group" style="font-size:11px;"></i> <%= sec %></button>
          <% }); %>
        </div>
        <% } %>

        <%
          var groupedByDiv = {};
          todayRecords.forEach(function(rec){
            var sec = rec.section || 'Unknown';
            if (!groupedByDiv[sec]) groupedByDiv[sec] = [];
            groupedByDiv[sec].push(rec);
          });
        %>

        <% Object.keys(groupedByDiv).forEach(function(div){ %>
        <div class="div-group" data-division="<%= div %>">
          <div class="grp-hdr">
            <h4><i class="fas fa-layer-group" style="color:var(--acc);"></i> Section: <%= div %></h4>
            <div class="grp-hdr-right">
              <a href="/generate-day-pdf/<%= new Date().toISOString().split('T')[0] %>?section=<%= div %>" class="btn btn-acc" style="padding:6px 13px;font-size:12px;">
                <i class="fas fa-file-pdf"></i> Download PDF
              </a>
            </div>
          </div>

          <% groupedByDiv[div].forEach(function(record){ %>
          <div class="card" style="margin-bottom:14px;">
            <div class="card-hdr" style="background:transparent;">
              <h3 style="font-size:.88rem;">
                <i class="fas fa-book" style="color:var(--pur);"></i>
                <%= record.subject || 'Unknown Subject' %>
                &nbsp;<span style="color:var(--muted);font-weight:400;font-size:.85em;">· <%= record.manualTime || 'N/A' %></span>
              </h3>
              <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                <% var pCount = record.students.filter(function(s){return s.status==='Present';}).length; %>
                <span style="font-size:12px;color:var(--suc);font-weight:700;"><i class="fas fa-check"></i> <%= pCount %> Present</span>
                <span style="font-size:12px;color:var(--dan);font-weight:700;"><i class="fas fa-times"></i> <%= record.students.length - pCount %> Absent</span>
                <% if (record.isLockedByLeader) { %>
                  <span style="font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;background:rgba(79,126,247,.1);color:var(--acc);">
                    <i class="fas fa-lock"></i> Locked
                  </span>
                <% } %>
              </div>
            </div>
            <div class="tbl-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Roll No</th>
                    <th>Student Name</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (record.students && record.students.length > 0) { %>
                    <% record.students.forEach(function(student) { %>
                    <tr id="row-<%= record._id %>-<%= student.studentId %>">
                      <td style="font-family:monospace;font-weight:700;color:var(--acc);"><%= student.studentId || 'N/A' %></td>
                      <td><%= student.studentName || student.name || 'Unknown' %></td>
                      <td>
                        <div style="display:flex;align-items:center;gap:8px;">
                          <span class="sp <%= student.status %>" id="badge-<%= record._id %>-<%= student.studentId %>">
                            <i class="fas fa-<%= student.status==='Present'?'check':'xmark' %>"></i> <%= student.status %>
                          </span>
                          <button type="button"
                            class="toggle-btn toggle-status-btn"
                            data-attendance-id="<%= record._id %>"
                            data-student-id="<%= student.studentId %>"
                            data-current="<%= student.status %>"
                            title="Toggle status">
                            <i class="fas fa-shuffle"></i> Toggle
                          </button>
                        </div>
                      </td>
                    </tr>
                    <% }); %>
                  <% } else { %>
                    <tr><td colspan="3" style="text-align:center;color:var(--muted);padding:24px;">No students listed.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
          <% }); %>
        </div>
        <% }); %>

      <% } else { %>
      <div class="empty">
        <i class="fas fa-clipboard-list"></i>
        <h3>No Attendance Today</h3>
        <p>No records have been submitted for your classes today. They will appear here once section leaders submit attendance.</p>
        <a href="/attendance-history" class="btn btn-acc"><i class="fas fa-clock-rotate-left"></i> View Previous Records</a>
      </div>
      <% } %>

    </div>
  </div>

</main>

<script>
(function(){
  function setTheme(t){
    document.documentElement.setAttribute('data-theme',t);
    localStorage.setItem('rku-theme',t);
    document.querySelectorAll('[id^="themeIcon"]').forEach(function(i){
      i.className = t==='dark'?'fas fa-sun':'fas fa-moon';
    });
  }
  var _t = document.documentElement.getAttribute('data-theme')||'light';
  setTheme(_t);

  document.addEventListener('DOMContentLoaded',function(){
    // Theme
    ['themeToggle','themeToggleMob'].forEach(function(id){
      var btn=document.getElementById(id);
      if(btn) btn.addEventListener('click',function(){
        var c=document.documentElement.getAttribute('data-theme')||'light';
        setTheme(c==='dark'?'light':'dark');
      });
    });

    // Clock
    function tick(){
      var t=new Date().toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
      ['desktopClock','sbClock'].forEach(function(id){
        var el=document.getElementById(id); if(el) el.textContent=t;
      });
    }
    tick(); setInterval(tick,1000);

    // Sidebar
    var ham=document.getElementById('hamBtn');
    var sb=document.getElementById('sidebar');
    var ov=document.getElementById('sidebarOverlay');
    function openSb(){ sb.classList.add('open'); ov.classList.add('open'); }
    function closeSb(){ sb.classList.remove('open'); ov.classList.remove('open'); }
    if(ham) ham.addEventListener('click',openSb);
    if(ov) ov.addEventListener('click',closeSb);

    // Division tabs
    var tabs=document.getElementById('divTabs');
    if(tabs){
      tabs.addEventListener('click',function(e){
        var btn=e.target.closest('.tab-btn'); if(!btn) return;
        tabs.querySelectorAll('.tab-btn').forEach(function(b){b.classList.remove('active');});
        btn.classList.add('active');
        var dv=btn.dataset.div;
        document.querySelectorAll('.div-group').forEach(function(g){
          g.classList.toggle('hidden', dv!=='all' && g.dataset.division!==dv);
        });
      });
    }

    // Toggle attendance (AJAX)
    document.body.addEventListener('click',function(e){
      var btn=e.target.closest('.toggle-status-btn'); if(!btn) return;
      var aid=btn.dataset.attendanceId;
      var sid=btn.dataset.studentId;
      var cur=btn.dataset.current;
      var ns=cur==='Present'?'Absent':'Present';
      btn.disabled=true;
      btn.innerHTML='<i class="fas fa-spinner fa-spin"></i>';
      fetch('/update-attendance-status',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({attendanceId:aid,studentId:sid,newStatus:ns})
      })
      .then(function(r){return r.json();})
      .then(function(data){
        if(data.success){
          btn.dataset.current=ns;
          var badge=document.getElementById('badge-'+aid+'-'+sid);
          if(badge){
            badge.className='sp '+ns;
            badge.innerHTML=(ns==='Present'?'<i class="fas fa-check"></i> ':'<i class="fas fa-xmark"></i> ')+ns;
          }
          btn.innerHTML='<i class="fas fa-shuffle"></i> Toggle';
          btn.disabled=false;
        } else {
          alert('Failed: '+(data.message||'Unknown error'));
          btn.innerHTML='<i class="fas fa-shuffle"></i> Toggle';
          btn.disabled=false;
        }
      })
      .catch(function(){
        alert('Network error — try again.');
        btn.innerHTML='<i class="fas fa-shuffle"></i> Toggle';
        btn.disabled=false;
      });
    });
  });
})();
</script>
</body>
</html>
