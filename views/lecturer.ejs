<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lecturer Dashboard - Attendance Management</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        :root { --primary: #2c3e50; --accent: #3498db; --success: #27ae60; --danger: #e74c3c; }
        body { font-family: 'Segoe UI', sans-serif; background: #f4f7f6; padding: 20px; }
        .container { max-width: 1100px; margin: 0 auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .header { display: flex; justify-content: space-between; border-bottom: 2px solid #eee; padding-bottom: 10px; margin-bottom: 20px; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { padding: 12px; border: 1px solid #eee; text-align: left; }
        th { background: var(--primary); color: white; }

        /* Status Button Styles */
        .status-badge { 
            padding: 6px 15px; 
            border-radius: 20px; 
            border: none; 
            cursor: pointer; 
            font-weight: bold; 
            color: white;
            transition: transform 0.1s;
        }
        .status-badge:active { transform: scale(0.95); }
        .Present { background-color: var(--success); }
        .Absent { background-color: var(--danger); }

        .btn-view { background: var(--accent); color: white; padding: 5px 10px; border-radius: 4px; text-decoration: none; cursor: pointer; border: none; }
        
        /* Hidden Student List Area */
        .student-section { display: none; background: #f9f9f9; padding: 20px; border: 1px solid #ddd; border-top: none; }
        .record-row:hover { background: #f1f1f1; }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1>Lecturer Dashboard</h1>
        <div>Welcome, <strong><%= user.name %></strong> | <a href="/logout">Logout</a></div>
    </div>

    <h3>Assigned Attendance Records</h3>
    <p style="font-size: 14px; color: #666;">Click "View" to see student lists and toggle attendance status for corrections.</p>

    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Time Slot</th>
                <th>Subject</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <% if (records && records.length > 0) { %>
                <% records.forEach(rec => { %>
                    <tr class="record-row">
                        <td><%= rec.date %></td>
                        <td><%= rec.manualTime || 'N/A' %></td> <td><%= rec.subject %></td>
                        <td>
                            <button class="btn-view" onclick="toggleStudentList('<%= rec._id %>')">View Students</button>
                        </td>
                    </tr>
                    <tr id="row-<%= rec._id %>" class="student-section">
                        <td colspan="4">
                            <h4>Student List for <%= rec.subject %></h4>
                            <table>
                                <thead>
                                    <tr>
                                        <th>Roll No</th>
                                        <th>Student Name</th>
                                        <th>Status (Click to Change)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% rec.students.forEach(s => { %>
                                        <tr>
                                            <td><%= s.studentId %></td>
                                            <td><%= s.studentName %></td>
                                            <td>
                                                <button 
                                                    type="button" 
                                                    class="status-badge <%= s.status %>"
                                                    onclick="updateStatus('<%= rec._id %>', '<%= s.studentId %>', '<%= s.status %>')">
                                                    <%= s.status %>
                                                </button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="4" style="text-align: center;">No attendance records assigned to you yet.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>



<script>
    // Show/Hide the student list for a specific record
    function toggleStudentList(id) {
        const section = document.getElementById('row-' + id);
        section.style.display = (section.style.display === 'table-row') ? 'none' : 'table-row';
    }

    // AJAX function to update status without full page refresh
    async function updateStatus(attendanceId, studentId, currentStatus) {
        const newStatus = (currentStatus === 'Present') ? 'Absent' : 'Present';
        
        try {
            const response = await fetch('/update-attendance-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    attendanceId: attendanceId, 
                    studentId: studentId, 
                    newStatus: newStatus 
                })
            });

            const result = await response.json();

            if (result.success) {
                // Refresh only on success to show updated colors
                window.location.reload(); 
            } else {
                alert("Failed to update status. Record might be locked or mismatched.");
            }
        } catch (err) {
            console.error("Update Error:", err);
            alert("Network error. Could not connect to server.");
        }
    }
</script>

</body>
</html>