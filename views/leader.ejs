<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leader Dashboard — Attendance</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --primary: #2c3e50; --accent: #3498db; --success: #27ae60; --whatsapp: #25D366; --danger: #e74c3c; --bg: #f4f7f6; }
        body { font-family: 'Segoe UI', sans-serif; background: var(--bg); margin: 0; padding: 20px; color: #333; }
        .container { max-width: 1100px; margin: 0 auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; border-bottom: 2px solid #eee; padding-bottom: 15px; flex-wrap: wrap; gap: 10px; }
        .section-badge { background: var(--accent); color: white; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: bold; text-transform: uppercase; }
        .card { background: #fff; padding: 20px; border: 1px solid #ddd; border-radius: 10px; margin-bottom: 20px; }
        .grid-inputs { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 15px; }
        label { display: block; font-weight: 600; margin-bottom: 5px; font-size: 0.9rem; color: #666; }
        input, select { width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 8px; box-sizing: border-box; font-size: 14px; }
        input:focus, select:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px rgba(52,152,219,0.1); }
        .quick-mark-area { background: #ebf5ff; border: 1px solid #d0e8ff; padding: 20px; margin-bottom: 25px; border-radius: 10px; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; background: white; }
        th { background: var(--primary); color: white; padding: 12px; text-align: left; font-size: 14px; }
        td { padding: 12px; border-bottom: 1px solid #eee; font-size: 14px; }
        tr:hover { background: #fcfcfc; }
        .btn { padding: 12px 20px; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; color: white; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: 0.2s; font-size: 14px; }
        .btn-primary { background: var(--primary); }
        .btn-accent { background: var(--accent); }
        .btn-success { background: var(--success); }
        .btn-danger { background: var(--danger); }
        .btn-whatsapp { background: var(--whatsapp); width: 100%; justify-content: center; font-size: 16px; margin-top: 10px; }
        .btn:hover { opacity: 0.9; transform: translateY(-1px); }
        .checkbox-wrapper { display: flex; align-items: center; gap: 8px; cursor: pointer; user-select: none; }
        input[type="checkbox"] { width: 18px; height: 18px; cursor: pointer; }
        .alert { padding: 12px 16px; border-radius: 8px; margin-bottom: 15px; font-size: 14px; }
        .alert-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .alert-danger { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
        /* Responsive */
        @media (max-width: 768px) {
            body { padding: 10px; }
            .container { padding: 16px; }
            .header { flex-direction: column; align-items: flex-start; }
            .grid-inputs { grid-template-columns: 1fr; }
            table { font-size: 13px; }
            th, td { padding: 9px 8px; }
            .btn { padding: 10px 14px; font-size: 13px; }
            .quick-mark-area { padding: 14px; }
        }
        @media (max-width: 480px) {
            .header h1 { font-size: 1.2rem; }
            table { display: block; overflow-x: auto; white-space: nowrap; }
            .btn-whatsapp { font-size: 14px; }
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <div>
            <h1 style="margin:0;">Attendance Entry</h1>
            <p style="margin:5px 0 0 0;">Leader: <strong><%= user.name %></strong> | <span class="section-badge"><%= user.section %></span></p>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <a href="/attendance-history" class="btn btn-primary"><i class="fas fa-history"></i> History</a>
            <a href="/settings" class="btn" style="background:#f8f9fa; color: var(--primary); border:1px solid #ddd;"><i class="fas fa-cog"></i> Settings</a>
            <a href="/logout" class="btn" style="background:#fff; color: var(--danger); border: 1px solid var(--danger);"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </div>

    <%# Flash messages from redirects %>
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle me-1"></i> <%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><i class="fas fa-exclamation-circle me-1"></i> <%= error %></div>
    <% } %>

    <div class="quick-mark-area">
        <h4 style="margin: 0 0 10px 0;"><i class="fas fa-bolt" style="color: #f1c40f;"></i> Quick Mark Present</h4>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <input type="text" id="quickInput" placeholder="Enter roll no(s) e.g. 101 or 101,105,122" style="flex:1; min-width: 200px;" onkeydown="if(event.key==='Enter'){event.preventDefault();applyQuickMark();}">
            <button type="button" onclick="applyQuickMark()" class="btn btn-accent" style="white-space: nowrap; flex-shrink:0;"><i class="fas fa-check"></i> Mark Attendance</button>
        </div>
        <p style="font-size: 12px; color: #5a91c5; margin: 8px 0 0 0;">
            <i class="fas fa-info-circle"></i> Enter a single roll number or comma/space-separated list. Press Enter or click the button.
        </p>
        <div id="quickResult" style="display:none; margin-top:8px; padding:8px 12px; border-radius:6px; font-size:13px; font-weight:600;"></div>
    </div>

    <form action="/lock-attendance" method="POST" id="attendanceForm">
        <input type="hidden" name="section" value="<%= user.section %>">

        <div class="card">
            <div class="grid-inputs">
                <div>
                    <label>Assigned Lecturer</label>
                    <select name="lecturerEmail" required>
                        <option value="">-- Select Lecturer --</option>
                        <%
                            // FIX: lecturers is now passed as a separate variable from the route.
                            // Previously was incorrectly filtering allUsers (which only has students/leaders).
                            const lecturerList = typeof lecturers !== 'undefined' ? lecturers : [];
                            lecturerList.forEach(l => {
                        %>
                            <option value="<%= l.email %>"><%= l.name %> (<%= l.email %>)</option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label>Period / Time Slot</label>
                    <input type="text" name="manualTime" placeholder="e.g. 09:00 AM – 10:00 AM" required>
                </div>
                <div>
                    <label>Class Date</label>
                    <input type="date" name="date" id="currentDate" value="<%= new Date().toISOString().split('T')[0] %>" required>
                </div>
            </div>

            <div style="margin-top: 15px;">
                <label>Subject</label>
                <select name="subject" required>
                    <option value="">-- Select Subject --</option>
                    <% if (masterSubjects && masterSubjects.length > 0) { %>
                        <% masterSubjects.forEach(sub => { %>
                            <option value="<%= sub.name %>"><%= sub.name %><% if(sub.code) { %> (<%= sub.code %>)<% } %></option>
                        <% }) %>
                    <% } else { %>
                        <option disabled>No subjects configured — ask your Master to add subjects.</option>
                    <% } %>
                </select>
            </div>

            <h3 style="margin: 30px 0 15px 0; border-left: 4px solid var(--primary); padding-left: 10px;">
                Students in Section <%= user.section %>
                <span style="font-size: 13px; font-weight: normal; color: #7f8c8d; margin-left: 10px;" id="presentCount">0 marked present</span>
            </h3>

            <% if (allUsers && allUsers.length > 0) { %>
            <table id="studentTable">
                <thead>
                    <tr>
                        <th width="120">Roll No</th>
                        <th>Student Name</th>
                        <th width="200">Attendance Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% let studentIndex = 0; %>
                    <% allUsers.forEach(u => { %>
                        <% if (u.role !== 'Master' && u.role !== 'Lecturer' && u.role !== 'SuperAdmin') { %>
                        <tr>
                            <td class="roll-col" style="font-family: monospace; font-weight: bold;"><%= u.rollNo || u.rollno || '—' %></td>
                            <td>
                                <%= u.name %>
                                <% if(u.role === 'Leader') { %><span style="color: var(--accent); font-size: 11px;"> (Leader)</span><% } %>
                            </td>
                            <td>
                                <input type="hidden" name="students[<%=studentIndex%>][id]" value="<%= u.rollNo || u.rollno %>">
                                <input type="hidden" name="students[<%=studentIndex%>][name]" value="<%= u.name %>">
                                <label class="checkbox-wrapper">
                                    <input type="checkbox"
                                           name="students[<%=studentIndex%>][status]"
                                           value="Present"
                                           class="student-checkbox"
                                           onchange="updateCount()">
                                    <span>Present</span>
                                </label>
                            </td>
                        </tr>
                        <% studentIndex++; %>
                        <% } %>
                    <% }) %>
                </tbody>
            </table>
            <% } else { %>
                <p style="text-align:center; color:#aaa; padding:30px;">No students found in this section. Ask your Master to add students.</p>
            <% } %>

            <div style="display: flex; gap: 15px; margin-top: 25px;">
                <button type="button" onclick="markAll(true)" class="btn btn-success" style="flex:1;">
                    <i class="fas fa-check-double"></i> Mark All Present
                </button>
                <button type="button" onclick="markAll(false)" class="btn" style="flex:1; background: #ecf0f1; color: #333;">
                    <i class="fas fa-times"></i> Clear All
                </button>
            </div>

            <button type="submit" class="btn btn-danger" style="width:100%; margin-top:15px; height: 50px; font-size: 16px;">
                <i class="fas fa-lock"></i> Finalize &amp; Lock Attendance
            </button>
        </div>
    </form>

    <div class="card">
        <h3><i class="fas fa-file-pdf"></i> Report Management</h3>
        <div class="grid-inputs" style="align-items: flex-end;">
            <div>
                <label>Filter Records By:</label>
                <select id="reportFilter">
                    <option value="">Full Class List (All)</option>
                    <option value="Present">Present Students Only</option>
                    <option value="Absent">Absent Students Only</option>
                </select>
            </div>
            <button type="button" class="btn btn-accent" onclick="downloadPDF()">
                <i class="fas fa-download"></i> Download PDF
            </button>
        </div>
        <button type="button" class="btn btn-whatsapp" onclick="submitToWhatsApp()">
            <i class="fab fa-whatsapp"></i> Send Report to WhatsApp Group
        </button>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    updateCount();

    // FIX: Form submit — appends hidden "Absent" inputs for every unchecked student.
    // Previously used arrow function inside forEach with wrong 'this' context.
    document.getElementById('attendanceForm').addEventListener('submit', function(e) {
        if (!confirm('Lock attendance? This action cannot be undone.')) {
            e.preventDefault();
            return;
        }
        const form = this;
        document.querySelectorAll('.student-checkbox').forEach(function(cb) {
            if (!cb.checked) {
                const hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = cb.name;
                hidden.value = 'Absent';
                form.appendChild(hidden); // FIX: uses captured 'form' ref, not 'this' inside forEach
            }
        });
    });
});

// Live count of present students
function updateCount() {
    const total = document.querySelectorAll('.student-checkbox').length;
    const present = document.querySelectorAll('.student-checkbox:checked').length;
    const el = document.getElementById('presentCount');
    if (el) el.textContent = `${present} / ${total} marked present`;
}

function markAll(value) {
    document.querySelectorAll('.student-checkbox').forEach(function(cb) {
        cb.checked = value;
        cb.closest('tr').style.background = value ? '#e8f5e9' : '';
    });
    updateCount();
}

// FIX: Normalize roll numbers to handle leading zeros.
// Previously "2" wouldn't match "02".
function normalizeRoll(r) {
    return String(r).trim().replace(/^0+/, '') || '0';
}

function applyQuickMark() {
    const inputEl = document.getElementById('quickInput');
    const input = inputEl.value.trim();
    if (!input) { showQuickResult('error', 'Please enter at least one roll number.'); return; }
    const rollsToMark = input.split(/[\s,\n;]+/).map(normalizeRoll).filter(Boolean);
    const rows = document.querySelectorAll('#studentTable tbody tr');
    let count = 0;
    const notFound = [];
    rows.forEach(function(row) {
        const cellEl = row.querySelector('.roll-col');
        if (!cellEl) return;
        const rawText = cellEl.innerText || cellEl.textContent;
        if (rawText.trim() === '—' || rawText.trim() === '') return; // skip empty roll
        const cellRoll = normalizeRoll(rawText);
        const checkbox = row.querySelector('.student-checkbox');
        if (!checkbox) return;
        if (rollsToMark.includes(cellRoll)) {
            checkbox.checked = true;
            row.style.background = '#e8f5e9';
            count++;
        }
    });
    // Find not-found rolls
    const foundRolls = [];
    document.querySelectorAll('#studentTable .roll-col').forEach(function(cell) {
        const rawText = cell.innerText || cell.textContent;
        if (rawText.trim() !== '—' && rawText.trim() !== '') foundRolls.push(normalizeRoll(rawText));
    });
    rollsToMark.forEach(function(r) { if (!foundRolls.includes(r)) notFound.push(r); });
    updateCount();
    if (count > 0) {
        inputEl.value = '';
        let msg = '✅ ' + count + ' student(s) marked as Present.';
        if (notFound.length > 0) msg += ' ⚠️ Not found: ' + notFound.join(', ');
        showQuickResult('success', msg);
    } else {
        showQuickResult('error', '❌ No matching roll numbers found in this section. Entered: ' + rollsToMark.join(', '));
    }
}

function showQuickResult(type, msg) {
    const el = document.getElementById('quickResult');
    if (!el) return;
    el.style.display = 'block';
    el.style.background = type === 'success' ? '#d4edda' : '#f8d7da';
    el.style.color = type === 'success' ? '#155724' : '#721c24';
    el.textContent = msg;
    setTimeout(function() { el.style.display = 'none'; }, 5000);
}

function downloadPDF() {
    const date = document.getElementById('currentDate').value;
    const filter = document.getElementById('reportFilter').value;
    if (!date) { alert('Please select a date first.'); return; }
    window.open(`/generate-day-pdf/${date}?filter=${encodeURIComponent(filter)}`, '_blank');
}

function submitToWhatsApp() {
    const date = document.getElementById('currentDate').value;
    const filter = document.getElementById('reportFilter').value;
    if (!date) { alert('Please select a date first.'); return; }
    const pdfUrl = `${window.location.origin}/generate-day-pdf/${date}?filter=${encodeURIComponent(filter)}`;
    const message = `*Attendance Report — ${date}*\nSection: <%= user.section %>\nType: ${filter || 'Complete List'}\n\n🔗 PDF Report:\n${pdfUrl}`;
    window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(message)}`, '_blank');
}
</script>
</body>
</html>
