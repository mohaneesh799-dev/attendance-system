<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account | RKU Attendance Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --rku-blue: #003366; --accent: #3498db; --danger: #e74c3c; }
        html.dark {
            --bs-body-bg: #1a1e2a; --bs-body-color: #d4daf0;
        }
        * { box-sizing: border-box; }
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh; display: flex; align-items: center;
            justify-content: center; font-family: 'Inter', 'Segoe UI', sans-serif;
            padding: 20px; transition: background 0.3s;
        }
        html.dark body { background: linear-gradient(135deg, #1a1e2a 0%, #242938 100%); }

        .register-card {
            background: white; padding: 38px 36px; border-radius: 20px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.13); width: 100%; max-width: 480px;
            border-top: 5px solid var(--rku-blue); transition: background 0.3s;
        }
        html.dark .register-card { background: #242938; color: #d4daf0; }

        .portal-icon { font-size: 2.8rem; color: var(--rku-blue); margin-bottom: 10px; }
        html.dark .portal-icon { color: #5b9fe0; }

        .register-title { font-size: 1.35rem; font-weight: 800; margin-bottom: 4px; color: var(--rku-blue); }
        html.dark .register-title { color: #7ea8d8; }

        .form-label { font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.3px; color: #555; margin-bottom: 6px; }
        html.dark .form-label { color: #9ab0cc; }

        .form-control, .form-select {
            padding: 11px 14px; border: 1.5px solid #ddd; border-radius: 9px;
            font-size: 14px; transition: border 0.2s, box-shadow 0.2s;
            background-color: #fff; color: #333;
        }
        html.dark .form-control, html.dark .form-select {
            background-color: #1e2230; border-color: #3a4060; color: #d4daf0;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--rku-blue); box-shadow: 0 0 0 3px rgba(0,51,102,0.12);
            outline: none;
        }
        html.dark .form-control:focus, html.dark .form-select:focus {
            border-color: #5b9fe0; box-shadow: 0 0 0 3px rgba(91,159,224,0.2);
        }

        /* Role-dependent fields */
        #rollNoGroup, #sectionGroup { transition: opacity 0.2s; }

        .btn-register {
            background: var(--rku-blue); color: white; border: none;
            padding: 13px; border-radius: 10px; font-weight: 700; font-size: 15px;
            width: 100%; transition: 0.25s; cursor: pointer;
            display: flex; align-items: center; justify-content: center; gap: 9px;
        }
        .btn-register:hover { background: #002244; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,51,102,0.3); }
        html.dark .btn-register { background: #4a7fb5; }
        html.dark .btn-register:hover { background: #3a6a9a; }

        .alert { border-radius: 10px; border: none; font-size: 14px; }
        .back-link { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 18px; color: #6c757d; text-decoration: none; font-size: 13px; font-weight: 500; }
        .back-link:hover { color: var(--rku-blue); }

        .security-note {
            font-size: 12px; background: #fff5f5; color: #c0392b;
            padding: 10px 13px; border-radius: 8px; border: 1px solid #feb2b2;
            display: flex; align-items: flex-start; gap: 8px;
        }
        html.dark .security-note { background: #3a1a1e; color: #e08080; border-color: #7d2e30; }

        .divider-text { display: flex; align-items: center; gap: 10px; color: #adb5bd; font-size: 12px; margin: 14px 0; }
        .divider-text::before, .divider-text::after { content: ''; flex: 1; border-bottom: 1px solid #dee2e6; }

        @media (max-width: 520px) {
            .register-card { padding: 28px 18px; }
        }
    </style>
</head>
<body>

<div class="register-card">
    <div class="text-center mb-3">
        <div class="portal-icon"><i class="fas fa-university"></i></div>
        <div class="register-title">Create Account</div>
        <p class="text-muted" style="font-size:13px;margin:2px 0 0;">RKU Attendance Portal — Request Access</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger small py-2 mb-3">
            <i class="fas fa-exclamation-circle me-1"></i> <%= error %>
        </div>
    <% } %>

    <form action="/register" method="POST" novalidate id="registerForm">
        <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input type="text" name="name" class="form-control" placeholder="Your full name" required autocomplete="name">
        </div>

        <div class="mb-3">
            <label class="form-label">Official Email</label>
            <input type="email" name="email" class="form-control" placeholder="you@rku.ac.in" required autocomplete="email">
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control" placeholder="Min. 8 characters" required minlength="8" autocomplete="new-password">
        </div>

        <div class="mb-3">
            <label class="form-label">Role</label>
            <select name="role" class="form-select" id="roleSelect" required onchange="handleRoleChange()">
                <option value="" disabled selected>— Select your role —</option>
                <option value="Student">Student</option>
                <option value="Leader">Class Leader</option>
                <option value="Lecturer">Lecturer</option>
            </select>
        </div>

        <div class="mb-3" id="sectionGroup">
            <label class="form-label">Division / Section</label>
            <input type="text" name="section" id="sectionInput" class="form-control" placeholder="e.g. CS-A, IT-B, ME-C">
        </div>

        <div class="mb-4" id="rollNoGroup" style="display:none;">
            <label class="form-label">Roll Number</label>
            <input type="text" name="rollNo" id="rollNoInput" class="form-control" placeholder="e.g. 22CS001">
        </div>

        <button type="submit" class="btn-register">
            <i class="fas fa-paper-plane"></i> Submit Request
        </button>
    </form>

    <div class="divider-text">INFO</div>
    <div class="security-note">
        <i class="fas fa-info-circle" style="flex-shrink:0;margin-top:1px;"></i>
        <span>Your account will require admin approval before login. Use your official <strong>@rku.ac.in</strong> email only.</span>
    </div>

    <a href="/login" class="back-link"><i class="fas fa-arrow-left"></i> Back to Login</a>
</div>

<script>
    // Apply dark theme from localStorage
    (function(){
        if(localStorage.getItem('rku-theme')==='dark'){
            document.getElementById('htmlRoot').classList.add('dark');
        }
    })();

    function handleRoleChange() {
        const role = document.getElementById('roleSelect').value;
        const rollGroup = document.getElementById('rollNoGroup');
        const rollInput = document.getElementById('rollNoInput');
        const secInput = document.getElementById('sectionInput');

        // Show roll number only for Students and Leaders
        if (role === 'Student' || role === 'Leader') {
            rollGroup.style.display = 'block';
            if (role === 'Student') {
                rollInput.required = true;
                rollInput.placeholder = 'e.g. 22CS001';
            } else {
                rollInput.required = false;
                rollInput.placeholder = 'Optional for Leaders';
            }
        } else {
            rollGroup.style.display = 'none';
            rollInput.required = false;
        }

        // Section is always shown but label changes
        const secLabel = document.querySelector('#sectionGroup .form-label');
        if (role === 'Lecturer') {
            secLabel.textContent = 'Primary Division (optional)';
            secInput.placeholder = 'e.g. CS-A (or leave blank)';
            secInput.required = false;
        } else {
            secLabel.textContent = 'Division / Section';
            secInput.placeholder = 'e.g. CS-A, IT-B, ME-C';
            secInput.required = true;
        }
    }

    // Client-side validation
    document.getElementById('registerForm').addEventListener('submit', function(e) {
        const role = document.getElementById('roleSelect').value;
        if (!role) {
            e.preventDefault();
            alert('Please select your role.');
            return;
        }
        const pwd = this.querySelector('input[name="password"]').value;
        if (pwd.length < 8) {
            e.preventDefault();
            alert('Password must be at least 8 characters.');
        }
    });
</script>
</body>
</html>
