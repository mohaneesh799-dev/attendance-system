<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user.section %> - Master Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --sidebar-width: 260px; --primary: #2c3e50; --danger: #e74c3c; --success: #27ae60; --accent: #3498db; }
        body { display: flex; font-family: 'Segoe UI', sans-serif; margin: 0; background: #f4f7f6; }
        .sidebar { width: var(--sidebar-width); background: var(--primary); color: white; height: 100vh; padding: 20px; position: fixed; }
        .sidebar h2 { border-bottom: 1px solid #34495e; padding-bottom: 10px; margin-bottom: 20px; font-size: 1.2rem; }
        .sidebar a { color: #ecf0f1; text-decoration: none; display: block; padding: 12px; border-radius: 5px; margin-bottom: 5px; transition: 0.3s; }
        .sidebar a:hover { background: #34495e; }
        .main-content { margin-left: var(--sidebar-width); padding: 40px; width: calc(100% - var(--sidebar-width)); }
        .card { background: white; padding: 25px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); margin-bottom: 30px; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #eee; }
        th { background: #f8f9fa; color: var(--primary); }
        .badge { padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: bold; }
        /* Role styling based on your database roles */
        .Student { background: #e3f2fd; color: #0d47a1; }
        .Lecturer { background: #e8f5e9; color: #1b5e20; }
        .Leader { background: #fff3e0; color: #e65100; }
        .btn { padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; color: white; text-decoration: none; display: inline-block; }
        .btn-approve { background: var(--success); }
        .btn-delete { background: var(--danger); font-size: 11px; }
        .action-bar { background: #fff; padding: 15px; border-radius: 8px; margin-bottom: 15px; display: flex; gap: 15px; align-items: center; border-left: 5px solid var(--success); }
        select, input[type="file"], input[type="text"] { padding: 8px; border-radius: 4px; border: 1px solid #ddd; }
    </style>
</head>
<body>

<div class="sidebar">
    <h2><i class="fas fa-university"></i> <%= user.section %> Portal</h2>
    <p><small>Admin:</small> <strong><%= user.name %></strong></p>
    <nav>
        <a href="/master">🏠 Dashboard Overview</a>
        <a href="/attendance-history">📅 Attendance History</a> 
        <a href="/logout" style="color: #ff7675; margin-top: 50px;"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </nav>
</div>

<div class="main-content">
    <h1>Administration Panel <span style="background: #9b59b6; color: white; padding: 2px 10px; border-radius: 5px; font-size: 14px;"><%= user.section %></span></h1>

    <div class="card">
        <h3>Subject Management</h3>
        <form action="/add-subject" method="POST" style="display: flex; gap: 10px; margin-bottom: 20px;">
            <input type="hidden" name="section" value="<%= user.section %>">
            <input type="text" name="subjectName" placeholder="New Subject Name" required style="flex:1;">
            <button type="submit" class="btn" style="background: var(--accent);">Add Subject</button>
        </form>
        <table>
            <thead><tr><th>Subject Name</th><th>Action</th></tr></thead>
            <tbody>
                <% if (masterSubjects && masterSubjects.length > 0) { %>
                    <% masterSubjects.forEach(sub => { %>
                        <tr>
                            <td><strong><%= sub.name %></strong></td> 
                            <td>
                                <form action="/delete-subject/<%= sub._id %>" method="POST">
                                    <button type="submit" class="btn btn-delete" onclick="return confirm('Delete this subject?')">Remove</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="2" style="text-align: center;">No subjects found for <%= user.section %>.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <div class="card">
        <h3>User Management (<%= user.section %>)</h3>
        <form action="/bulk-approve" method="POST">
            <input type="hidden" name="section" value="<%= user.section %>">
            <div class="action-bar">
                <input type="checkbox" id="selectAll"> <label for="selectAll">Select All</label>
                <span style="margin-left: 15px;">Role:</span>
                <select name="targetRole">
                    <option value="Student">Student</option>
                    <option value="Leader">Leader</option>
                    <option value="Lecturer">Lecturer</option>
                </select>
                <button type="submit" class="btn btn-approve">Save Changes</button>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>Select</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% allUsers.forEach(u => { %>
                        <tr>
                            <td><input type="checkbox" name="userIds[]" value="<%= u._id %>" class="user-checkbox"></td>
                            <td><%= u.name %></td>
                            <td><small><%= u.email %></small></td>
                            <td>
                                <span class="badge <%= u.role %>">
                                    <%= u.role %> <%= u.approved ? '(Approved)' : '(Pending)' %>
                                </span>
                            </td>
                            <td>
                                <form action="/delete-user/<%= u._id %>" method="POST">
                                    <button type="submit" class="btn btn-delete" onclick="return confirm('Delete user?')">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </form>
    </div>

    <div class="card">
        <h3>Bulk Registration</h3>
        <form action="/upload-users" method="POST" enctype="multipart/form-data">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div>
                    <label>Target Section:</label>
                    <select name="section" required style="width:100%;">
                        <option value="<%= user.section %>"><%= user.section %> (Current)</option>
                        <option value="CSE-A">CSE-A</option>
                        <option value="CSE-B">CSE-B</option>
                    </select>
                </div>
                <div>
                    <label>File (.xlsx / .csv):</label>
                    <input type="file" name="csvFile" required style="width:100%;">
                </div>
            </div>
            <button type="submit" class="btn btn-upload" style="background: var(--accent); margin-top: 15px; width: 100%;">Upload List</button>
        </form>
    </div>
</div>

<script>
    document.getElementById('selectAll').addEventListener('change', function() {
        document.querySelectorAll('.user-checkbox').forEach(cb => cb.checked = this.checked);
    });
</script>
</body>
</html>