<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Lecturer Dashboard</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        .status-btn { padding: 5px 10px; border-radius: 4px; cursor: pointer; border: none; font-weight: bold; }
        .Present { background-color: #2ecc71; color: white; }
        .Absent { background-color: #e74c3c; color: white; }
        .record-card { border: 1px solid #ddd; margin-bottom: 15px; border-radius: 8px; overflow: hidden; }
        .record-header { background: #f8f9fa; padding: 15px; display: flex; justify-content: space-between; cursor: pointer; }
        .student-list { display: none; padding: 15px; background: white; border-top: 1px solid #eee; }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1>Lecturer Dashboard</h1>
        <p>Welcome, <strong><%= user.name %></strong> | <a href="/logout">Logout</a></p>
    </div>

    <h3>Assigned Attendance Records</h3>
    <div id="attendanceContainer">
        <% if (records.length > 0) { %>
            <% records.forEach(rec => { %>
                <div class="record-card">
                    <div class="record-header" onclick="toggleDetails('<%= rec._id %>')">
                        <span><strong>Date:</strong> <%= rec.date %></span>
                        <span><strong>Time:</strong> <%= rec.manualTime || 'N/A' %></span>
                        <span><strong>Subject:</strong> <%= rec.subject %></span>
                        <span><strong>Total:</strong> <%= rec.students.length %> Students (Click to Edit)</span>
                    </div>
                    
                    <div class="student-list" id="list-<%= rec._id %>">
                        <table style="width: 100%;">
                            <thead>
                                <tr><th>Roll No</th><th>Student Name</th><th>Status (Click to toggle)</th></tr>
                            </thead>
                            <tbody>
                                <% rec.students.forEach(s => { %>
                                    <tr>
                                        <td><%= s.studentId %></td>
                                        <td><%= s.studentName %></td>
                                        <td>
                                            <button 
                                                class="status-btn <%= s.status %>" 
                                                onclick="toggleStatus('<%= rec._id %>', '<%= s.studentId %>', '<%= s.status %>')">
                                                <%= s.status %>
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <p>No locked periods assigned to you yet.</p>
        <% } %>
    </div>
</div>

<script>
    function toggleDetails(id) {
        const el = document.getElementById('list-' + id);
        el.style.display = (el.style.display === 'block') ? 'none' : 'block';
    }

    async function toggleStatus(attendanceId, studentId, currentStatus) {
        const newStatus = (currentStatus === 'Present') ? 'Absent' : 'Present';
        
        try {
            const response = await fetch('/update-attendance-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ attendanceId, studentId, newStatus })
            });

            if (response.ok) {
                location.reload(); // Refresh to show updated status
            } else {
                alert("Failed to update status.");
            }
        } catch (err) {
            console.error(err);
        }
    }
</script>

</body>
</html>