<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>College Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body { background-color: #f4f7f6; height: 100vh; display: flex; align-items: center; justify-content: center; font-family: 'Segoe UI', sans-serif; }
        .login-card { background: white; padding: 40px; border-radius: 12px; box-shadow: 0 8px 20px rgba(0,0,0,0.1); width: 100%; max-width: 450px; text-align: center; }
        .google-btn { display: flex; align-items: center; justify-content: center; background-color: #4285F4; color: white; padding: 12px 24px; text-decoration: none; border-radius: 5px; font-weight: bold; transition: background 0.3s; margin-bottom: 15px; border: none; width: 100%; }
        .google-btn:hover { background-color: #357ae8; color: white; }
        .admin-btn { display: flex; align-items: center; justify-content: center; background-color: #212529; color: white; padding: 12px 24px; text-decoration: none; border-radius: 5px; font-weight: bold; transition: opacity 0.3s; width: 100%; border: none; }
        .admin-btn:hover { opacity: 0.9; color: #ffc107; }
    </style>
</head>
<body>

    <div class="login-card">
        <h2 class="fw-bold mb-3">Attendance Portal</h2>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger small py-2 mb-4">
                <i class="fas fa-exclamation-circle me-1"></i> <%= error %>
            </div>
        <% } %>

        <p class="text-muted mb-4">Select your login role below:</p>
        
        <a href="/auth/google" class="google-btn">
            <i class="fab fa-google me-2"></i> Standard Login (@rku.ac.in)
        </a>

        <a href="/auth/google" class="admin-btn">
            <i class="fas fa-user-shield me-2 text-warning"></i> Super Admin Login
        </a>

        <p class="small text-secondary mt-4">Only official RKU emails are permitted.</p>

        <hr class="my-4">

        <div class="login-footer">
            <p class="mb-1 text-muted small">Need specialized access?</p>
            <a href="/register" class="text-primary fw-bold text-decoration-none">Request Super Admin Role</a>
        </div>
    </div>

</body>
</html>