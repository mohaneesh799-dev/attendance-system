<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user.section %> - Master Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --sidebar-width: 260px; --primary: #1a2a3a; --danger: #ff4757; --success: #2ed573; --accent: #1e90ff; --bg: #f1f2f6; }
        body { display: flex; font-family: 'Inter', sans-serif; margin: 0; background: var(--bg); color: #2f3542; }
        .sidebar { width: var(--sidebar-width); background: var(--primary); color: white; height: 100vh; padding: 25px; position: fixed; box-shadow: 4px 0 10px rgba(0,0,0,0.1); }
        .sidebar h2 { font-weight: 800; letter-spacing: 1px; color: var(--accent); margin-bottom: 30px; display: flex; align-items: center; gap: 10px; }
        .sidebar a { color: #a4b0be; text-decoration: none; display: flex; align-items: center; gap: 12px; padding: 14px; border-radius: 8px; margin-bottom: 8px; transition: 0.3s; }
        .sidebar a:hover, .sidebar a.active { background: rgba(255,255,255,0.1); color: white; }
        .main-content { margin-left: var(--sidebar-width); padding: 40px; width: calc(100% - var(--sidebar-width)); }
        .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: white; padding: 20px; border-radius: 12px; display: flex; align-items: center; gap: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        .stat-icon { font-size: 2rem; color: var(--accent); background: rgba(30, 144, 255, 0.1); padding: 15px; border-radius: 10px; }
        .card { background: white; padding: 25px; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); margin-bottom: 30px; border: 1px solid rgba(0,0,0,0.05); }
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: 15px; background: #f8f9fa; font-size: 0.85rem; text-transform: uppercase; color: #747d8c; }
        td { padding: 15px; border-bottom: 1px solid #f1f2f6; }
        .badge { padding: 6px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; text-transform: uppercase; }
        .Student { background: #e3f2fd; color: #1e90ff; }
        .Lecturer { background: #e8f5e9; color: #2ed573; }
        .Leader { background: #fff3e0; color: #ffa502; }
        .btn { padding: 10px 18px; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; transition: 0.2s; display: inline-flex; align-items: center; gap: 8px; }
        .btn-approve { background: var(--success); color: white; }
        .btn-delete { background: #ffeef0; color: var(--danger); }
        .btn-accent { background: var(--accent); color: white; }
    </style>
</head>
<body>

<div class="sidebar">
    <h2><i class="fas fa-shield-alt"></i> MASTER</h2>
    <div style="background: rgba(255,255,255,0.05); padding: 15px; border-radius: 10px; margin-bottom: 25px;">
        <small style="color: #747d8c; display: block;">Authorized Faculty</small>
        <strong><%= user.name %></strong>
        <div style="margin-top: 5px;"><span class="badge" style="background: var(--accent); color: white;"><%= user.section %></span></div>
    </div>
    <nav>
        <a href="/master" class="active"><i class="fas fa-th-large"></i> Dashboard</a>
        <a href="/attendance-history"><i class="fas fa-history"></i> History</a>
        <a href="/export-attendance-full" style="color: #2ed573;"><i class="fas fa-file-excel"></i> Export Attendance</a>
        <a href="/logout" style="margin-top: 40px; color: var(--danger);"><i class="fas fa-power-off"></i> Logout</a>
    </nav>
</div>

<div class="main-content">
    <header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <h1>Section Command Center</h1>
        <div id="clock" style="font-weight: 600; color: var(--primary);"></div>
    </header>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-users"></i></div>
            <div><small>Total Users</small><h2><%= allUsers.length %></h2></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="color: var(--danger);"><i class="fas fa-user-clock"></i></div>
            <div><small>Pending</small><h2><%= allUsers.filter(u => !u.isApproved).length %></h2></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="color: var(--success);"><i class="fas fa-book-open"></i></div>
            <div><small>Subjects</small><h2><%= masterSubjects.length %></h2></div>
        </div>
    </div>

    <div class="card">
        <h3><i class="fas fa-book"></i> Subject Management</h3>
        <form action="/add-subject" method="POST" style="display: flex; gap: 10px; margin-bottom: 20px;">
            <input type="hidden" name="section" value="<%= user.section %>">
            <input type="text" name="subjectName" placeholder="New Subject Name" required style="flex:1; padding: 10px; border-radius: 8px; border: 1px solid #ddd;">
            <button type="submit" class="btn btn-accent">Add Subject</button>
        </form>
        <table>
            <% masterSubjects.forEach(sub => { %>
                <tr>
                    <td><strong><%= sub.name %></strong></td>
                    <td style="text-align: right;">
                        <form action="/delete-subject/<%= sub._id %>" method="POST">
                            <button type="submit" class="btn btn-delete" onclick="return confirm('Delete subject?')">Remove</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </table>
    </div>

    <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3>User Management</h3>
            <div style="width: 300px; position: relative;">
                <i class="fas fa-search" style="position: absolute; left: 10px; top: 12px; color: #ccc;"></i>
                <input type="text" id="userSearch" placeholder="Search..." onkeyup="filterUsers()" style="width: 100%; padding: 10px 10px 10px 35px; border-radius: 8px; border: 1px solid #ddd;">
            </div>
        </div>

        <form action="/bulk-approve" method="POST">
            <input type="hidden" name="section" value="<%= user.section %>">
            <div style="background: #f8f9fa; padding: 15px; border-radius: 10px; display: flex; gap: 15px; align-items: center; margin-bottom: 15px;">
                <input type="checkbox" id="selectAll"> <label for="selectAll"><strong>Select All</strong></label>
                <select name="targetRole" class="btn" style="background: white; border: 1px solid #ddd; color: #333;">
                    <option value="Student">Assign Student</option>
                    <option value="Leader">Assign Leader</option>
                    <option value="Lecturer">Assign Lecturer</option>
                </select>
                <button type="submit" class="btn btn-approve">Update & Approve</button>
            </div>

            <table id="userTable">
                <thead>
                    <tr>
                        <th>Select</th>
                        <th>Name</th>
                        <th>Role Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% allUsers.forEach(u => { %>
                        <tr>
                            <td><input type="checkbox" name="userIds[]" value="<%= u._id %>" class="user-checkbox"></td>
                            <td><strong><%= u.name %></strong><br><small><%= u.email %></small></td>
                            <td>
                                <span class="badge <%= u.role %>"><%= u.role %></span>
                                <% if(u.isApproved) { %>
                                    <i class="fas fa-check-circle" style="color: var(--success);"></i>
                                <% } else { %>
                                    <span class="badge" style="background: #fed330; color: #333;">Pending</span>
                                <% } %>
                            </td>
                            <td>
                                <form action="/delete-user/<%= u._id %>" method="POST">
                                    <button class="btn btn-delete"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </form>
    </div>

    <div class="card">
        <h3><i class="fas fa-upload"></i> Bulk Student Import</h3>
        <p><small>Upload a CSV file with headers: <code>name, email, studentId</code></small></p>
        <form action="/upload-users" method="POST" enctype="multipart/form-data" style="display: flex; gap: 15px; align-items: center;">
            <input type="hidden" name="section" value="<%= user.section %>">
            <input type="file" name="csvFile" accept=".csv" required style="flex: 1; padding: 8px; border: 1px dashed var(--accent); border-radius: 8px;">
            <button type="submit" class="btn btn-accent">Upload & Auto-Approve</button>
        </form>
    </div>
</div>

<script>
    function filterUsers() {
        let input = document.getElementById('userSearch').value.toLowerCase();
        let rows = document.getElementById('userTable').getElementsByTagName('tr');
        for (let i = 1; i < rows.length; i++) {
            rows[i].style.display = rows[i].innerText.toLowerCase().includes(input) ? "" : "none";
        }
    }
    document.getElementById('selectAll').addEventListener('change', function() {
        document.querySelectorAll('.user-checkbox').forEach(cb => cb.checked = this.checked);
    });
    setInterval(() => { document.getElementById('clock').innerText = new Date().toLocaleTimeString(); }, 1000);
</script>
</body>
</html>