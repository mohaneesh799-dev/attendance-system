<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user.section %> — Master Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* ── CSS Variables ── */
        :root {
            --sw: 260px; --primary: #1a2a3a; --danger: #ff4757; --success: #2ed573;
            --accent: #1e90ff; --warning: #fed330; --bg: #f1f2f6; --text: #2f3542;
            --card: #ffffff; --muted: #747d8c; --border: #f1f2f6;
            --th-bg: #f8f9fa; --th-color: #747d8c; --hover-row: #fafbff;
            --input-bg: #fff; --input-border: #ddd; --sidebar-text: #a4b0be;
        }
        html.dark {
            --bg: #1a1e2a; --card: #242938; --text: #d4daf0; --muted: #7a87a3;
            --border: #303550; --th-bg: #1e2230; --th-color: #8899b5;
            --hover-row: #2a2f45; --input-bg: #1e2230; --input-border: #3a4060;
        }
        * { box-sizing: border-box; }
        body {
            display: flex; font-family: 'Inter', 'Segoe UI', sans-serif;
            margin: 0; background: var(--bg); color: var(--text);
            transition: background 0.3s, color 0.3s;
        }

        /* ── Sidebar ── */
        .sidebar {
            width: var(--sw); background: var(--primary); color: white;
            height: 100vh; padding: 22px 18px; position: fixed;
            box-shadow: 4px 0 12px rgba(0,0,0,0.15); z-index: 100;
            overflow-y: auto; transition: transform 0.28s ease;
        }
        .sidebar h2 {
            font-weight: 800; color: var(--accent); margin: 0 0 20px;
            display: flex; align-items: center; gap: 10px; font-size: 1.15rem;
        }
        .user-panel {
            background: rgba(255,255,255,0.06); padding: 14px; border-radius: 10px;
            margin-bottom: 22px;
        }
        .user-panel small { color: #747d8c; display: block; font-size: 11px; text-transform: uppercase; margin-bottom: 4px; }
        .user-panel strong { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; font-size: 14px; }
        .sidebar a {
            color: var(--sidebar-text); text-decoration: none; display: flex;
            align-items: center; gap: 11px; padding: 12px 14px; border-radius: 8px;
            margin-bottom: 4px; transition: 0.2s; font-size: 14px;
        }
        .sidebar a:hover, .sidebar a.active { background: rgba(255,255,255,0.1); color: white; }

        /* ── Hamburger ── */
        .hamburger {
            display: none; position: fixed; top: 14px; left: 14px; z-index: 200;
            background: var(--primary); border: none; border-radius: 8px;
            padding: 10px 13px; cursor: pointer; color: white; font-size: 18px;
            box-shadow: 0 4px 14px rgba(0,0,0,0.3);
        }
        .overlay-bg {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,0.5); z-index: 90;
        }

        /* ── Main Content ── */
        .main-content {
            margin-left: var(--sw); padding: 36px 36px 36px;
            width: calc(100% - var(--sw)); min-height: 100vh;
        }
        .page-header {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 28px; flex-wrap: wrap; gap: 12px;
        }
        .page-header h1 { margin: 0; font-size: 1.5rem; color: var(--text); }
        .page-header p { color: var(--muted); margin: 4px 0 0; font-size: 14px; }
        .header-right { display: flex; align-items: center; gap: 10px; }
        .theme-btn {
            background: var(--card); border: 1.5px solid var(--border);
            color: var(--muted); border-radius: 8px; padding: 9px 12px;
            cursor: pointer; font-size: 15px; transition: 0.2s;
        }
        .theme-btn:hover { border-color: var(--accent); }

        /* ── Stats ── */
        .stats-grid {
            display: grid; grid-template-columns: repeat(3, 1fr);
            gap: 18px; margin-bottom: 28px;
        }
        .stat-card {
            background: var(--card); padding: 20px; border-radius: 14px;
            display: flex; align-items: center; gap: 18px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid var(--border);
        }
        .stat-icon {
            font-size: 1.8rem; color: var(--accent);
            background: rgba(30,144,255,0.1); padding: 14px;
            border-radius: 10px; flex-shrink: 0;
        }
        .stat-card small { color: var(--muted); text-transform: uppercase; font-weight: 600; font-size: 11px; display: block; margin-bottom: 4px; }
        .stat-card h2 { margin: 0; font-size: 1.8rem; font-weight: 800; color: var(--text); }

        /* ── Cards ── */
        .card {
            background: var(--card); padding: 24px 26px; border-radius: 15px;
            box-shadow: 0 6px 24px rgba(0,0,0,0.05); margin-bottom: 26px;
            border: 1px solid var(--border);
        }
        .card h3 { margin: 0 0 18px; color: var(--text); font-size: 1rem; display: flex; align-items: center; gap: 9px; }

        /* ── Alerts ── */
        .alert { padding: 13px 18px; border-radius: 10px; margin-bottom: 20px; font-size: 14px; display: flex; align-items: center; gap: 10px; }
        .alert-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .alert-error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
        html.dark .alert-success { background: #1a3325; color: #7dcea0; border-color: #2e7d52; }
        html.dark .alert-error { background: #3a1a1e; color: #e08080; border-color: #7d2e30; }

        /* ── Subject Form ── */
        .subject-form { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; }
        .subject-form input, .subject-form select {
            padding: 10px 12px; border-radius: 8px; border: 1.5px solid var(--input-border);
            font-size: 14px; outline: none; background: var(--input-bg);
            color: var(--text); transition: border 0.2s;
        }
        .subject-form input:focus { border-color: var(--accent); }
        .subject-form input[style*="flex:2"] { flex: 2; min-width: 150px; }
        .subject-form input[style*="flex:1"] { flex: 1; min-width: 100px; }

        /* ── Buttons ── */
        .btn {
            padding: 10px 16px; border: none; border-radius: 8px; cursor: pointer;
            font-weight: 600; transition: 0.2s; display: inline-flex; align-items: center;
            gap: 7px; font-size: 13px; text-decoration: none; white-space: nowrap;
        }
        .btn:hover { filter: brightness(1.08); transform: translateY(-1px); }
        .btn-accent { background: var(--accent); color: white; }
        .btn-approve { background: var(--success); color: white; }
        .btn-delete { background: #ffeef0; color: var(--danger); border: 1px solid #ffd0d6; }
        .btn-delete:hover { background: var(--danger); color: white; transform: none; }

        /* ── Table ── */
        .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
        table { width: 100%; border-collapse: collapse; min-width: 480px; }
        th {
            text-align: left; padding: 13px 14px; background: var(--th-bg);
            font-size: 11px; text-transform: uppercase; color: var(--th-color);
            border-bottom: 2px solid var(--border); white-space: nowrap;
        }
        td { padding: 13px 14px; border-bottom: 1px solid var(--border); font-size: 13px; color: var(--text); vertical-align: middle; }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: var(--hover-row); }

        /* ── Badges ── */
        .badge { padding: 4px 11px; border-radius: 6px; font-size: 11px; font-weight: 700; text-transform: uppercase; display: inline-block; }
        .Student { background: #e3f2fd; color: #1e90ff; }
        .Lecturer { background: #e8f5e9; color: #2ed573; }
        .Leader { background: #fff3e0; color: #ffa502; }
        .Master { background: #ede7f6; color: #8e44ad; }
        .pending-tag { background: var(--warning); color: #333; }
        .active-tag { color: var(--success); font-size: 12px; }
        html.dark .Student { background: #1a2d3f; color: #5b9fe0; }
        html.dark .Lecturer { background: #1a3325; color: #7dcea0; }
        html.dark .Leader { background: #3a2a10; color: #e8c060; }

        /* ── Bulk Action Bar ── */
        .bulk-action-bar {
            position: sticky; top: 0; background: var(--th-bg); padding: 13px 16px;
            border-radius: 10px; display: flex; gap: 12px; align-items: center;
            margin-bottom: 14px; border: 1.5px solid var(--border); z-index: 10; flex-wrap: wrap;
        }
        .bulk-action-bar select {
            padding: 8px 12px; border-radius: 8px; border: 1.5px solid var(--input-border);
            font-size: 13px; background: var(--input-bg); color: var(--text);
            outline: none; min-width: 150px;
        }

        /* ── Search ── */
        .search-wrapper { position: relative; }
        .search-wrapper i { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--muted); pointer-events: none; font-size: 13px; }
        .search-wrapper input {
            padding: 10px 14px 10px 34px; border-radius: 8px;
            border: 1.5px solid var(--input-border); font-size: 13px; outline: none;
            background: var(--input-bg); color: var(--text); transition: border 0.2s; width: 260px;
        }
        .search-wrapper input:focus { border-color: var(--accent); }

        /* ── Import Card ── */
        .import-card { border: 2px dashed var(--accent) !important; background: rgba(30,144,255,0.02) !important; }
        .import-form { display: flex; gap: 12px; align-items: center; margin-top: 14px; flex-wrap: wrap; }
        .import-form input[type="file"] {
            flex: 1; padding: 10px 12px; background: var(--input-bg);
            border-radius: 8px; border: 1.5px solid var(--input-border);
            color: var(--text); min-width: 200px; font-size: 13px;
        }

        /* ── Clock ── */
        #clock { font-weight: 700; color: var(--accent); font-size: 1.1rem; }

        /* ── Responsive ── */
        @media (max-width: 900px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.open { transform: translateX(0); }
            .main-content { margin-left: 0; width: 100%; padding: 70px 16px 20px; }
            .hamburger { display: block; }
            .overlay-bg.open { display: block; }
            .stats-grid { grid-template-columns: repeat(2,1fr); }
        }
        @media (max-width: 600px) {
            .stats-grid { grid-template-columns: 1fr; gap: 12px; }
            .stat-card { padding: 16px; }
            .card { padding: 18px 14px; }
            .subject-form { flex-direction: column; }
            .subject-form input, .subject-form .btn { width: 100%; }
            .search-wrapper input { width: 100%; }
            .bulk-action-bar { flex-direction: column; align-items: stretch; }
            .bulk-action-bar select { width: 100%; }
            .import-form { flex-direction: column; }
            .import-form input[type="file"] { width: 100%; }
            .import-form .btn { width: 100%; justify-content: center; }
            .page-header { flex-direction: column; align-items: flex-start; }
        }
    </style>
</head>
<body>

<!-- Hamburger Button -->
<button class="hamburger" id="hamburgerBtn" onclick="toggleSidebar()" aria-label="Menu">
    <i class="fas fa-bars" id="hamburgerIcon"></i>
</button>
<div class="overlay-bg" id="overlayBg" onclick="closeSidebar()"></div>

<!-- Sidebar -->
<div class="sidebar" id="sidebar">
    <h2><i class="fas fa-shield-alt"></i> MASTER</h2>
    <div class="user-panel">
        <small>Authorized Faculty</small>
        <strong><%= user.name %></strong>
        <div style="margin-top:6px;">
            <span class="badge" style="background:var(--accent);color:white;"><%= user.section %></span>
        </div>
    </div>
    <nav>
        <a href="/master" class="active"><i class="fas fa-th-large"></i> Dashboard</a>
        <a href="/attendance-history"><i class="fas fa-history"></i> History</a>
        <a href="/export-attendance" style="color:#2ed573;"><i class="fas fa-file-excel"></i> Export CSV</a>
        <a href="/settings"><i class="fas fa-cog"></i> Settings</a>
        <a href="/logout" style="margin-top:40px;color:var(--danger);"><i class="fas fa-power-off"></i> Logout</a>
    </nav>
</div>

<!-- Main Content -->
<div class="main-content">
    <div class="page-header">
        <div>
            <h1>Section Command Center</h1>
            <p>Managing all records for <strong><%= user.section %></strong></p>
        </div>
        <div class="header-right">
            <span id="clock"></span>
            <button class="theme-btn" onclick="toggleDark()" id="themeBtnIcon" title="Toggle theme">🌙</button>
        </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-users"></i></div>
            <div>
                <small>Total Users</small>
                <h2><%= stats.total %></h2>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="color:var(--danger);background:rgba(255,71,87,0.1);"><i class="fas fa-user-clock"></i></div>
            <div>
                <small>Pending Approval</small>
                <h2 style="color:<%= stats.pending > 0 ? 'var(--danger)' : 'var(--text)' %>"><%= stats.pending %></h2>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="color:var(--success);background:rgba(46,213,115,0.1);"><i class="fas fa-book-open"></i></div>
            <div>
                <small>Subjects</small>
                <h2><%= stats.subjects %></h2>
            </div>
        </div>
    </div>

    <!-- Subject Management -->
    <div class="card">
        <h3><i class="fas fa-book" style="color:var(--accent);"></i> Subject Management</h3>
        <form action="/add-subject" method="POST" class="subject-form">
            <input type="hidden" name="section" value="<%= user.section %>">
            <input type="text" name="subjectName" placeholder="Subject Name (e.g. Mathematics)" required style="flex:2;">
            <input type="text" name="subjectCode" placeholder="Code (e.g. MA301)" style="flex:1;">
            <button type="submit" class="btn btn-accent"><i class="fas fa-plus"></i> Add Subject</button>
        </form>

        <% if (masterSubjects && masterSubjects.length > 0) { %>
            <div class="table-scroll">
            <table>
                <thead>
                    <tr><th>Code</th><th>Subject Name</th><th style="text-align:right;">Action</th></tr>
                </thead>
                <tbody>
                    <% masterSubjects.forEach(function(sub) { %>
                        <tr>
                            <td style="font-family:monospace;font-weight:bold;color:var(--accent);"><%= sub.code || '—' %></td>
                            <td><strong><%= sub.name %></strong></td>
                            <td style="text-align:right;">
                                <form action="/delete-subject/<%= sub._id %>" method="POST" style="display:inline;">
                                    <button type="submit" class="btn btn-delete" onclick="return confirm('Delete this subject?')">
                                        <i class="fas fa-times"></i> Remove
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
            </div>
        <% } else { %>
            <p style="text-align:center;color:var(--muted);padding:20px;">No subjects added yet.</p>
        <% } %>
    </div>

    <!-- User Management -->
    <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;flex-wrap:wrap;gap:12px;">
            <h3 style="margin:0;"><i class="fas fa-users" style="color:var(--accent);"></i> User Management</h3>
            <div class="search-wrapper">
                <i class="fas fa-search"></i>
                <input type="text" id="userSearch" placeholder="Search by name or email...">
            </div>
        </div>

        <form action="/bulk-approve" method="POST">
            <input type="hidden" name="section" value="<%= user.section %>">
            <div class="bulk-action-bar">
                <input type="checkbox" id="selectAll" style="transform:scale(1.2);cursor:pointer;">
                <label for="selectAll" style="cursor:pointer;font-weight:600;color:var(--text);">Select All</label>
                <div style="flex:1;"></div>
                <select name="targetRole" required>
                    <option value="" disabled selected>Assign Role…</option>
                    <option value="Student">Student</option>
                    <option value="Leader">Leader</option>
                    <option value="Lecturer">Lecturer</option>
                </select>
                <button type="submit" class="btn btn-approve">
                    <i class="fas fa-user-check"></i> Bulk Update &amp; Approve
                </button>
            </div>

            <div class="table-scroll">
            <table id="userTable">
                <thead>
                    <tr>
                        <th width="40"></th>
                        <th>User Details</th>
                        <th>Role &amp; Status</th>
                        <th style="text-align:center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (allUsers && allUsers.length > 0) { %>
                        <% allUsers.forEach(function(u) { %>
                            <tr>
                                <td><input type="checkbox" name="userIds[]" value="<%= u._id %>" class="user-checkbox"></td>
                                <td>
                                    <strong><%= u.name || '—' %></strong>
                                    <div style="font-size:12px;color:var(--muted);margin-top:2px;"><%= u.email %></div>
                                    <% if(u.rollNo) { %><div style="font-size:11px;color:var(--muted);font-family:monospace;">Roll: <%= u.rollNo %></div><% } %>
                                </td>
                                <td>
                                    <span class="badge <%= u.role %>"><%= u.role || 'Unassigned' %></span>
                                    <% if(u.isApproved) { %>
                                        <span class="active-tag" style="margin-left:8px;"><i class="fas fa-check-circle"></i> Active</span>
                                    <% } else { %>
                                        <span class="badge pending-tag" style="margin-left:6px;">Pending</span>
                                    <% } %>
                                </td>
                                <td style="text-align:center;">
                                    <div style="display:flex;gap:6px;justify-content:center;flex-wrap:wrap;">
                                        <% if (!u.isApproved) { %>
                                            <form action="/approve-user/<%= u._id %>" method="POST" style="display:inline;">
                                                <button class="btn btn-approve" style="padding:7px 11px;font-size:12px;">
                                                    <i class="fas fa-check"></i> Approve
                                                </button>
                                            </form>
                                        <% } %>
                                        <form action="/delete-user/<%= u._id %>" method="POST" onsubmit="return confirm('Permanently delete this user?')">
                                            <button class="btn btn-delete" title="Delete User" style="padding:7px 11px;font-size:12px;">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" style="text-align:center;padding:40px;color:var(--muted);">
                                <i class="fas fa-user-slash" style="font-size:2rem;display:block;margin-bottom:10px;opacity:0.4;"></i>
                                No users found in this section.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
            </div>
        </form>
    </div>

    <!-- CSV Import -->
    <div class="card import-card">
        <h3><i class="fas fa-file-import" style="color:var(--accent);"></i> Bulk Student Import (CSV)</h3>
        <p style="color:var(--muted);font-size:14px;margin:0 0 4px;">
            Import multiple students at once. CSV format: <code style="background:var(--th-bg);padding:2px 6px;border-radius:4px;font-size:12px;">name, email, studentId</code> (with header row).
        </p>
        <form action="/upload-users" method="POST" enctype="multipart/form-data" class="import-form">
            <input type="hidden" name="section" value="<%= user.section %>">
            <input type="file" name="csvFile" accept=".csv" required>
            <button type="submit" class="btn btn-accent"><i class="fas fa-upload"></i> Upload &amp; Auto-Approve</button>
        </form>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // ── Apply saved theme ──
    if (localStorage.getItem('rku-theme') === 'dark') {
        document.getElementById('htmlRoot').classList.add('dark');
        document.getElementById('themeBtnIcon').textContent = '☀️';
    }

    // ── Real-time Search ──
    const searchInput = document.getElementById('userSearch');
    if (searchInput) {
        searchInput.addEventListener('keyup', function() {
            const query = this.value.toLowerCase();
            document.querySelectorAll('#userTable tbody tr').forEach(function(row) {
                row.style.display = row.textContent.toLowerCase().includes(query) ? '' : 'none';
            });
        });
    }

    // ── Select All ──
    const selectAllBox = document.getElementById('selectAll');
    if (selectAllBox) {
        selectAllBox.addEventListener('change', function() {
            const isChecked = this.checked;
            document.querySelectorAll('.user-checkbox').forEach(function(cb) {
                if (cb.closest('tr').style.display !== 'none') cb.checked = isChecked;
            });
        });
        document.querySelectorAll('.user-checkbox').forEach(function(cb) {
            cb.addEventListener('change', function() {
                if (!this.checked) selectAllBox.checked = false;
            });
        });
    }

    // ── Dynamic Clock ──
    function updateClock() {
        const el = document.getElementById('clock');
        if (el) el.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }
    setInterval(updateClock, 1000);
    updateClock();
});

// ── Theme Toggle ──
function toggleDark() {
    const isDark = document.getElementById('htmlRoot').classList.toggle('dark');
    localStorage.setItem('rku-theme', isDark ? 'dark' : 'light');
    document.getElementById('themeBtnIcon').textContent = isDark ? '☀️' : '🌙';
}

// ── Mobile Sidebar ──
function toggleSidebar() {
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('overlayBg');
    const icon = document.getElementById('hamburgerIcon');
    const isOpen = sidebar.classList.toggle('open');
    overlay.classList.toggle('open', isOpen);
    icon.className = isOpen ? 'fas fa-times' : 'fas fa-bars';
}
function closeSidebar() {
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('overlayBg').classList.remove('open');
    document.getElementById('hamburgerIcon').className = 'fas fa-bars';
}
document.querySelectorAll('.sidebar a').forEach(function(a) {
    a.addEventListener('click', function() {
        if (window.innerWidth <= 900) closeSidebar();
    });
});
</script>
</body>
</html>
