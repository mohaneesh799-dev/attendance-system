<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .container { padding: 20px; font-family: 'Segoe UI', sans-serif; max-width: 900px; margin: auto; }
        .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #007bff; padding-bottom: 10px; margin-bottom: 20px; }
        .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
        .stat-card { background: #f8f9fa; padding: 20px; border-radius: 10px; text-align: center; border: 1px solid #dee2e6; }
        .stat-number { font-size: 2em; font-weight: bold; color: #007bff; }
        table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; }
        th, td { padding: 12px; border: 1px solid #eee; text-align: left; }
        th { background-color: #007bff; color: white; }
        .status-present { color: #28a745; font-weight: bold; }
        .status-absent { color: #dc3545; font-weight: bold; }
        .logout-btn { background-color: #dc3545; color: white; padding: 8px 15px; text-decoration: none; border-radius: 5px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div>
                <h1>Student Dashboard</h1>
                <p>Welcome, <strong><%= user.name %></strong> (Roll No: <%= user.rollNo || 'N/A' %>)</p>
            </div>
            <a href="/logout" class="logout-btn">Logout</a>
        </div>

        <% 
            // Logic to calculate stats
            let totalClasses = 0;
            let presentCount = 0;
            
            attendanceRecords.forEach(record => {
                const myRecord = record.records.find(r => r.studentName === user.name);
                if (myRecord) {
                    totalClasses++;
                    if (myRecord.status === 'Present') presentCount++;
                }
            });
            
            let percentage = totalClasses > 0 ? ((presentCount / totalClasses) * 100).toFixed(2) : 0;
        %>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Total Classes</div>
                <div class="stat-number"><%= totalClasses %></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Attendance Percentage</div>
                <div class="stat-number"><%= percentage %>%</div>
            </div>
        </div>

        <h3>Detailed Attendance History</h3>
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Subject</th>
                    <th>Period/Time</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% if (attendanceRecords.length === 0) { %>
                    <tr><td colspan="4" style="text-align: center;">No attendance records found yet.</td></tr>
                <% } else { %>
                    <% attendanceRecords.reverse().forEach(record => { %>
                        <% const myRecord = record.records.find(r => r.studentName === user.name); %>
                        <% if (myRecord) { %>
                            <tr>
                                <td><%= record.date %></td>
                                <td><%= record.subject %></td>
                                <td><%= record.timeSlot || ('Period ' + record.periodNumber) %></td>
                                <td class="<%= myRecord.status === 'Present' ? 'status-present' : 'status-absent' %>">
                                    <%= myRecord.status %>
                                </td>
                            </tr>
                        <% } %>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>