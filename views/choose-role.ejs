<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Choose Your Account — RKU Attendance</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<script>(function(){var t=localStorage.getItem('rku-theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
<style>
:root{
  --bg:#f0f4fa;--card:#fff;--border:#e2e8f0;--text:#1e293b;--muted:#64748b;
  --acc:#3b7ff4;--suc:#10b981;--dan:#ef4444;--war:#f59e0b;--pur:#8b5cf6;
  --shadow:0 8px 30px rgba(0,0,0,.08);
}
[data-theme="dark"]{
  --bg:#080d18;--card:#0f1624;--border:#1a2740;--text:#dde6f0;--muted:#6b7f97;
  --shadow:0 8px 30px rgba(0,0,0,.3);
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;}

.wrapper{width:100%;max-width:520px;}

.logo-area{text-align:center;margin-bottom:28px;}
.logo-circle{width:64px;height:64px;border-radius:18px;background:linear-gradient(135deg,var(--acc),#6366f1);display:inline-flex;align-items:center;justify-content:center;font-size:28px;color:#fff;margin-bottom:12px;box-shadow:0 6px 20px rgba(59,127,244,.35);}
.logo-title{font-size:1.2rem;font-weight:900;letter-spacing:-.3px;}
.logo-sub{font-size:13px;color:var(--muted);margin-top:3px;}

.card{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:32px;box-shadow:var(--shadow);}

.greeting{font-size:.82rem;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);font-weight:700;margin-bottom:4px;}
.username{font-size:1.25rem;font-weight:800;margin-bottom:4px;}
.useremail{font-size:12.5px;color:var(--muted);margin-bottom:24px;display:flex;align-items:center;gap:5px;}

.section-label{font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px;}

.role-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:22px;}

.role-card{
  position:relative;border:2px solid var(--border);border-radius:13px;padding:18px 14px 14px;
  cursor:pointer;transition:.2s;text-align:center;background:var(--card);
}
.role-card:hover{border-color:var(--acc);transform:translateY(-2px);box-shadow:0 6px 18px rgba(59,127,244,.12);}
.role-card input[type="radio"]{position:absolute;opacity:0;width:0;height:0;}
.role-card.selected{border-color:var(--acc);background:rgba(59,127,244,.05);}
.role-card.selected .rc-check{display:flex;}

.rc-icon{width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;margin:0 auto 10px;}
.rc-name{font-size:14px;font-weight:800;}
.rc-desc{font-size:11px;color:var(--muted);margin-top:3px;line-height:1.4;}
.rc-check{display:none;position:absolute;top:9px;right:9px;width:20px;height:20px;background:var(--acc);border-radius:50%;align-items:center;justify-content:center;color:#fff;font-size:10px;}

/* Role color schemes */
.ri-superadmin{background:rgba(139,92,246,.12);color:#8b5cf6;}
.ri-master{background:rgba(16,185,129,.12);color:#10b981;}
.ri-lecturer{background:rgba(245,158,11,.12);color:#f59e0b;}
.ri-leader{background:rgba(59,130,246,.12);color:#3b82f6;}
.ri-student{background:rgba(239,68,68,.1);color:#ef4444;}

.btn-enter{
  width:100%;padding:14px;background:linear-gradient(135deg,var(--acc),#6366f1);
  color:#fff;border:none;border-radius:11px;font-size:15px;font-weight:800;
  cursor:pointer;transition:.2s;display:flex;align-items:center;justify-content:center;gap:8px;
}
.btn-enter:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(59,127,244,.3);}
.btn-enter:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:none;}

.alt-link{text-align:center;margin-top:18px;font-size:13px;color:var(--muted);}
.alt-link a{color:var(--acc);text-decoration:none;font-weight:600;}
.alt-link a:hover{text-decoration:underline;}

.error-box{background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);color:var(--dan);border-radius:9px;padding:11px 14px;font-size:13px;display:flex;align-items:center;gap:8px;margin-bottom:18px;}

/* role descriptions */
.role-info{display:none;background:rgba(59,127,244,.04);border:1px solid rgba(59,127,244,.15);border-radius:9px;padding:12px 14px;font-size:13px;color:var(--muted);margin-bottom:14px;line-height:1.6;}
.role-info.show{display:block;}

@media(max-width:400px){.role-grid{grid-template-columns:1fr;}}
</style>
</head>
<body>
<div class="wrapper">
  <div class="logo-area">
    <div class="logo-circle"><i class="fas fa-clipboard-check"></i></div>
    <div class="logo-title">RKU Attendance</div>
    <div class="logo-sub">Choose how you want to sign in</div>
  </div>

  <div class="card">
    <div class="greeting">Welcome back</div>
    <div class="username"><%= user.name %></div>
    <div class="useremail"><i class="fas fa-envelope" style="opacity:.5;font-size:11px"></i> <%= user.email %></div>

    <% if(typeof error !== 'undefined' && error){ %>
    <div class="error-box"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>

    <div class="section-label">Your account has multiple roles — choose one to continue:</div>

    <form action="/choose-role" method="POST" id="roleForm">
      <div class="role-grid">
        <%
          var roleData = {
            'SuperAdmin': { icon: 'fas fa-shield-alt', colorClass: 'ri-superadmin', desc: 'Full system control' },
            'Master':     { icon: 'fas fa-user-tie',   colorClass: 'ri-master',     desc: 'Manage your division' },
            'Lecturer':   { icon: 'fas fa-chalkboard-teacher', colorClass: 'ri-lecturer', desc: 'View attendance records' },
            'Leader':     { icon: 'fas fa-user-check', colorClass: 'ri-leader',     desc: 'Take class attendance' },
            'Student':    { icon: 'fas fa-user-graduate', colorClass: 'ri-student', desc: 'View your attendance' }
          };
          roles.forEach(function(r, i){
            var rd = roleData[r] || { icon: 'fas fa-user', colorClass: 'ri-student', desc: '' };
        %>
        <label class="role-card <%= i === 0 ? 'selected' : '' %>" id="card-<%= r.toLowerCase() %>" onclick="selectRole('<%= r %>')">
          <input type="radio" name="selectedRole" value="<%= r %>" <%= i === 0 ? 'checked' : '' %>>
          <div class="rc-check"><i class="fas fa-check"></i></div>
          <div class="rc-icon <%= rd.colorClass %>"><i class="<%= rd.icon %>"></i></div>
          <div class="rc-name"><%= r %></div>
          <div class="rc-desc"><%= rd.desc %></div>
        </label>
        <% }); %>
      </div>

      <div class="role-info" id="roleInfo"></div>

      <button type="submit" class="btn-enter" id="enterBtn">
        <i class="fas fa-arrow-right"></i> Enter as <span id="btnRoleLabel"><%= roles[0] %></span>
      </button>
    </form>

    <div class="alt-link">
      Not you? <a href="/logout">Sign in with a different account</a>
    </div>
  </div>
</div>

<script>
var roleDescriptions = {
  'SuperAdmin': 'Full administrative control: manage all divisions, assign roles, view all records, configure the entire system.',
  'Master': 'Division management: approve users, manage subjects, view all attendance for your assigned division.',
  'Lecturer': 'Attendance view: review attendance records for sessions where you were the assigned lecturer.',
  'Leader': 'Attendance taking: mark student attendance for your division and lock the daily record.',
  'Student': 'Personal attendance: view your own attendance percentages subject-wise and overall.'
};

function selectRole(role) {
  // Unselect all
  document.querySelectorAll('.role-card').forEach(function(c){ c.classList.remove('selected'); });
  // Select clicked
  var card = document.getElementById('card-' + role.toLowerCase());
  if (card) card.classList.add('selected');
  // Check radio
  var radio = card && card.querySelector('input[type="radio"]');
  if (radio) radio.checked = true;
  // Update button label
  document.getElementById('btnRoleLabel').textContent = role;
  // Show role description
  var info = document.getElementById('roleInfo');
  if (roleDescriptions[role]) {
    info.textContent = '📋 ' + roleDescriptions[role];
    info.classList.add('show');
  } else {
    info.classList.remove('show');
  }
}

// Init description for first role
document.addEventListener('DOMContentLoaded', function() {
  var checked = document.querySelector('input[type="radio"]:checked');
  if (checked) selectRole(checked.value);
});
</script>
</body>
</html>
