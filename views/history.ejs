<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Attendance History — RKU</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<script>(function(){var t=localStorage.getItem("rku-theme")||"light";document.documentElement.setAttribute("data-theme",t);})();</script>
<style>
:root{
  --pri:#05091a;--pri2:#0d1535;--acc:#4f7ef7;--acc2:#6366f1;
  --suc:#059669;--dan:#dc2626;--war:#d97706;
  --bg:#f1f5fb;--card:#fff;--border:#e4eaf3;
  --text:#0f172a;--muted:#64748b;--input-bg:#f8fafc;--input-bd:#cbd5e1;
  --sh:0 1px 3px rgba(0,0,0,.05),0 4px 16px rgba(0,0,0,.06);
  --sh2:0 8px 30px rgba(0,0,0,.1);--r:16px;--rs:10px;
}
[data-theme="dark"]{
  --bg:#060b17;--card:#0c1426;--border:#162236;
  --text:#dde6f4;--muted:#6b7f97;--input-bg:#09111f;--input-bd:#1e3050;
  --sh:0 1px 3px rgba(0,0,0,.3),0 4px 16px rgba(0,0,0,.3);
  --acc:#6390f5;--suc:#34d399;--dan:#f87171;--war:#fbbf24;
}
*{box-sizing:border-box;margin:0;padding:0;}
html,body{transition:background .2s,color .2s;}
body{font-family:"Segoe UI",system-ui,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;padding:20px 16px;}
.page{max-width:1080px;margin:0 auto;}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;}
.back-btn{display:inline-flex;align-items:center;gap:8px;background:var(--card);border:1.5px solid var(--border);color:var(--text);text-decoration:none;padding:9px 16px;border-radius:var(--rs);font-weight:700;font-size:13px;box-shadow:var(--sh);transition:.18s;}
.back-btn:hover{border-color:var(--acc);color:var(--acc);}
.page-title{font-size:1.4rem;font-weight:900;letter-spacing:-.3px;}
.page-title span{color:var(--acc);}
.topbar-right{display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
.btn-icon{background:var(--card);border:1.5px solid var(--border);color:var(--muted);padding:9px 12px;border-radius:var(--rs);cursor:pointer;font-size:15px;transition:.18s;display:inline-flex;align-items:center;}
.btn-icon:hover{border-color:var(--acc);color:var(--acc);}
.filter-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:22px;box-shadow:var(--sh);margin-bottom:22px;}
.filter-card h4{font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);margin-bottom:14px;}
.filter-row{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;}
.fg{display:flex;flex-direction:column;gap:5px;flex:1;min-width:140px;}
.fg label{font-size:11.5px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;}
.fc{width:100%;padding:10px 13px;border-radius:var(--rs);border:1.5px solid var(--input-bd);font-size:13.5px;font-family:inherit;background:var(--input-bg);color:var(--text);outline:none;transition:.18s;}
.fc:focus{border-color:var(--acc);box-shadow:0 0 0 3px rgba(79,126,247,.12);}
.btn{display:inline-flex;align-items:center;gap:7px;padding:10px 20px;border:none;border-radius:var(--rs);font-size:13.5px;font-weight:700;cursor:pointer;transition:.18s;text-decoration:none;white-space:nowrap;font-family:inherit;}
.btn:hover{opacity:.88;transform:translateY(-1px);}
.btn-acc{background:linear-gradient(135deg,var(--acc),var(--acc2));color:#fff;box-shadow:0 4px 14px rgba(79,126,247,.25);}
.btn-ghost{background:var(--card);color:var(--muted);border:1.5px solid var(--border);}
.btn-ghost:hover{border-color:var(--acc);color:var(--acc);}
.stats-row{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:22px;}
.stat-pill{display:flex;align-items:center;gap:14px;background:var(--card);border:1px solid var(--border);border-left:4px solid var(--acc);padding:16px 20px;border-radius:var(--rs);box-shadow:var(--sh);flex:1;min-width:140px;}
.stat-pill.green{border-left-color:var(--suc);}
.stat-pill.red{border-left-color:var(--dan);}
.stat-pill .stat-val{font-size:1.6rem;font-weight:800;color:var(--acc);line-height:1;}
.stat-pill.green .stat-val{color:var(--suc);}
.stat-pill.red .stat-val{color:var(--dan);}
.stat-pill small{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;font-weight:600;}
.table-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);box-shadow:var(--sh);overflow:hidden;}
.tbl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;}
table{width:100%;border-collapse:collapse;}
thead th{background:linear-gradient(135deg,var(--pri),var(--pri2));color:#fff;padding:13px 16px;font-size:11.5px;text-transform:uppercase;letter-spacing:.5px;text-align:left;white-space:nowrap;}
tbody td{padding:13px 16px;border-bottom:1px solid var(--border);font-size:13.5px;vertical-align:middle;}
tbody tr:last-child td{border-bottom:none;}
tbody tr:hover td{background:rgba(79,126,247,.03);}
.sp{padding:4px 11px;border-radius:20px;font-size:11.5px;font-weight:700;display:inline-flex;align-items:center;gap:5px;}
.sp-present{background:rgba(5,150,105,.1);color:var(--suc);border:1px solid rgba(5,150,105,.2);}
.sp-absent{background:rgba(220,38,38,.08);color:var(--dan);border:1px solid rgba(220,38,38,.18);}
.sp-na{background:rgba(100,116,139,.1);color:var(--muted);border:1px solid var(--border);}
.pct-wrap{display:flex;align-items:center;gap:8px;min-width:120px;}
.pct-bar{flex:1;height:6px;background:var(--border);border-radius:3px;overflow:hidden;}
.pct-fill{height:100%;background:var(--suc);border-radius:3px;}
.pct-fill.warn{background:var(--war);}
.pct-fill.bad{background:var(--dan);}
.pct-num{font-weight:700;font-size:12px;color:var(--muted);min-width:36px;text-align:right;}
.empty-state{text-align:center;padding:60px 20px;color:var(--muted);}
.empty-state i{font-size:2.5rem;opacity:.25;display:block;margin-bottom:14px;}
.subj-tag{font-weight:700;color:var(--text);}
.time-tag{font-size:12px;color:var(--muted);margin-top:2px;}
@media print{.no-print{display:none!important;}body{background:#fff;color:#000;}.table-card{box-shadow:none;}}
@media(max-width:600px){body{padding:14px 12px;}.page-title{font-size:1.1rem;}.filter-row{flex-direction:column;}.filter-row .fg{min-width:unset;}.stats-row{gap:8px;}.stat-pill{min-width:unset;flex:1 1 45%;}}
</style>
</head>
<body>
<div class="page">
  <div class="topbar">
    <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
      <%
        var _hBackPath = {
          "superadmin": "/super-admin-dashboard", "master": "/master",
          "lecturer": "/lecturer", "leader": "/leader", "student": "/student"
        }[(user.role||"").toLowerCase()] || "/login";
      %>
      <a href="<%= _hBackPath %>" class="back-btn"><i class="fas fa-arrow-left"></i> Dashboard</a>
      <h1 class="page-title"><i class="fas fa-history" style="color:var(--acc);margin-right:8px;"></i>Attendance <span>History</span></h1>
    </div>
    <div class="topbar-right no-print">
      <button class="btn-icon" id="themeToggle" title="Toggle theme"><i class="fas fa-moon" id="themeIcon"></i></button>
      <button class="btn btn-ghost" onclick="window.print()"><i class="fas fa-print"></i> Print</button>
    </div>
  </div>

  <div class="filter-card no-print">
    <h4><i class="fas fa-filter"></i> &nbsp;Filter Records</h4>
    <form action="/attendance-history" method="GET" class="filter-row">
      <div class="fg"><label>From Date</label><input type="date" name="startDate" class="fc" value="<%= startDate %>" required></div>
      <div class="fg"><label>To Date</label><input type="date" name="endDate" class="fc" value="<%= endDate %>" required></div>
      <div style="align-self:flex-end;"><button type="submit" class="btn btn-acc"><i class="fas fa-search"></i> Apply Filter</button></div>
    </form>
  </div>

  <div class="stats-row">
    <div class="stat-pill">
      <div><div class="stat-val"><%= records.length %></div><small>Records Found</small></div>
    </div>
    <% if (user.role === "Student") {
      var pCount = 0;
      records.forEach(function(r){ var me = r.students.find(function(s){ return s.studentId === user.rollNo; }); if(me && me.status === "Present") pCount++; });
      var sPct = records.length > 0 ? ((pCount/records.length)*100) : 0;
    %>
    <div class="stat-pill green"><div><div class="stat-val"><%= pCount %></div><small>Present</small></div></div>
    <div class="stat-pill <%= sPct >= 75 ? "green" : sPct >= 60 ? "" : "red" %>">
      <div><div class="stat-val"><%= sPct.toFixed(1) %>%</div><small>Attendance Rate</small></div>
    </div>
    <% } %>
    <% if (user.role !== "Student" && records.length > 0) {
      var totalPresent = 0, totalStudents = 0;
      records.forEach(function(r){ totalPresent += (r.students||[]).filter(function(s){ return s.status==="Present"; }).length; totalStudents += (r.students||[]).length; });
    %>
    <div class="stat-pill green"><div><div class="stat-val"><%= totalPresent %></div><small>Total Present</small></div></div>
    <% } %>
  </div>

  <div class="table-card">
    <div class="tbl-wrap"><table>
      <thead><tr>
        <th><i class="far fa-calendar-alt"></i> Date</th>
        <th><i class="fas fa-book"></i> Subject</th>
        <th><i class="far fa-clock"></i> Time Slot</th>
        <th><%= user.role === "Student" ? "Your Status" : "Strength" %></th>
        <% if(user.role !== "Student"){ %><th>Rate</th><% } %>
      </tr></thead>
      <tbody>
        <% if (records && records.length > 0) { %>
        <% records.forEach(function(rec){ var presentCnt = (rec.students||[]).filter(function(s){ return s.status==="Present"; }).length; var totalCnt = (rec.students||[]).length; var recPct = totalCnt > 0 ? (presentCnt/totalCnt)*100 : 0; %>
        <tr>
          <td><strong style="font-variant-numeric:tabular-nums;"><%= rec.date %></strong></td>
          <td><div class="subj-tag"><%= rec.subject || "—" %></div><% if(rec.section){ %><div class="time-tag"><i class="fas fa-layer-group" style="opacity:.6;"></i> <%= rec.section %></div><% } %></td>
          <td><span style="color:var(--muted);font-size:12.5px;"><i class="far fa-clock" style="opacity:.6;"></i> <%= rec.manualTime || "—" %></span></td>
          <td>
            <% if (user.role === "Student") { var me = (rec.students||[]).find(function(s){ return s.studentId === user.rollNo; }); var st = me ? me.status : "N-A"; %>
            <span class="sp sp-<%= st==="Present"?"present":st==="Absent"?"absent":"na" %>">
              <% if(st==="Present"){ %><i class="fas fa-check-circle"></i><% } %>
              <% if(st==="Absent"){ %><i class="fas fa-times-circle"></i><% } %>
              <%= me ? me.status : "Not Marked" %>
            </span>
            <% } else { %>
            <span style="font-weight:700;"><%= presentCnt %> / <%= totalCnt %></span><span style="font-size:12px;color:var(--muted);"> present</span>
            <% } %>
          </td>
          <% if(user.role !== "Student"){ %>
          <td><div class="pct-wrap"><div class="pct-bar"><div class="pct-fill <%= recPct>=75?"":recPct>=60?"warn":"bad" %>" style="width:<%= recPct.toFixed(0) %>%;"></div></div><span class="pct-num"><%= recPct.toFixed(0) %>%</span></div></td>
          <% } %>
        </tr>
        <% }); %>
        <% } else { %>
        <tr><td colspan="<%= user.role === "Student" ? 4 : 5 %>"><div class="empty-state"><i class="fas fa-search"></i><p>No records found for the selected date range.</p></div></td></tr>
        <% } %>
      </tbody>
    </table></div>
  </div>
</div>

<script>
(function(){
  function setTheme(t){document.documentElement.setAttribute("data-theme",t);localStorage.setItem("rku-theme",t);var icon=document.getElementById("themeIcon");if(icon)icon.className=t==="dark"?"fas fa-sun":"fas fa-moon";}
  function syncTheme(){var t=document.documentElement.getAttribute("data-theme")||"light";var icon=document.getElementById("themeIcon");if(icon)icon.className=t==="dark"?"fas fa-sun":"fas fa-moon";}
  document.addEventListener("DOMContentLoaded",function(){syncTheme();var tog=document.getElementById("themeToggle");if(tog)tog.addEventListener("click",function(){var cur=document.documentElement.getAttribute("data-theme")||"light";setTheme(cur==="dark"?"light":"dark");});});
  if(document.readyState!=="loading")syncTheme();
})();
</script>
</body>
</html>