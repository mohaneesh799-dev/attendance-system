<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RKU Attendance Portal | Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --rku-blue: #003366; --google-blue: #4285F4; --dark-bg: #1a1d20; }
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh; display: flex; align-items: center; justify-content: center;
            font-family: 'Inter', 'Segoe UI', sans-serif;
        }
        .login-card {
            background: white; padding: 45px; border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            width: 100%; max-width: 420px; text-align: center;
        }
        .logo-placeholder { font-size: 2.5rem; color: var(--rku-blue); margin-bottom: 10px; }
        .btn-sso {
            display: flex; align-items: center; justify-content: center;
            background-color: var(--google-blue); color: white; padding: 14px;
            text-decoration: none; border-radius: 10px; font-weight: 600;
            margin-bottom: 15px; transition: 0.3s; border: none; width: 100%;
        }
        .btn-sso:hover { background-color: #357ae8; color: white; transform: translateY(-2px); }
        .btn-credential {
            display: flex; align-items: center; justify-content: center;
            background-color: var(--dark-bg); color: white; padding: 14px;
            text-decoration: none; border-radius: 10px; font-weight: 600;
            width: 100%; transition: 0.3s; border: none; cursor: pointer;
        }
        .btn-credential:hover { background-color: #000; color: #ffc107; transform: translateY(-2px); }
        .divider { display: flex; align-items: center; text-align: center; margin: 20px 0; color: #adb5bd; }
        .divider::before, .divider::after { content: ''; flex: 1; border-bottom: 1px solid #dee2e6; }
        .divider:not(:empty)::before { margin-right: .5em; }
        .divider:not(:empty)::after { margin-left: .5em; }
        .footer-text { font-size: 0.85rem; color: #6c757d; margin-top: 20px; }
        .alert { border-radius: 10px; border: none; }
        .form-control:focus { border-color: var(--rku-blue); box-shadow: 0 0 0 3px rgba(0,51,102,0.15); }
    </style>
</head>
<body>
<div class="login-card">
    <div class="logo-placeholder"><i class="fas fa-university"></i></div>
    <h2 class="fw-bold mb-1">RKU Attendance</h2>
    <p class="text-muted mb-4 small">Secure Gateway for Students &amp; Faculty</p>

    <%# FIX: Errors/messages shown via EJS rendering, not alert() popups %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger small py-2 mb-3">
            <i class="fas fa-exclamation-circle me-1"></i> <%= error %>
        </div>
    <% } %>
    <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert alert-success small py-2 mb-3">
            <i class="fas fa-check-circle me-1"></i> <%= message %>
        </div>
    <% } %>

    <% if (typeof showEmailForm !== 'undefined' && showEmailForm) { %>
        <%# FIX: Credential login form was missing — only a broken link existed before %>
        <form action="/login" method="POST" novalidate>
            <div class="mb-3 text-start">
                <label class="form-label small fw-bold">Email Address</label>
                <input type="email" name="email" class="form-control" placeholder="you@rku.ac.in" required autocomplete="email">
            </div>
            <div class="mb-3 text-start">
                <label class="form-label small fw-bold">Password</label>
                <input type="password" name="password" class="form-control" placeholder="••••••••" required autocomplete="current-password">
            </div>
            <button type="submit" class="btn-credential">
                <i class="fas fa-sign-in-alt me-2 text-warning"></i> Login
            </button>
        </form>
        <div class="footer-text mt-3">
            <a href="/login" class="text-secondary text-decoration-none small">← Back to main login</a>
        </div>
    <% } else { %>
        <a href="/auth/google" class="btn-sso">
            <img src="https://upload.wikimedia.org/wikipedia/commons/5/53/Google_%22G%22_Logo.svg" width="18" height="18" class="me-2 bg-white rounded-circle p-1" alt="Google">
            Sign in with Google
        </a>

        <div class="divider">OR</div>

        <a href="/login-email" class="btn-credential">
            <i class="fas fa-key me-2 text-warning"></i> Admin / Faculty Login
        </a>

        <div class="footer-text">
            Don't have an account?<br>
            <a href="/register" class="text-primary text-decoration-none fw-bold">Create Request</a>
            &nbsp;·&nbsp;
            <a href="/register" class="text-secondary text-decoration-none">SuperAdmin</a>
        </div>

        <p class="small text-secondary mt-4 mb-0" style="font-size: 0.75rem;">
            <i class="fas fa-shield-alt"></i> Strictly authorized for <strong>@rku.ac.in</strong> users only.
        </p>
    <% } %>
</div>
</body>
</html>
