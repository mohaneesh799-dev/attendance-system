    ];

    var THEMES = { warrior: WARRIOR_STAGES, bloom: BLOOM_STAGES };

    function getStage(pct, stages) {
        for (var i = stages.length - 1; i >= 0; i--) {
            if (pct >= stages[i].min) return { stage: stages[i], idx: i };
        }
        return { stage: stages[0], idx: 0 };
    }

    function renderCharacter(theme) {
        var stages = THEMES[theme] || WARRIOR_STAGES;
        var result = getStage(PCT, stages);
        var stage  = result.stage;
        var idx    = result.idx;
        var total  = stages.length;

        /* SVG */
        document.getElementById('charSvg').innerHTML = stage.svg;

        /* Animation class */
        var svgEl = document.getElementById('charSvg');
        svgEl.className.baseVal = 'char-svg ' + stage.anim;

        /* Hero info */
        document.getElementById('heroName').textContent     = stage.name;
        document.getElementById('heroSub').textContent      = stage.sub;
        document.getElementById('heroQuoteText').textContent = stage.quote;
        document.getElementById('heroTitleText').textContent = stage.titleText;
        document.getElementById('heroTitleIcon').className   = 'fas ' + stage.icon;
        document.getElementById('heroTitleIcon').style.color = stage.color;

        /* Level bar — fill within current level */
        var lvlMin = stage.min;
        var lvlMax = stage.max;
        var fillPct = (PCT - lvlMin) / (lvlMax - lvlMin) * 100;
        fillPct = Math.min(100, Math.max(0, fillPct));
        var fill = document.getElementById('levelFill');
        fill.style.background = 'linear-gradient(90deg,' + stage.fillColor + ',' + stage.color + ')';
        setTimeout(function(){ fill.style.width = fillPct + '%'; }, 200);
        document.getElementById('levelLeft').textContent = 'Level ' + (idx + 1) + ' / ' + total;

        /* Stage pips */
        var pips = document.getElementById('stagePips');
        pips.innerHTML = '';
        for (var j = 0; j < stages.length; j++) {
            var s = stages[j];
            var pip = document.createElement('div');
            pip.className = 'stage-pip' + (j <= idx ? ' done' : '') + (j === idx ? ' current' : '');
            pip.style.color = j <= idx ? s.color : 'var(--muted)';
            pip.innerHTML = '<div class="sp-dot" style="background:' + (j <= idx ? s.color : 'var(--border)') + '"></div>' +
                            '<span class="sp-lbl">' + s.min + '%</span>';
            pips.appendChild(pip);
        }

        /* Particles */
        startParticles(stage.particles);
    }

    /* ── Particle System (Canvas) ── */
    var particleInterval = null;
    function startParticles(colors) {
        var canvas = document.getElementById('particleCanvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (particleInterval) clearInterval(particleInterval);
        if (!colors || !colors.length) { ctx.clearRect(0,0,canvas.width,canvas.height); return; }
        var particles = [];
        function spawn() {
            if (particles.length > 18) return;
            particles.push({
                x: 30 + Math.random() * 60,
                y: canvas.height - 10,
                vx: (Math.random() - 0.5) * 1.2,
                vy: -(1.2 + Math.random() * 2),
                r:  2 + Math.random() * 3,
                color: colors[Math.floor(Math.random() * colors.length)],
                life: 1,
                decay: 0.012 + Math.random() * 0.015
            });
        }
        function tick() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            if (Math.random() < 0.35) spawn();
            particles = particles.filter(function(p) { return p.life > 0; });
            particles.forEach(function(p) {
                p.x += p.vx; p.y += p.vy; p.life -= p.decay;
                ctx.save();
                ctx.globalAlpha = p.life;
                ctx.fillStyle = p.color;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });
        }
        particleInterval = setInterval(tick, 40);
    }

    /* ── Init ── */
    document.addEventListener('DOMContentLoaded', function() {
        var theme = localStorage.getItem('rku-avatar-theme') || 'warrior';
        renderCharacter(theme);
    });

})();
</script>
