<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Leader Dashboard - Attendance</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <h1>Leader Dashboard</h1>
        <p>Welcome, <%= user.name %></p>

        <form action="/lock-attendance" method="POST">
            <h3>Step 1: Select Lecturer & Period</h3>
            <div class="form-group">
                <label>Assign to Lecturer:</label>
                <select name="lecturerId" required>
                    <% allUsers.filter(u => u.role === 'Lecturer').forEach(lecturer => { %>
                        <option value="<%= lecturer._id %>"><%= lecturer.name %></option>
                    <% }); %>
                </select>
            </div>

            <div class="form-group">
                <label>Period/Subject:</label>
                <input type="text" name="subject" placeholder="e.g. Mathematics" required>
            </div>

            <hr>

            <h3>Step 2: Mark Student Attendance</h3>
            <table border="1" style="width:100%; border-collapse: collapse;">
                <thead>
                    <tr>
                        <th>Student Name</th>
                        <th>Present?</th>
                    </tr>
                </thead>
                <tbody>
                    <% allUsers.filter(u => u.role === 'Student').forEach((student, index) => { %>
                        <tr>
                            <td>
                                <%= student.name %>
                                <input type="hidden" name="attendance[<%= index %>][studentId]" value="<%= student._id %>">
                                <input type="hidden" name="attendance[<%= index %>][studentName]" value="<%= student.name %>">
                            </td>
                            <td>
                                <input type="checkbox" name="attendance[<%= index %>][status]" value="Present" checked>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>

            <br>
            <button type="submit" style="background-color: #d9534f; color: white; padding: 10px;">
                Lock Attendance & Send to Lecturer
            </button>
        </form>
    </div>
</body>
</html>