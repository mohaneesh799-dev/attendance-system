<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Master Dashboard - Attendance System</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        :root { --primary: #2c3e50; --accent: #3498db; --danger: #e74c3c; --success: #2ecc71; }
        body { font-family: 'Segoe UI', sans-serif; background: #f4f7f6; margin: 0; display: flex; }
        .sidebar { width: 260px; background: var(--primary); color: white; height: 100vh; padding: 20px; position: fixed; }
        .main { margin-left: 300px; padding: 40px; width: calc(100% - 340px); }
        .card { background: white; padding: 25px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 30px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #eee; }
        .btn { padding: 8px 15px; border-radius: 5px; border: none; cursor: pointer; color: white; font-weight: bold; }
        .status-badge { padding: 5px 10px; border-radius: 20px; font-size: 12px; }
    </style>
</head>
<body>

<div class="sidebar">
    <h2>Admin Panel</h2>
    <p>Welcome, <strong><%= user.name %></strong></p>
    <hr>
    <a href="/logout" style="color: #ff7675; text-decoration: none;">Logout</a>
</div>

<div class="main">
    <h1>Master Dashboard</h1>

    <div class="card">
        <h3>User Management</h3>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% allUsers.forEach(u => { if(u.role !== 'Master') { %>
                <tr>
                    <td><%= u.name %></td>
                    <td><%= u.email %></td>
                    <td><%= u.role %></td>
                    <td><span class="status-badge" style="background:#d4edda; color:#155724;"><%= u.isApproved ? 'Approved' : 'Pending' %></span></td>
                    <td>
                        <form action="/delete-user/<%= u._id %>" method="POST" onsubmit="return confirm('Delete user?')">
                            <button class="btn" style="background: var(--danger);">Delete</button>
                        </form>
                    </td>
                </tr>
                <% } }) %>
            </tbody>
        </table>
    </div>

    <div class="card">
        <h3>Bulk User Upload (CSV)</h3>
        <form action="/upload-users" method="POST" enctype="multipart/form-data">
            <input type="file" name="csvFile" accept=".csv" required style="margin-bottom: 10px;">
            <button type="submit" class="btn" style="background: var(--accent);">Upload CSV File</button>
        </form>
    </div>

    <div class="card">
        <h3>Subject Management</h3>
        <form action="/add-subject" method="POST" style="display:flex; gap:10px;">
            <input type="text" name="name" placeholder="New Subject Name" required style="flex:1; padding:10px; border:1px solid #ddd;">
            <button type="submit" class="btn" style="background: var(--primary);">Add Subject</button>
        </form>

        <table>
            <thead>
                <tr>
                    <th>Subject Name</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% masterSubjects.forEach(sub => { if(sub.name && sub.name.trim() !== "") { %>
                <tr>
                    <td><%= sub.name %></td>
                    <td>
                        <form action="/delete-subject/<%= sub._id %>" method="POST">
                            <button class="btn" style="background: var(--danger);">Remove</button>
                        </form>
                    </td>
                </tr>
                <% } }) %>
            </tbody>
        </table>
    </div>
</div>

</body>
</html>