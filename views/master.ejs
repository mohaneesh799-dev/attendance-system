<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user.section %> - Master Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --sidebar-width: 260px; --primary: #1a2a3a; --danger: #ff4757; --success: #2ed573; --accent: #1e90ff; --bg: #f1f2f6; --warning: #fed330; }
        body { display: flex; font-family: 'Inter', sans-serif; margin: 0; background: var(--bg); color: #2f3542; }
        .sidebar { width: var(--sidebar-width); background: var(--primary); color: white; height: 100vh; padding: 25px; position: fixed; box-shadow: 4px 0 10px rgba(0,0,0,0.1); z-index: 100; }
        .sidebar h2 { font-weight: 800; letter-spacing: 1px; color: var(--accent); margin-bottom: 30px; display: flex; align-items: center; gap: 10px; }
        .sidebar a { color: #a4b0be; text-decoration: none; display: flex; align-items: center; gap: 12px; padding: 14px; border-radius: 8px; margin-bottom: 8px; transition: 0.3s; }
        .sidebar a:hover, .sidebar a.active { background: rgba(255,255,255,0.1); color: white; }
        
        .main-content { margin-left: var(--sidebar-width); padding: 40px; width: calc(100% - var(--sidebar-width)); }
        
        .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: white; padding: 20px; border-radius: 12px; display: flex; align-items: center; gap: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        .stat-icon { font-size: 2rem; color: var(--accent); background: rgba(30, 144, 255, 0.1); padding: 15px; border-radius: 10px; }
        
        .card { background: white; padding: 25px; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); margin-bottom: 30px; border: 1px solid rgba(0,0,0,0.05); }
        
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: 15px; background: #f8f9fa; font-size: 0.85rem; text-transform: uppercase; color: #747d8c; }
        td { padding: 15px; border-bottom: 1px solid #f1f2f6; }
        
        .badge { padding: 6px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; text-transform: uppercase; }
        .Student { background: #e3f2fd; color: #1e90ff; }
        .Lecturer { background: #e8f5e9; color: #2ed573; }
        .Leader { background: #fff3e0; color: #ffa502; }
        .pending-tag { background: var(--warning); color: #333; }

        .btn { padding: 10px 18px; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; transition: 0.2s; display: inline-flex; align-items: center; gap: 8px; font-size: 14px; }
        .btn-approve { background: var(--success); color: white; }
        .btn-delete { background: #ffeef0; color: var(--danger); }
        .btn-accent { background: var(--accent); color: white; }
        
        .bulk-action-bar { position: sticky; top: 0; background: #f8f9fa; padding: 15px; border-radius: 10px; display: flex; gap: 15px; align-items: center; margin-bottom: 15px; border: 1px solid #ddd; z-index: 10; }
        input[type="text"], select { padding: 10px; border-radius: 8px; border: 1px solid #ddd; outline: none; }
        input[type="text"]:focus { border-color: var(--accent); }
    </style>
</head>
<body>

<div class="sidebar">
    <h2><i class="fas fa-shield-alt"></i> MASTER</h2>
    <div style="background: rgba(255,255,255,0.05); padding: 15px; border-radius: 10px; margin-bottom: 25px;">
        <small style="color: #747d8c; display: block;">Authorized Faculty</small>
        <strong style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block;"><%= user.name %></strong>
        <div style="margin-top: 5px;"><span class="badge" style="background: var(--accent); color: white;"><%= user.section %></span></div>
    </div>
    <nav>
        <a href="/master" class="active"><i class="fas fa-th-large"></i> Dashboard</a>
        <a href="/attendance-history"><i class="fas fa-history"></i> History</a>
        <a href="/export-attendance" style="color: #2ed573;"><i class="fas fa-file-excel"></i> Export CSV</a><!-- FIXED: was /export-attendance-full which doesn't exist -->
        <a href="/logout" style="margin-top: 40px; color: var(--danger);"><i class="fas fa-power-off"></i> Logout</a>
    </nav>
</div>

<div class="main-content">
    <header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <div>
            <h1 style="margin:0;">Section Command Center</h1>
            <p style="color: #747d8c; margin: 5px 0 0 0;">Managing all records for <strong><%= user.section %></strong></p>
        </div>
        <div id="clock" style="font-weight: 700; color: var(--primary); font-size: 1.2rem; font-variant-numeric: tabular-nums;"></div>
    </header>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-users"></i></div>
            <div><small>Total Users</small><h2><%= stats.total %></h2></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="color: var(--danger); background: rgba(255, 71, 87, 0.1);"><i class="fas fa-user-clock"></i></div>
            <div><small>Pending Approval</small><h2><%= stats.pending %></h2></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="color: var(--success); background: rgba(46, 213, 115, 0.1);"><i class="fas fa-book-open"></i></div>
            <div><small>Subjects</small><h2><%= stats.subjects %></h2></div>
        </div>
    </div>

    <div class="card">
        <h3><i class="fas fa-book"></i> Subject Management</h3>
        <form action="/add-subject" method="POST" style="display: flex; gap: 10px; margin-bottom: 20px;">
            <input type="hidden" name="section" value="<%= user.section %>">
            <input type="text" name="subjectName" placeholder="New Subject Name (e.g. Mathematics)" required style="flex:1;">
            <button type="submit" class="btn btn-accent"><i class="fas fa-plus"></i> Add Subject</button>
        </form>
        
        <% if (masterSubjects && masterSubjects.length > 0) { %>
            <table>
                <% masterSubjects.forEach(sub => { %>
                    <tr>
                        <td><strong><%= sub.name %></strong></td>
                        <td style="text-align: right;">
                            <form action="/delete-subject/<%= sub._id %>" method="POST" style="display: inline;">
                                <button type="submit" class="btn btn-delete" onclick="return confirm('Delete this subject?')">
                                    <i class="fas fa-times"></i> Remove
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </table>
        <% } else { %>
            <p style="text-align: center; color: #747d8c; padding: 20px;">No subjects added yet.</p>
        <% } %>
    </div>

    <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3>User Management</h3>
            <div style="width: 300px; position: relative;">
                <i class="fas fa-search" style="position: absolute; left: 12px; top: 12px; color: #ccc;"></i>
                <input type="text" id="userSearch" placeholder="Search by name or email..." onkeyup="filterUsers()" style="width: 100%; padding-left: 35px;">
            </div>
        </div>

        <form action="/bulk-approve" method="POST">
            <input type="hidden" name="section" value="<%= user.section %>">
            
            <div class="bulk-action-bar">
                <input type="checkbox" id="selectAll" style="transform: scale(1.2); cursor: pointer;"> 
                <label for="selectAll" style="cursor: pointer;"><strong>Select All</strong></label>
                
                <div style="flex: 1;"></div> <select name="targetRole" required style="min-width: 150px;">
                    <option value="" disabled selected>Assign Role...</option>
                    <option value="Student">Student</option>
                    <option value="Leader">Leader</option>
                    <option value="Lecturer">Lecturer</option>
                </select>
                <button type="submit" class="btn btn-approve">
                    <i class="fas fa-user-check"></i> Bulk Update & Approve
                </button>
            </div>

            <table id="userTable">
                <thead>
                    <tr>
                        <th width="40px"></th>
                        <th>User Details</th>
                        <th>Role & Status</th>
                        <th style="text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (allUsers && allUsers.length > 0) { %>
                        <% allUsers.forEach(u => { %>
                            <tr>
                                <td><input type="checkbox" name="userIds[]" value="<%= u._id %>" class="user-checkbox"></td>
                                <td>
                                    <strong><%= u.name %></strong>
                                    <div style="font-size: 0.8rem; color: #747d8c;"><%= u.email %></div>
                                </td>
                                <td>
                                    <span class="badge <%= u.role %>"><%= u.role || 'Unassigned' %></span>
                                    <% if(u.isApproved) { %>
                                        <span style="color: var(--success); font-size: 0.8rem; margin-left: 10px;">
                                            <i class="fas fa-check-circle"></i> Active
                                        </span>
                                    <% } else { %>
                                        <span class="badge pending-tag">Pending</span>
                                    <% } %>
                                </td>
                                <td style="text-align: center;">
                                    <form action="/delete-user/<%= u._id %>" method="POST" onsubmit="return confirm('Permanently delete this user?')">
                                        <button class="btn btn-delete" title="Delete User">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" style="text-align: center; padding: 40px; color: #747d8c;">
                                <i class="fas fa-user-slash" style="font-size: 2rem; display: block; margin-bottom: 10px;"></i>
                                No users found in this section.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </form>
    </div>

    <div class="card" style="border: 2px dashed var(--accent); background: rgba(30, 144, 255, 0.02);">
        <h3><i class="fas fa-file-import"></i> Bulk Student Import (CSV)</h3>
        <p style="color: #747d8c; font-size: 0.9rem;">
            Quickly add multiple students. The CSV must have headers: <code>name, email, studentId</code>
        </p>
        <form action="/upload-users" method="POST" enctype="multipart/form-data" style="display: flex; gap: 15px; align-items: center; margin-top: 15px;">
            <input type="hidden" name="section" value="<%= user.section %>">
            <input type="file" name="csvFile" accept=".csv" required style="flex: 1; padding: 12px; background: white; border-radius: 8px; border: 1px solid #ddd;">
            <button type="submit" class="btn btn-accent"><i class="fas fa-upload"></i> Upload & Auto-Approve</button>
        </form>
    </div>
</div>

<script>
    // Real-time Search
    function filterUsers() {
        let input = document.getElementById('userSearch').value.toLowerCase();
        let rows = document.querySelector('#userTable tbody').getElementsByTagName('tr');
        for (let i = 0; i < rows.length; i++) {
            let text = rows[i].textContent.toLowerCase();
            rows[i].style.display = text.includes(input) ? "" : "none";
        }
    }

    // Toggle All Checkboxes
    document.getElementById('selectAll').addEventListener('change', function() {
        document.querySelectorAll('.user-checkbox').forEach(cb => {
            // Only toggle visible rows (so search works with select all)
            if(cb.closest('tr').style.display !== 'none') {
                cb.checked = this.checked;
            }
        });
    });

    // Dynamic Clock
    function updateClock() {
        const now = new Date();
        document.getElementById('clock').innerText = now.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit', second:'2-digit'});
    }
    setInterval(updateClock, 1000);
    updateClock();
</script>
</body>
</html>