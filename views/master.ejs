<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= user.section %> — Master Dashboard</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<script>(function(){var t=localStorage.getItem('rku-theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
<style>
:root{
  --sb-w:264px;--pri:#05091a;--pri2:#0d1535;--acc:#4f7ef7;--acc2:#6366f1;
  --suc:#059669;--dan:#dc2626;--war:#d97706;--pur:#7c3aed;
  --bg:#f1f5fb;--card:#fff;--border:#e4eaf3;
  --text:#0f172a;--muted:#64748b;--input-bg:#f8fafc;--input-bd:#cbd5e1;
  --sh:0 1px 3px rgba(0,0,0,.05),0 4px 16px rgba(0,0,0,.06);
  --sh2:0 8px 30px rgba(0,0,0,.1);--r:16px;--rs:10px;
}
[data-theme="dark"]{
  --bg:#060b17;--card:#0c1426;--border:#162236;
  --text:#dde6f4;--muted:#6b7f97;--input-bg:#09111f;--input-bd:#1e3050;
  --sh:0 1px 3px rgba(0,0,0,.3),0 4px 16px rgba(0,0,0,.3);
  --sh2:0 8px 30px rgba(0,0,0,.4);
  --acc:#6390f5;--suc:#34d399;--dan:#f87171;--war:#fbbf24;--pur:#a78bfa;
}
*{box-sizing:border-box;margin:0;padding:0;}
html,body{transition:background .2s,color .2s;}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);display:flex;min-height:100vh;}
.sidebar{width:var(--sb-w);background:linear-gradient(175deg,#05091a 0%,#0e1840 55%,#1a1045 100%);height:100vh;position:fixed;top:0;left:0;display:flex;flex-direction:column;z-index:400;overflow-y:auto;transition:transform .28s ease;box-shadow:4px 0 30px rgba(0,0,0,.3);}
.sb-top{padding:22px 16px 0;}
.brand{display:flex;align-items:center;gap:11px;margin-bottom:20px;}
.brand-icon{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,var(--acc),var(--pur));display:flex;align-items:center;justify-content:center;font-size:18px;color:#fff;flex-shrink:0;box-shadow:0 4px 16px rgba(79,126,247,.4);}
.brand-text .bname{font-size:.9rem;font-weight:800;color:#fff;}
.brand-text .bsub{font-size:10.5px;color:rgba(255,255,255,.38);margin-top:1px;}
.user-chip{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);border-radius:var(--rs);padding:12px 14px;margin-bottom:16px;}
.uc-lbl{font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:rgba(255,255,255,.35);display:block;margin-bottom:4px;}
.uc-name{color:#fff;font-size:13.5px;font-weight:700;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:7px;}
.sec-badge{display:inline-flex;align-items:center;gap:5px;background:linear-gradient(135deg,var(--acc),var(--acc2));color:#fff;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;}
.sb-switcher{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:var(--rs);padding:11px 12px;margin-bottom:12px;}
.sw-lbl{font-size:10px;color:rgba(255,255,255,.3);text-transform:uppercase;letter-spacing:.5px;display:flex;align-items:center;gap:5px;margin-bottom:7px;}
.sw-sel{flex:1;padding:7px 9px;border-radius:7px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.07);color:#fff;font-size:12px;font-family:inherit;outline:none;cursor:pointer;}
.sw-sel option{background:#0d1535;}
.sw-btn{padding:7px 12px;border-radius:7px;background:var(--acc);color:#fff;border:none;font-size:12px;font-weight:700;cursor:pointer;transition:.18s;}
.sb-nav{padding:4px 10px 16px;flex:1;}
.nav-grp-lbl{font-size:9.5px;text-transform:uppercase;letter-spacing:.7px;color:rgba(255,255,255,.25);padding:12px 8px 4px;font-weight:700;}
.nav-link{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:var(--rs);margin-bottom:2px;color:rgba(255,255,255,.52);text-decoration:none;font-size:13px;font-weight:600;transition:.18s;border:none;background:none;cursor:pointer;width:100%;text-align:left;}
.nav-link:hover{background:rgba(255,255,255,.07);color:#fff;}
.nav-link.active{background:rgba(79,126,247,.2);color:#fff;border-left:3px solid var(--acc);padding-left:9px;}
.nav-link.danger{color:rgba(248,113,113,.6);}
.nav-link.danger:hover{background:rgba(220,38,38,.12);color:var(--dan);}
.nav-link.export{color:rgba(52,211,153,.6);}
.nav-link.export:hover{background:rgba(5,150,105,.12);color:var(--suc);}
.nav-link i{width:18px;text-align:center;flex-shrink:0;}
.sb-foot{padding:12px 14px;border-top:1px solid rgba(255,255,255,.06);}
.sb-clock{font-size:.75rem;color:rgba(255,255,255,.28);text-align:center;font-variant-numeric:tabular-nums;}
.sb-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:350;}
.sb-overlay.open{display:block;}
.ham{display:none;position:fixed;top:13px;left:13px;z-index:500;background:var(--pri);border:none;color:#fff;padding:10px 13px;border-radius:var(--rs);font-size:18px;cursor:pointer;box-shadow:0 3px 14px rgba(0,0,0,.35);}
.mob-topbar{display:none;background:linear-gradient(135deg,var(--pri),var(--pri2));color:#fff;padding:0 16px 0 58px;height:52px;position:fixed;top:0;left:0;right:0;z-index:300;align-items:center;justify-content:space-between;box-shadow:0 2px 14px rgba(0,0,0,.25);}
.mob-topbar span{font-size:14px;font-weight:800;}
.main{margin-left:var(--sb-w);padding:28px 28px 60px;flex:1;min-width:0;}
.pg-hdr{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;margin-bottom:26px;}
.pg-hdr h1{font-size:1.45rem;font-weight:900;letter-spacing:-.4px;margin-bottom:4px;}
.pg-hdr p{font-size:13px;color:var(--muted);}
.pg-hdr-right{display:flex;align-items:center;gap:10px;}
.btn-icon{background:var(--card);border:1.5px solid var(--border);color:var(--muted);padding:9px 12px;border-radius:var(--rs);cursor:pointer;font-size:15px;transition:.18s;display:inline-flex;align-items:center;}
.btn-icon:hover{border-color:var(--acc);color:var(--acc);}
#desktopClock{font-size:1rem;font-weight:800;color:var(--muted);font-variant-numeric:tabular-nums;min-width:88px;text-align:right;}
.alert{display:flex;align-items:center;gap:10px;padding:13px 16px;border-radius:var(--rs);margin-bottom:20px;font-size:13.5px;animation:slideDown .3s ease;}
@keyframes slideDown{from{opacity:0;transform:translateY(-8px);}to{opacity:1;transform:none;}}
.alert-ok{background:rgba(5,150,105,.08);color:var(--suc);border:1px solid rgba(5,150,105,.2);}
.alert-err{background:rgba(220,38,38,.06);color:var(--dan);border:1px solid rgba(220,38,38,.18);}
.stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:26px;}
.stat-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:22px 20px;box-shadow:var(--sh);display:flex;align-items:center;gap:16px;transition:.2s;}
.stat-card:hover{transform:translateY(-3px);box-shadow:var(--sh2);}
.stat-icon{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0;}
.stat-body .sl{font-size:10.5px;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);font-weight:700;display:block;margin-bottom:4px;}
.stat-body .sv{font-size:2rem;font-weight:900;line-height:1;}
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);box-shadow:var(--sh);margin-bottom:22px;overflow:hidden;}
.card-hdr{padding:16px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;background:var(--input-bg);}
.card-hdr h3{font-size:.92rem;font-weight:800;display:flex;align-items:center;gap:8px;}
.card-body{padding:22px;}
.fc{padding:10px 13px;border:1.5px solid var(--input-bd);border-radius:var(--rs);font-size:13.5px;font-family:inherit;background:var(--input-bg);color:var(--text);outline:none;transition:.18s;}
.fc:focus{border-color:var(--acc);box-shadow:0 0 0 3px rgba(79,126,247,.12);}
select.fc option{background:var(--card);color:var(--text);}
.subj-form{display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap;}
.subj-form input{flex:1;min-width:200px;}
.tbl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;}
table{width:100%;border-collapse:collapse;min-width:460px;}
thead th{background:var(--input-bg);padding:12px 16px;text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);border-bottom:2px solid var(--border);font-weight:700;white-space:nowrap;}
tbody td{padding:13px 16px;border-bottom:1px solid var(--border);font-size:13.5px;vertical-align:middle;}
tbody tr:last-child td{border-bottom:none;}
tbody tr:hover td{background:rgba(79,126,247,.03);}
.badge{padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;}
.b-student{background:rgba(79,126,247,.1);color:var(--acc);}
.b-lecturer{background:rgba(5,150,105,.1);color:var(--suc);}
.b-leader{background:rgba(217,119,6,.1);color:var(--war);}
.b-master{background:rgba(124,58,237,.1);color:var(--pur);}
.b-pending{background:rgba(217,119,6,.1);color:var(--war);border:1px solid rgba(217,119,6,.25);}
.b-active{color:var(--suc);font-size:12px;font-weight:700;display:inline-flex;align-items:center;gap:4px;}
.btn{display:inline-flex;align-items:center;gap:7px;padding:9px 18px;border:none;border-radius:var(--rs);font-size:13px;font-weight:700;cursor:pointer;transition:.18s;text-decoration:none;white-space:nowrap;font-family:inherit;}
.btn:hover{opacity:.88;transform:translateY(-1px);}
.btn:active{transform:scale(.98);}
.btn-acc{background:linear-gradient(135deg,var(--acc),var(--acc2));color:#fff;box-shadow:0 4px 14px rgba(79,126,247,.25);}
.btn-suc{background:linear-gradient(135deg,var(--suc),#047857);color:#fff;}
.btn-dan{background:rgba(220,38,38,.08);color:var(--dan);border:1px solid rgba(220,38,38,.2);}
.btn-dan:hover{background:var(--dan);color:#fff;}
.btn-ghost{background:var(--input-bg);color:var(--text);border:1.5px solid var(--input-bd);}
.btn-ghost:hover{border-color:var(--acc);color:var(--acc);}
.bulk-bar{background:var(--input-bg);border:1.5px solid var(--border);border-radius:var(--rs);padding:14px 16px;display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:16px;}
.bulk-bar select{flex:1;min-width:140px;}
.search-wrap{position:relative;width:280px;max-width:100%;}
.search-wrap i{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:13px;pointer-events:none;}
.search-wrap input{padding-left:36px;width:100%;}
.tab-btn{padding:6px 15px;border:1.5px solid var(--border);border-radius:20px;cursor:pointer;font-size:12.5px;font-weight:700;background:var(--card);color:var(--muted);transition:.18s;font-family:inherit;}
.tab-btn:hover,.tab-btn.active{background:var(--acc);color:#fff;border-color:var(--acc);}
.tab-btn.warn-tab{border-color:rgba(217,119,6,.4);color:var(--war);}
.tab-btn.warn-tab:hover,.tab-btn.warn-tab.active{background:var(--war);color:#fff;border-color:var(--war);}
.import-card{border:2px dashed rgba(79,126,247,.25)!important;background:rgba(79,126,247,.02)!important;}
.import-form{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:14px;}
.import-form input[type="file"]{flex:1;min-width:180px;padding:10px 12px;border:1.5px solid var(--input-bd);border-radius:var(--rs);background:var(--card);color:var(--text);font-family:inherit;font-size:13px;}
@media(max-width:900px){.stats-grid{grid-template-columns:1fr 1fr;}}
@media(max-width:768px){.sidebar{transform:translateX(-100%);}
.sidebar.open{transform:translateX(0);}
.main{margin-left:0;padding:70px 14px 40px;}
.ham{display:flex;}.mob-topbar{display:flex;}
.stats-grid{grid-template-columns:1fr 1fr;}#desktopClock{display:none;}
.search-wrap{width:100%;}}
@media(max-width:420px){.stats-grid{grid-template-columns:1fr;}.subj-form{flex-direction:column;}}
</style>
</head>
<body>
<button class="ham" id="hamBtn" aria-label="Menu"><i class="fas fa-bars"></i></button>
<div class="mob-topbar"><span><i class="fas fa-shield-alt" style="color:var(--acc);margin-right:6px;"></i>Master — <%= user.section %></span><button id="themeToggleMob" class="btn-icon" style="border:none;background:transparent;color:rgba(255,255,255,.7);font-size:15px;"><i class="fas fa-moon" id="themeIconMob"></i></button></div>
<div class="sb-overlay" id="sbOverlay"></div>

<aside class="sidebar" id="sidebar">
  <div class="sb-top">
    <div class="brand">
      <div class="brand-icon"><i class="fas fa-shield-alt"></i></div>
      <div class="brand-text"><div class="bname">MASTER</div><div class="bsub">Command Center</div></div>
    </div>
    <div class="user-chip">
      <span class="uc-lbl">Authorized Faculty</span>
      <strong class="uc-name"><%= user.name %></strong>
      <span class="sec-badge"><i class="fas fa-layer-group" style="font-size:9px;"></i> <%= user.section %></span>
    </div>
    <% var masterRoles = user.roles && user.roles.length > 1 ? user.roles : null; %>
    <% if (masterRoles) { %>
    <div class="sb-switcher">
      <div class="sw-lbl"><i class="fas fa-exchange-alt"></i> Switch Role</div>
      <form action="/switch-role" method="POST" style="display:flex;gap:6px;">
        <select name="targetRole" class="sw-sel"><% masterRoles.forEach(function(r){ %><option value="<%= r %>" <%= r===user.role?'selected':'' %>><%= r %></option><% }); %></select>
        <button type="submit" class="sw-btn">Go</button>
      </form>
    </div>
    <% } %>
    <% var masterSections = (user.sections && user.sections.length > 1) ? user.sections : null; %>
    <% if (masterSections) { %>
    <div class="sb-switcher">
      <div class="sw-lbl"><i class="fas fa-layer-group"></i> Change Division</div>
      <form action="/switch-section" method="POST" style="display:flex;gap:6px;">
        <select name="targetSection" class="sw-sel"><% masterSections.forEach(function(s){ %><option value="<%= s %>" <%= s===user.section?'selected':'' %>><%= s===user.section?'[Active] ':'' %><%= s %></option><% }); %></select>
        <button type="submit" class="sw-btn"><i class="fas fa-arrow-right"></i></button>
      </form>
    </div>
    <% } %>
  </div>
  <nav class="sb-nav">
    <div class="nav-grp-lbl">Navigation</div>
    <a href="/master" class="nav-link active"><i class="fas fa-th-large"></i> Dashboard</a>
    <a href="/attendance-history" class="nav-link"><i class="fas fa-history"></i> Attendance History</a>
    <a href="/settings" class="nav-link"><i class="fas fa-cog"></i> Settings</a>
    <a href="/export-attendance" class="nav-link export"><i class="fas fa-file-export"></i> Export CSV</a>
    <div class="nav-grp-lbl" style="margin-top:6px;">Account</div>
    <a href="/logout" class="nav-link danger"><i class="fas fa-power-off"></i> Logout</a>
  </nav>
  <div class="sb-foot"><div class="sb-clock" id="sbClock"></div></div>
</aside>

<main class="main" id="mainContent">
  <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-ok"><i class="fas fa-check-circle"></i> <%= success %></div><% } %>
  <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-err"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>

  <div class="pg-hdr">
    <div><h1>Section Command Center</h1><p>Managing all records for <strong><%= user.section %></strong></p></div>
    <div class="pg-hdr-right">
      <button id="themeToggle" class="btn-icon" title="Toggle theme"><i class="fas fa-moon" id="themeIcon"></i></button>
      <div id="desktopClock"></div>
    </div>
  </div>

  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(79,126,247,.1);color:var(--acc);"><i class="fas fa-users"></i></div>
      <div class="stat-body"><span class="sl">Total Users</span><div class="sv" style="color:var(--acc);"><%= stats.total %></div></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(220,38,38,.08);color:var(--dan);"><i class="fas fa-user-clock"></i></div>
      <div class="stat-body"><span class="sl">Pending</span><div class="sv" style="color:var(--dan);"><%= stats.pending %></div></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(5,150,105,.1);color:var(--suc);"><i class="fas fa-book-open"></i></div>
      <div class="stat-body"><span class="sl">Subjects</span><div class="sv" style="color:var(--suc);"><%= stats.subjects %></div></div>
    </div>
  </div>

  <div class="card">
    <div class="card-hdr"><h3><i class="fas fa-book" style="color:var(--acc);"></i> Subject Management</h3></div>
    <div class="card-body">
      <form action="/add-subject" method="POST" class="subj-form">
        <input type="hidden" name="section" value="<%= user.section %>">
        <input type="text" name="subjectName" class="fc" placeholder="New subject name (e.g. Mathematics)" required style="flex:1;min-width:200px;">
        <button type="submit" class="btn btn-acc"><i class="fas fa-plus"></i> Add Subject</button>
      </form>
      <% if (masterSubjects && masterSubjects.length > 0) { %>
      <div class="tbl-wrap"><table>
        <thead><tr><th><i class="fas fa-book-open"></i> Subject</th><th style="text-align:right;">Actions</th></tr></thead>
        <tbody>
          <% masterSubjects.forEach(function(sub){ %>
          <tr>
            <td><strong><%= sub.name %></strong><% if(sub.code){ %><span style="font-size:11.5px;color:var(--muted);margin-left:8px;">(<%=sub.code%>)</span><% } %></td>
            <td style="text-align:right;"><form action="/delete-subject/<%= sub._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete subject: <%= sub.name %>?')"><button type="submit" class="btn btn-dan" style="padding:6px 13px;font-size:12px;"><i class="fas fa-trash-alt"></i> Remove</button></form></td>
          </tr>
          <% }); %>
        </tbody>
      </table></div>
      <% } else { %>
      <div style="text-align:center;padding:32px;color:var(--muted);"><i class="fas fa-book" style="font-size:2rem;opacity:.15;display:block;margin-bottom:12px;"></i><p>No subjects yet. Add one above.</p></div>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-hdr"><h3><i class="fas fa-users" style="color:var(--acc);"></i> User Management</h3></div>
    <div class="card-body">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:16px;">
        <span style="font-size:13px;color:var(--muted);">Manage, approve and assign roles to users in this section.</span>
        <div class="search-wrap"><i class="fas fa-search"></i><input type="text" id="userSearch" class="fc" placeholder="Search name or email…"></div>
      </div>
      <div style="display:flex;gap:7px;flex-wrap:wrap;margin-bottom:16px;" id="roleTabs">
        <button type="button" class="tab-btn active" onclick="filterRole('all',this)">All (<%= stats.total %>)</button>
        <button type="button" class="tab-btn" onclick="filterRole('Student',this)"><i class="fas fa-graduation-cap" style="color:var(--acc);"></i> Students (<%= stats.students %>)</button>
        <% var _pendU = allUsers.filter(function(u){ return !u.isApproved; }); %>
        <% if (_pendU.length > 0) { %><button type="button" class="tab-btn warn-tab" onclick="filterRole('pending',this)">⏳ Pending (<%= _pendU.length %>)</button><% } %>
        <% ['Leader','Lecturer','Master'].forEach(function(r){ var rc = allUsers.filter(function(u){ return u.role===r; }).length; if(rc>0){ %><button type="button" class="tab-btn" onclick="filterRole('<%= r %>',this)"><%= r %>s (<%= rc %>)</button><% }}); %>
      </div>
      <form action="/bulk-approve" method="POST">
        <input type="hidden" name="section" value="<%= user.section %>">
        <div class="bulk-bar">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13.5px;font-weight:700;"><input type="checkbox" id="selectAll" style="width:16px;height:16px;accent-color:var(--acc);cursor:pointer;"> Select All</label>
          <select name="targetRole" required class="fc" style="flex:1;min-width:140px;"><option value="" disabled selected>Assign Role…</option><option value="Student">Student</option><option value="Leader">Leader</option><option value="Lecturer">Lecturer</option></select>
          <button type="submit" class="btn btn-suc"><i class="fas fa-user-check"></i> Bulk Update & Approve</button>
        </div>
        <div class="tbl-wrap"><table id="userTable">
          <thead><tr><th style="width:44px;"></th><th>User Details</th><th>Role & Status</th><th style="text-align:center;">Actions</th></tr></thead>
          <tbody>
            <% if (allUsers && allUsers.length > 0) { %><% allUsers.forEach(function(u){ %>
            <tr class="u-row" data-role="<%= u.role %>" data-pend="<%= !u.isApproved ? 'y' : 'n' %>">
              <td><input type="checkbox" name="userIds[]" value="<%= u._id %>" class="user-cb" style="width:16px;height:16px;accent-color:var(--acc);cursor:pointer;"></td>
              <td><strong><%= u.name %></strong><div style="font-size:12px;color:var(--muted);"><i class="fas fa-envelope" style="opacity:.5;font-size:10px;"></i> <%= u.email %></div><% if(u.rollNo){ %><div style="font-size:11.5px;color:var(--acc);font-family:monospace;font-weight:700;">Roll: <%= u.rollNo %></div><% } %></td>
              <td><span class="badge b-<%= (u.role||'').toLowerCase() %>"><%= u.role || 'Unassigned' %></span><% if(u.isApproved){ %><span class="b-active" style="margin-left:8px;"><i class="fas fa-check-circle"></i> Active</span><% } else { %><span class="badge b-pending" style="margin-left:6px;">⏳ Pending</span><% } %></td>
              <td style="text-align:center;"><form action="/delete-user/<%= u._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete <%= u.name %>?')"><button type="submit" class="btn btn-dan" style="padding:7px 12px;font-size:12px;"><i class="fas fa-trash-alt"></i></button></form></td>
            </tr>
            <% }); %><% } else { %>
            <tr><td colspan="4" style="text-align:center;padding:50px;color:var(--muted);"><i class="fas fa-user-slash" style="font-size:2rem;opacity:.2;display:block;margin-bottom:12px;"></i>No users found.</td></tr>
            <% } %>
          </tbody>
        </table></div>
      </form>
    </div>
  </div>

  <div class="card import-card">
    <div class="card-hdr"><h3><i class="fas fa-file-import" style="color:var(--acc);"></i> Bulk Student Import (CSV)</h3></div>
    <div class="card-body">
      <p style="color:var(--muted);font-size:13.5px;">CSV must have headers: <code style="background:var(--input-bg);padding:2px 7px;border-radius:5px;font-size:12px;border:1px solid var(--border);">name, email, studentId</code></p>
      <form action="/upload-users" method="POST" enctype="multipart/form-data" class="import-form">
        <input type="hidden" name="section" value="<%= user.section %>">
        <input type="file" name="csvFile" accept=".csv" required>
        <button type="submit" class="btn btn-acc"><i class="fas fa-upload"></i> Upload & Auto-Approve</button>
      </form>
    </div>
  </div>
</main>

<script>
(function(){
  function setTheme(t){document.documentElement.setAttribute('data-theme',t);localStorage.setItem('rku-theme',t);syncIcons(t);}
  function syncIcons(t){var d=t==='dark';['themeIcon','themeIconMob'].forEach(function(id){var el=document.getElementById(id);if(el)el.className=d?'fas fa-sun':'fas fa-moon';});}
  function updateClock(){var n=new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',second:'2-digit'});['desktopClock','sbClock'].forEach(function(id){var el=document.getElementById(id);if(el)el.textContent=n;});}
  function openSb(){document.getElementById('sidebar').classList.add('open');document.getElementById('sbOverlay').classList.add('open');}
  function closeSb(){document.getElementById('sidebar').classList.remove('open');document.getElementById('sbOverlay').classList.remove('open');}
  document.addEventListener('DOMContentLoaded',function(){
    syncIcons(document.documentElement.getAttribute('data-theme'));
    ['themeToggle','themeToggleMob'].forEach(function(id){var el=document.getElementById(id);if(el)el.addEventListener('click',function(){var c=document.documentElement.getAttribute('data-theme')||'light';setTheme(c==='dark'?'light':'dark');});});
    var ham=document.getElementById('hamBtn'),ov=document.getElementById('sbOverlay');
    if(ham)ham.addEventListener('click',openSb);if(ov)ov.addEventListener('click',closeSb);
    document.querySelectorAll('.sidebar .nav-link').forEach(function(a){a.addEventListener('click',function(){if(window.innerWidth<=768)closeSb();});});
    updateClock();setInterval(updateClock,1000);
    var _cr='all';
    window.filterRole=function(role,btn){_cr=role;document.querySelectorAll('#roleTabs .tab-btn').forEach(function(b){b.classList.remove('active');});if(btn)btn.classList.add('active');applyFilter();};
    function applyFilter(){var q=(document.getElementById('userSearch')?document.getElementById('userSearch').value:'').toLowerCase();document.querySelectorAll('#userTable tbody tr.u-row').forEach(function(r){var rm=_cr==='all'||(_cr==='pending'&&r.dataset.pend==='y')||r.dataset.role===_cr;var qm=!q||r.textContent.toLowerCase().includes(q);r.style.display=(rm&&qm)?'':'none';});}
    var se=document.getElementById('userSearch');if(se)se.addEventListener('input',applyFilter);
    var sa=document.getElementById('selectAll');if(sa)sa.addEventListener('change',function(){document.querySelectorAll('.user-cb').forEach(function(cb){if(cb.closest('tr').style.display!=='none')cb.checked=sa.checked;});});
    document.querySelectorAll('.user-cb').forEach(function(cb){cb.addEventListener('change',function(){if(!this.checked){var s=document.getElementById('selectAll');if(s)s.checked=false;}});});
    document.querySelectorAll('.alert').forEach(function(a){setTimeout(function(){a.style.transition='opacity .5s';a.style.opacity='0';setTimeout(function(){if(a.parentNode)a.parentNode.removeChild(a);},500);},5000);});
  });
  if(document.readyState!=='loading')syncIcons(document.documentElement.getAttribute('data-theme'));
})();
</script>
</body>
</html>
