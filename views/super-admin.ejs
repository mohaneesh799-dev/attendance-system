<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SuperAdmin Control Center</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --primary: #1a2a3a; --accent: #1e90ff; --success: #2ed573; --danger: #ff4757; --bg: #f1f2f6; --text: #2f3542; }
        body { font-family: 'Inter', 'Segoe UI', sans-serif; margin: 0; background: var(--bg); display: flex; color: var(--text); }
        
        /* Sidebar Navigation */
        .sidebar { width: 260px; background: var(--primary); color: white; height: 100vh; padding: 30px 20px; position: fixed; box-shadow: 4px 0 10px rgba(0,0,0,0.1); }
        .sidebar h2 { font-size: 1.5rem; color: var(--accent); margin-bottom: 40px; display: flex; align-items: center; gap: 10px; }
        .nav-link { color: #a4b0be; text-decoration: none; display: flex; align-items: center; gap: 12px; padding: 12px; border-radius: 8px; transition: 0.3s; margin-bottom: 5px; }
        .nav-link:hover, .nav-link.active { background: rgba(255,255,255,0.1); color: white; }
        
        /* Main Content Area */
        .main-content { margin-left: 280px; padding: 40px; width: calc(100% - 280px); }
        .header-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        
        /* Quick Stats */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); border-left: 5px solid var(--accent); }
        .stat-card h3 { margin: 0; font-size: 0.8rem; text-transform: uppercase; color: #747d8c; }
        .stat-card .value { font-size: 2rem; font-weight: 800; margin-top: 10px; }

        /* Tables & Cards */
        .card { background: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 30px; }
        .search-bar { width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; margin-bottom: 20px; font-size: 14px; }
        
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: 15px; background: #f8f9fa; font-size: 13px; color: #747d8c; text-transform: uppercase; }
        td { padding: 15px; border-bottom: 1px solid #f1f2f6; font-size: 14px; }
        
        /* Buttons & Badges */
        .btn { padding: 8px 16px; border-radius: 6px; cursor: pointer; border: none; font-weight: 600; font-size: 13px; transition: 0.2s; }
        .btn-approve { background: var(--success); color: white; }
        .btn-delete { background: #fff; color: var(--danger); border: 1px solid var(--danger); }
        .btn-delete:hover { background: var(--danger); color: white; }
        
        .status-pill { padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: bold; }
        .approved { background: #e3fcef; color: #00875a; }
        .pending { background: #fffae6; color: #b78103; }

        .form-grid { display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 15px; }
        input, select { padding: 12px; border: 1px solid #ddd; border-radius: 8px; }
    </style>
</head>
<body>
    <div class="sidebar">
        <h2><i class="fas fa-shield-alt"></i> Admin Panel</h2>
        <div style="margin-bottom: 30px; font-size: 0.9rem;">
            <p><i class="fas fa-user-circle"></i> <%= user.name %></p>
        </div>
        <nav>
            <a href="#overview" class="nav-link active"><i class="fas fa-chart-line"></i> Overview</a>
            <a href="#users" class="nav-link"><i class="fas fa-users"></i> User Management</a>
            <a href="#subjects" class="nav-link"><i class="fas fa-book"></i> Subject Catalog</a>
            <a href="/logout" class="nav-link" style="margin-top: 50px; color: var(--danger);"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </nav>
    </div>

    

    <div class="main-content">
        <div class="header-row">
            <h1>System Overview</h1>
            <div class="section-badge" style="background: white; padding: 10px 20px; border-radius: 30px; font-weight: bold;">
                SuperAdmin Access
            </div>
        </div>
        
        <div class="stats-grid" id="overview">
            <div class="stat-card">
                <h3>System Users</h3>
                <div class="value"><%= allUsers.length %></div>
            </div>
            <div class="stat-card" style="border-left-color: var(--success);">
                <h3>Active Subjects</h3>
                <div class="value"><%= allSubjects.length %></div>
            </div>
            <div class="stat-card" style="border-left-color: var(--danger);">
                <h3>Pending Approvals</h3>
                <div class="value"><%= allUsers.filter(u => !u.isApproved).length %></div>
            </div>
        </div>

        <div class="card" id="users">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h2 style="margin:0;">User Management</h2>
                <input type="text" id="userSearch" class="search-bar" placeholder="Search by name, email, or roll number..." style="width: 300px; margin-bottom: 0;" onkeyup="filterTable()">
            </div>
            <table id="userTable">
                <thead>
                    <tr>
                        <th>Identity</th>
                        <th>Role</th>
                        <th>Section</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% allUsers.forEach(u => { %>
                        <tr>
                            <td>
                                <strong><%= u.name %></strong><br>
                                <small style="color: #636e72;"><%= u.email %> | <%= u.rollNo || 'Faculty' %></small>
                            </td>
                            <td><span style="text-transform: capitalize;"><%= u.role %></span></td>
                            <td><strong><%= u.section || 'N/A' %></strong></td>
                            <td>
                                <span class="status-pill <%= u.isApproved ? 'approved' : 'pending' %>">
                                    <%= u.isApproved ? 'Active' : 'Pending' %>
                                </span>
                            </td>
                            <td>
                                <div style="display: flex; gap: 8px;">
                                    <% if(!u.isApproved) { %>
                                        <form action="/approve-user/<%= u._id %>" method="POST">
                                            <button class="btn btn-approve">Approve</button>
                                        </form>
                                    <% } %>
                                    <form action="/delete-user/<%= u._id %>" method="POST" onsubmit="return confirm('Permanently delete this user?')">
                                        <button class="btn btn-delete"><i class="fas fa-trash-alt"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <div class="card" id="subjects">
            <h2>Add Subject to Section</h2>
            <p style="color: #636e72; font-size: 13px;">Subjects added here will appear in the specific Section Leader's attendance list.</p>
            <form action="/add-subject" method="POST" class="form-grid">
                <input type="text" name="subjectName" placeholder="Subject Name (e.g. Data Structures)" required>
                <input type="text" name="subjectCode" placeholder="Code (CS302)" required>
                <select name="section" required>
                    <option value="">-- Assign Section --</option>
                    <option value="CS-A">CS-A</option>
                    <option value="CS-B">CS-B</option>
                    <option value="MECH">MECH</option>
                    <option value="CIVIL">CIVIL</option>
                </select>
                <button type="submit" class="btn btn-approve" style="padding: 0 30px;">Add Subject</button>
            </form>

            <h3 style="margin-top: 40px;">Current Subject Catalog</h3>
            <table>
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Subject Name</th>
                        <th>Assigned Section</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% allSubjects.forEach(sub => { %>
                        <tr>
                            <td style="font-family: monospace; font-weight: bold;"><%= sub.code %></td>
                            <td><%= sub.name %></td>
                            <td><span class="status-pill approved"><%= sub.section %></span></td>
                            <td>
                                <form action="/delete-subject/<%= sub._id %>" method="POST">
                                    <button class="btn btn-delete"><i class="fas fa-times"></i></button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        function filterTable() {
            const input = document.getElementById('userSearch').value.toUpperCase();
            const rows = document.getElementById('userTable').getElementsByTagName('tr');
            for (let i = 1; i < rows.length; i++) {
                const text = rows[i].textContent || rows[i].innerText;
                rows[i].style.display = text.toUpperCase().includes(input) ? "" : "none";
            }
        }
    </script>
</body>
</html>