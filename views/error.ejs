<!DOCTYPE html>
<html>
<head>
    <title>Error - Attendance System</title>
    <style>
        body { font-family: sans-serif; text-align: center; padding: 50px; }
        .error-card { border: 1px solid #ff0000; padding: 20px; display: inline-block; border-radius: 8px; }
    </style>
</head>
<body>
    <div class="error-card">
        <h1>Something Went Wrong</h1>
        <p><%= typeof message !== 'undefined' ? message : "An unexpected error occurred." %></p>
        <a href="/login">Back to Login</a>
    </div>
</body>
</html>