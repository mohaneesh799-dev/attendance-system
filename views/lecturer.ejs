<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lecturer Portal — <%= user.name %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary: #2c3e50; --accent: #3498db; --success: #27ae60;
            --danger: #e74c3c; --purple: #8e44ad; --bg: #f0f2f5;
            --card: #fff; --text: #333; --muted: #7f8c8d; --border: #eee;
            --th-bg: #f1f2f6; --th-color: #57606f; --hover-row: #fafbff;
            --input-bg: #fff; --input-border: #ddd;
        }
        html.dark {
            --bg: #1a1e2a; --card: #242938; --text: #d4daf0; --muted: #7a87a3;
            --border: #303550; --th-bg: #1e2230; --th-color: #8899b5;
            --hover-row: #2a2f45; --input-bg: #1e2230; --input-border: #3a4060;
            --primary: #7ea8d8; --accent: #5b9fe0;
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: var(--bg); margin: 0; padding: 16px;
            color: var(--text); transition: background 0.3s, color 0.3s;
        }
        .container { max-width: 1100px; margin: 0 auto; background: var(--card); padding: 28px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }

        /* ── Header ── */
        .header {
            display: flex; justify-content: space-between; align-items: flex-start;
            margin-bottom: 22px; padding-bottom: 18px; border-bottom: 2px solid var(--border);
            flex-wrap: wrap; gap: 14px;
        }
        .header-left h1 { margin: 0; font-size: 1.5rem; color: var(--primary); }
        .header-left p { margin: 5px 0 0; color: var(--muted); font-size: 14px; }
        .header-right { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }

        /* ── Badges ── */
        .badge-section { background: var(--accent); color: white; padding: 3px 11px; border-radius: 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; }
        .badge-div { background: var(--purple); color: white; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; }

        /* ── Buttons ── */
        .btn {
            padding: 9px 16px; border: none; border-radius: 8px; cursor: pointer;
            font-weight: 600; text-decoration: none; display: inline-flex;
            align-items: center; gap: 7px; transition: 0.25s; font-size: 13px; white-space: nowrap;
        }
        .btn:hover { filter: brightness(1.08); transform: translateY(-1px); }
        .btn-history { background: var(--primary); color: white; }
        html.dark .btn-history { background: #3a4a5a; }
        .btn-logout { background: #fdf0f0; color: var(--danger); border: 1px solid #f9d6d6; }
        .btn-logout:hover { background: var(--danger); color: white; }
        .btn-refresh { background: var(--th-bg); color: var(--accent); border: 1px solid var(--border); }
        .btn-refresh:hover { border-color: var(--accent); }
        .btn-settings { background: var(--th-bg); color: var(--text); border: 1px solid var(--border); }
        .btn-settings:hover { border-color: var(--accent); color: var(--accent); }
        .btn-master { background: #f3e5f5; color: var(--purple); border: 1px solid #e1bee7; }
        .btn-master:hover { background: var(--purple); color: white; }
        .theme-btn { background: var(--th-bg); border: 1.5px solid var(--border); color: var(--muted); border-radius: 8px; padding: 9px 12px; cursor: pointer; font-size: 15px; transition: 0.2s; }

        /* ── Info Banner ── */
        .info-banner {
            background: #e8f4fd; border-left: 4px solid var(--accent);
            padding: 12px 16px; border-radius: 8px; margin-bottom: 20px;
            font-size: 14px; color: #2471a3;
        }
        html.dark .info-banner { background: #1a2d3f; color: #7ab8db; }

        /* ── Stats Grid ── */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 16px; margin-bottom: 24px; }
        .stat-card {
            background: var(--th-bg); padding: 18px 20px; border-radius: 12px;
            border-left: 5px solid var(--accent); transition: 0.2s;
        }
        .stat-card:hover { box-shadow: 0 4px 14px rgba(0,0,0,0.1); }
        .stat-card small { color: var(--muted); text-transform: uppercase; font-weight: 700; font-size: 11px; display: block; margin-bottom: 6px; letter-spacing: 0.4px; }
        .stat-card span { font-size: 2rem; font-weight: 800; color: var(--primary); display: block; }
        html.dark .stat-card { background: #1e2230; }

        /* ── Tabs ── */
        .division-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
        .tab-btn {
            padding: 8px 18px; border: 2px solid var(--border); border-radius: 20px;
            cursor: pointer; font-weight: 600; font-size: 13px; background: var(--card);
            color: var(--muted); transition: 0.2s;
        }
        .tab-btn.active, .tab-btn:hover { background: var(--accent); color: white; border-color: var(--accent); }

        /* ── Division Group ── */
        .division-group { margin-bottom: 28px; }
        .division-header {
            display: flex; align-items: center; gap: 12px; margin-bottom: 14px;
            padding-bottom: 10px; border-bottom: 2px solid var(--border);
        }
        .division-title { font-size: 1rem; font-weight: 700; color: var(--primary); }
        .hidden { display: none !important; }

        /* ── Record Card ── */
        .record-card {
            border: 1.5px solid var(--border); border-radius: 12px;
            overflow: hidden; margin-bottom: 16px; transition: 0.2s;
        }
        .record-card:hover { border-color: var(--accent); box-shadow: 0 4px 14px rgba(0,0,0,0.07); }
        .record-header {
            background: var(--th-bg); padding: 15px 18px;
            display: flex; justify-content: space-between;
            align-items: center; flex-wrap: wrap; gap: 10px;
        }
        .record-header-info { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .record-meta { font-size: 14px; color: var(--text); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .record-meta span { font-weight: 600; }

        /* ── Table ── */
        .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; max-height: 360px; overflow-y: auto; }
        table { width: 100%; border-collapse: collapse; min-width: 360px; }
        th {
            background: var(--th-bg); color: var(--th-color); font-size: 12px;
            text-transform: uppercase; text-align: left; padding: 12px 14px;
            border-bottom: 2px solid var(--border); white-space: nowrap; position: sticky; top: 0; z-index: 1;
        }
        td { padding: 11px 14px; border-bottom: 1px solid var(--border); font-size: 13px; color: var(--text); }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: var(--hover-row); }

        /* ── Status ── */
        .status-badge {
            padding: 4px 10px; border-radius: 6px; font-size: 11px;
            font-weight: 700; text-transform: uppercase; display: inline-block;
        }
        .status-badge.Present { background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9; }
        .status-badge.Absent { background: #ffebee; color: #c62828; border: 1px solid #ffcdd2; }
        html.dark .status-badge.Present { background: #1a3325; color: #7dcea0; border-color: #2e7d52; }
        html.dark .status-badge.Absent { background: #3a1a1e; color: #e08080; border-color: #7d2e30; }

        /* ── Strength indicators ── */
        .present-count { background: #e8f5e9; color: #2e7d32; padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 700; border: 1px solid #c8e6c9; }
        .absent-count { background: #ffebee; color: #c62828; padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 700; border: 1px solid #ffcdd2; }
        html.dark .present-count { background: #1a3325; color: #7dcea0; border-color: #2e7d52; }
        html.dark .absent-count { background: #3a1a1e; color: #e08080; border-color: #7d2e30; }

        /* ── Empty ── */
        .empty-box {
            text-align: center; padding: 60px 20px; color: var(--muted);
            background: var(--th-bg); border: 2px dashed var(--border);
            border-radius: 14px; margin-top: 20px;
        }
        .empty-box i { font-size: 3rem; margin-bottom: 15px; opacity: 0.3; display: block; }

        @media (max-width: 768px) {
            body { padding: 10px; }
            .container { padding: 18px 14px; }
            .header { flex-direction: column; }
            .header-right { width: 100%; justify-content: flex-start; }
            .stats-grid { grid-template-columns: 1fr 1fr; }
        }
        @media (max-width: 480px) {
            .stats-grid { grid-template-columns: 1fr; }
            .header-left h1 { font-size: 1.2rem; }
            .btn { padding: 8px 12px; font-size: 12px; }
            .record-meta { font-size: 12px; }
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <div class="header-left">
            <h1><i class="fas fa-chalkboard-teacher"></i> Lecturer Portal</h1>
            <p>Welcome back, <strong style="color:var(--primary);"><%= user.name %></strong></p>
        </div>
        <div class="header-right">
            <button class="theme-btn" onclick="toggleDark()" id="themeBtnIcon" title="Toggle theme">🌙</button>
            <% if (user.isClassTeacher) { %>
                <a href="/master" class="btn btn-master"><i class="fas fa-shield-alt"></i> Class Teacher (<%= user.classTeacherSection %>)</a>
            <% } %>
            <button onclick="location.reload()" class="btn btn-refresh"><i class="fas fa-sync-alt"></i> Refresh</button>
            <a href="/settings" class="btn btn-settings"><i class="fas fa-cog"></i> Settings</a>
            <a href="/attendance-history" class="btn btn-history"><i class="fas fa-history"></i> History</a>
            <a href="/logout" class="btn btn-logout"><i class="fas fa-power-off"></i> Logout</a>
        </div>
    </div>

    <% if (user.isClassTeacher) { %>
        <div class="info-banner">
            <i class="fas fa-star"></i> You are the <strong>Class Teacher</strong> for Division <strong><%= user.classTeacherSection %></strong>.
            Use the <strong>Class Teacher Panel</strong> button to manage students and subjects for that division.
        </div>
    <% } %>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <small>Divisions Today</small>
            <span><%= sectionsToday && sectionsToday.length > 0 ? sectionsToday.length : 0 %></span>
        </div>
        <div class="stat-card" style="border-left-color:var(--success);">
            <small>Today's Classes</small>
            <span><%= todayRecords ? todayRecords.length : 0 %></span>
        </div>
        <div class="stat-card" style="border-left-color:#f1c40f;">
            <small>Total Present Today</small>
            <span>
                <%= todayRecords ? todayRecords.reduce(function(s,r){ return s + (r.students||[]).filter(function(x){ return x.status==='Present'; }).length; }, 0) : 0 %>
            </span>
        </div>
    </div>

    <!-- Attendance Logs -->
    <div>
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:8px;">
            <h3 style="margin:0;color:var(--primary);font-size:1rem;">Today's Attendance Logs — All Divisions</h3>
            <span class="badge-section">Live Updates</span>
        </div>
        <p style="font-size:13px;color:var(--muted);margin:0 0 16px;">
            Attendance submitted across all divisions where you are the assigned lecturer today.
        </p>

        <% if (todayRecords && todayRecords.length > 0) { %>
            <%
                var grouped = {};
                todayRecords.forEach(function(r) {
                    var sec = r.section || 'Unknown';
                    if (!grouped[sec]) grouped[sec] = [];
                    grouped[sec].push(r);
                });
                var divKeys = Object.keys(grouped).sort();
            %>

            <div class="division-tabs">
                <button class="tab-btn active" onclick="showDivision('all', this)">
                    <i class="fas fa-layer-group"></i> All Divisions
                </button>
                <% divKeys.forEach(function(sec) { %>
                    <button class="tab-btn" onclick="showDivision('<%= sec %>', this)">
                        <span class="badge-div" style="font-size:10px;"><%= sec %></span>
                        &nbsp;<%= grouped[sec].length %> class<%= grouped[sec].length > 1 ? 'es' : '' %>
                    </button>
                <% }); %>
            </div>

            <% divKeys.forEach(function(sec) { %>
                <div class="division-group" data-division="<%= sec %>">
                    <div class="division-header">
                        <span class="badge-div"><%= sec %></span>
                        <span class="division-title"><%= grouped[sec].length %> class<%= grouped[sec].length > 1 ? 'es' : '' %> today</span>
                    </div>

                    <% grouped[sec].forEach(function(record) {
                        const pCount = (record.students||[]).filter(function(s){ return s.status==='Present'; }).length;
                        const aCount = (record.students||[]).filter(function(s){ return s.status==='Absent'; }).length;
                    %>
                        <div class="record-card">
                            <div class="record-header">
                                <div class="record-header-info">
                                    <span class="badge-section" style="background:#57606f;"><%= record.subject || 'N/A' %></span>
                                    <span style="font-weight:600;font-size:14px;color:var(--text);">
                                        <i class="far fa-clock" style="color:var(--muted);"></i> <%= record.manualTime || 'N/A' %>
                                    </span>
                                </div>
                                <div class="record-meta">
                                    <span>Date: <%= record.date %></span>
                                    <span class="present-count"><i class="fas fa-check"></i> <%= pCount %> Present</span>
                                    <span class="absent-count"><i class="fas fa-times"></i> <%= aCount %> Absent</span>
                                </div>
                            </div>
                            <div class="table-scroll">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Roll No</th>
                                            <th>Student Name</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (record.students && record.students.length > 0) { %>
                                            <% record.students.forEach(function(student) { %>
                                                <tr>
                                                    <td style="font-family:monospace;font-weight:bold;color:var(--accent);">
                                                        <%= student.studentId || 'N/A' %>
                                                    </td>
                                                    <td><%= student.studentName || 'Unknown' %></td>
                                                    <td>
                                                        <span class="status-badge <%= student.status %>">
                                                            <i class="fas <%= student.status === 'Present' ? 'fa-check-circle' : 'fa-times-circle' %>"></i>
                                                            <%= student.status %>
                                                        </span>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="3" style="text-align:center;color:var(--muted);padding:20px;">
                                                    No students listed for this record.
                                                </td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% }); %>

        <% } else { %>
            <div class="empty-box">
                <i class="fas fa-clipboard-list"></i>
                <p style="font-size:1rem;margin:0 0 14px;">No attendance records submitted for your classes today.</p>
                <a href="/attendance-history" style="color:var(--accent);font-weight:600;text-decoration:underline;">
                    View previous logs in history
                </a>
            </div>
        <% } %>
    </div>
</div>

<script>
(function(){
    if(localStorage.getItem('rku-theme')==='dark'){
        document.getElementById('htmlRoot').classList.add('dark');
        document.getElementById('themeBtnIcon').textContent='☀️';
    }
})();

function toggleDark(){
    const isDark=document.getElementById('htmlRoot').classList.toggle('dark');
    localStorage.setItem('rku-theme',isDark?'dark':'light');
    document.getElementById('themeBtnIcon').textContent=isDark?'☀️':'🌙';
}

document.addEventListener('DOMContentLoaded', function() {
    function showDivision(division, btn) {
        document.querySelectorAll('.tab-btn').forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
        document.querySelectorAll('.division-group').forEach(function(group){
            group.classList.toggle('hidden', division !== 'all' && group.dataset.division !== division);
        });
    }
    window.showDivision = showDivision;
});
</script>
</body>
</html>
