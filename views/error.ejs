<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Error | Attendance Portal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --danger: #e74c3c; --primary: #2c3e50; --bg: #f8f9fa; }
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background-color: var(--bg); 
            height: 100vh; display: flex; align-items: center; justify-content: center; 
            margin: 0; 
        }
        .error-card { 
            background: white; 
            padding: 50px; 
            border-radius: 16px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.1); 
            max-width: 500px; width: 90%; 
            text-align: center;
            border-top: 6px solid var(--danger);
        }
        .error-icon { 
            font-size: 80px; 
            color: var(--danger); 
            margin-bottom: 20px; 
        }
        h1 { color: var(--primary); margin: 0 0 15px 0; font-size: 24px; }
        p { color: #7f8c8d; line-height: 1.6; margin-bottom: 30px; }
        
        .btn-group { display: flex; gap: 10px; justify-content: center; }
        .btn { 
            padding: 12px 25px; 
            border-radius: 8px; 
            text-decoration: none; 
            font-weight: bold; 
            transition: 0.3s; 
            font-size: 14px;
        }
        .btn-home { background: var(--primary); color: white; }
        .btn-home:hover { background: #34495e; transform: translateY(-2px); }
        .btn-back { background: #ecf0f1; color: var(--primary); cursor: pointer; border: none; }
        .btn-back:hover { background: #bdc3c7; }

        .error-code { 
            margin-top: 25px; 
            font-family: monospace; 
            font-size: 12px; 
            color: #bdc3c7; 
            text-transform: uppercase; 
        }
    </style>
</head>
<body>

<div class="error-card">
    <div class="error-icon">
        <i class="fas fa-exclamation-circle"></i>
    </div>
    <h1>Oops! Something went wrong</h1>
    <p>
        <%= typeof message !== 'undefined' ? message : "The server encountered an internal error or misconfiguration and was unable to complete your request." %>
    </p>

    <div class="btn-group">
        <button onclick="window.history.back()" class="btn btn-back">
            <i class="fas fa-arrow-left"></i> Go Back
        </button>
        <a href="/login" class="btn btn-home">
            <i class="fas fa-sign-in-alt"></i> Back to Login
        </a>
    </div>

    <div class="error-code">
        Error Logged: <%= new Date().toLocaleTimeString() %>
    </div>
</div>

</body>
</html>