<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Attendance — <%= user.rollNo %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root{
            --bg:#f0f4f8;--card:#fff;--border:#e2e8f0;--text:#1e293b;
            --muted:#64748b;--accent:#3b82f6;--success:#16a34a;
            --danger:#dc2626;--warning:#d97706;--shadow:0 4px 12px rgba(0,0,0,.07);
        }
        [data-theme="dark"]{
            --bg:#0d1117;--card:#161b22;--border:#21262d;--text:#c9d1d9;
            --muted:#8b949e;--accent:#58a6ff;--success:#3fb950;
            --danger:#f85149;--warning:#d29922;--shadow:0 4px 12px rgba(0,0,0,.4);
        }
        *{box-sizing:border-box;margin:0;padding:0;}
        body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);padding:12px;min-height:100vh;}

        /* ── Top bar ── */
        .topbar{
            background:linear-gradient(135deg,#0f2557,#1d4ed8);
            color:#fff;border-radius:18px;padding:20px 22px;
            display:flex;align-items:center;justify-content:space-between;
            flex-wrap:wrap;gap:12px;margin-bottom:16px;
            box-shadow:0 8px 24px rgba(29,78,216,.3);
        }
        .topbar h1{font-size:1.3rem;font-weight:800;}
        .topbar p {font-size:13px;opacity:.8;margin-top:4px;}
        .topbar-right{display:flex;gap:8px;flex-wrap:wrap;align-items:center;}
        .chip{background:rgba(255,255,255,.15);color:#fff;padding:6px 13px;border-radius:20px;font-size:12px;font-weight:700;}
        .chip-btn{background:rgba(255,255,255,.12);color:#fff;padding:7px 14px;border-radius:20px;font-size:12px;font-weight:700;text-decoration:none;border:none;cursor:pointer;transition:.2s;}
        .chip-btn:hover{background:rgba(255,255,255,.22);}

        /* ── Banners ── */
        .banner{display:flex;align-items:flex-start;gap:12px;padding:13px 16px;border-radius:12px;font-size:14px;font-weight:500;margin-bottom:14px;}
        .ban-warn{background:#fef3c7;color:#92400e;border-left:4px solid #f59e0b;}
        .ban-good{background:#dcfce7;color:#14532d;border-left:4px solid #22c55e;}
        [data-theme="dark"] .ban-warn{background:rgba(245,158,11,.1);color:#fbbf24;}
        [data-theme="dark"] .ban-good{background:rgba(34,197,94,.08);color:#4ade80;}

        /* ── Stats ── */
        .stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px;margin-bottom:16px;}
        .stat{background:var(--card);border-radius:14px;padding:18px 14px;text-align:center;border:1px solid var(--border);box-shadow:var(--shadow);transition:.2s;}
        .stat:hover{transform:translateY(-2px);}
        .stat .lbl{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);}
        .stat .val{font-size:2rem;font-weight:800;line-height:1.1;margin:7px 0 4px;}
        .stat .sub{font-size:11px;color:var(--muted);}

        /* ── Progress bar ── */
        .pbar{height:7px;background:var(--border);border-radius:4px;overflow:hidden;margin-top:7px;}
        .pfill{height:100%;border-radius:4px;transition:width 1.2s ease;}

        /* ── Cards ── */
        .card{background:var(--card);border-radius:16px;border:1px solid var(--border);box-shadow:var(--shadow);margin-bottom:16px;overflow:hidden;}
        .card-hdr{padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;}
        .card-hdr h3{margin:0;font-size:.95rem;font-weight:700;display:flex;align-items:center;gap:9px;}
        .card-body{padding:18px 20px;}

        /* ── Subject cards ── */
        .subj-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px;margin-bottom:20px;}
        .sc{
            background:var(--card);border:2px solid var(--border);border-radius:13px;
            padding:16px;transition:.2s;position:relative;
        }
        .sc:hover{border-color:var(--accent);box-shadow:0 4px 16px rgba(59,130,246,.1);}
        .sc .sn{font-weight:700;font-size:.9rem;margin-bottom:3px;color:var(--text);}
        .sc .sc2{font-size:12px;color:var(--muted);margin-bottom:10px;}
        .sc .sp{font-size:1.75rem;font-weight:800;}
        .sc-tag{font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px;display:inline-block;margin-top:5px;}
        .t-ok  {color:#15803d;background:rgba(22,163,74,.1);}
        .t-risk{color:#d97706;background:rgba(217,119,6,.1);}
        .t-low {color:#dc2626;background:rgba(220,38,38,.1);}
        [data-theme="dark"] .t-ok  {color:#4ade80;background:rgba(74,222,128,.12);}
        [data-theme="dark"] .t-risk{color:#fbbf24;background:rgba(251,191,36,.12);}
        [data-theme="dark"] .t-low {color:#f87171;background:rgba(248,113,113,.12);}

        /* ── Table ── */
        .tbl-wrap{overflow-x:auto;}
        table{width:100%;border-collapse:collapse;}
        th{background:var(--bg);color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.4px;padding:10px 14px;border-bottom:2px solid var(--border);text-align:left;white-space:nowrap;}
        td{padding:12px 14px;border-bottom:1px solid var(--border);font-size:13px;}
        tr:last-child td{border-bottom:none;}
        .tfoot-row td{background:var(--bg);font-weight:700;font-size:13px;}

        .pill{padding:4px 10px;border-radius:6px;font-size:11px;font-weight:700;white-space:nowrap;}
        .p-present{background:#dcfce7;color:#15803d;}
        .p-absent {background:#fee2e2;color:#dc2626;}
        .p-na     {background:var(--bg);color:var(--muted);}
        [data-theme="dark"] .p-present{background:rgba(74,222,128,.15);color:#4ade80;}
        [data-theme="dark"] .p-absent {background:rgba(248,113,113,.12);color:#f87171;}

        /* ── Buttons ── */
        .btn-sm{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;border:none;cursor:pointer;transition:.2s;}
        .btn-dark{background:var(--text);color:var(--card);}
        .btn-dark:hover{opacity:.85;}
        .btn-out{background:transparent;color:var(--text);border:1.5px solid var(--border);}
        .btn-out:hover{border-color:var(--accent);color:var(--accent);}

        @media(max-width:560px){
            .topbar{padding:16px;}
            .topbar h1{font-size:1.1rem;}
            .card-hdr,.card-body{padding:14px;}
        }
    </style>
    <script>(function(){var t=localStorage.getItem('rku-theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
</head>
<body>

<%
    var pct = totalCount > 0 ? +((presentCount / totalCount) * 100).toFixed(1) : 0;
    var barColor = pct >= 75 ? 'var(--success)' : (pct >= 60 ? 'var(--warning)' : 'var(--danger)');
%>

<!-- Header -->
<div class="topbar">
    <div>
        <h1><i class="fas fa-graduation-cap"></i> My Attendance</h1>
        <p><%= user.name %> &nbsp;·&nbsp; Roll No: <strong><%= user.rollNo %></strong></p>
    </div>
    <div class="topbar-right">
        <span class="chip"><i class="fas fa-layer-group"></i> <%= user.section %></span>
        <a href="/settings" class="chip-btn"><i class="fas fa-cog"></i></a>
        <a href="/logout" class="chip-btn"><i class="fas fa-sign-out-alt"></i></a>
    </div>
</div>

<!-- Banner -->
<% if (totalCount > 0) { %>
    <% if (pct < 75) { %>
        <div class="banner ban-warn">
            <i class="fas fa-exclamation-triangle fa-lg" style="flex-shrink:0;margin-top:1px;"></i>
            <span><strong>Low Attendance Warning:</strong> Your overall attendance is <%= pct %>% — below the required 75%. Attend more classes to avoid restrictions.</span>
        </div>
    <% } else { %>
        <div class="banner ban-good">
            <i class="fas fa-check-circle fa-lg" style="flex-shrink:0;margin-top:1px;"></i>
            <span><strong>Good Standing:</strong> Your overall attendance is <%= pct %>%. Keep it up!</span>
        </div>
    <% } %>
<% } %>

<!-- Overall stats -->
<div class="stats-grid">
    <div class="stat">
        <div class="lbl">Sessions</div>
        <div class="val"><%= totalCount %></div>
        <div class="sub">Total classes</div>
    </div>
    <div class="stat">
        <div class="lbl">Present</div>
        <div class="val" style="color:var(--success);"><%= presentCount %></div>
        <div class="sub">Attended</div>
    </div>
    <div class="stat">
        <div class="lbl">Absent</div>
        <div class="val" style="color:var(--danger);"><%= totalCount - presentCount %></div>
        <div class="sub">Missed</div>
    </div>
    <div class="stat">
        <div class="lbl">Overall %</div>
        <div class="val" style="color:<%= barColor %>;"><%= pct %>%</div>
        <div class="pbar"><div class="pfill" style="width:<%= pct %>%;background:<%= barColor %>;"></div></div>
        <div class="sub">75% required</div>
    </div>
</div>

<!-- Subject-wise breakdown -->
<div class="card">
    <div class="card-hdr">
        <h3><i class="fas fa-book-open" style="color:var(--accent);"></i> Subject-wise Attendance</h3>
        <span style="font-size:12px;color:var(--muted);"><%= typeof subjectStats !== 'undefined' ? subjectStats.length : 0 %> subject(s)</span>
    </div>
    <div class="card-body">
        <% if (typeof subjectStats !== 'undefined' && subjectStats.length > 0) { %>

            <!-- Visual cards -->
            <div class="subj-grid">
                <% subjectStats.forEach(function(s) {
                    var sc   = s.percentage >= 75 ? 't-ok' : (s.percentage >= 60 ? 't-risk' : 't-low');
                    var slbl = s.percentage >= 75 ? '✓ On Track' : (s.percentage >= 60 ? '⚠ At Risk' : '✗ Critical');
                    var sp   = s.percentage >= 75 ? 'var(--success)' : (s.percentage >= 60 ? 'var(--warning)' : 'var(--danger)');
                %>
                <div class="sc">
                    <div class="sn"><%= s.subject %></div>
                    <div class="sc2"><%= s.present %> present · <%= s.absent %> absent · <%= s.total %> total</div>
                    <div class="sp" style="color:<%= sp %>;"><%= s.percentage %>%</div>
                    <div class="pbar"><div class="pfill" style="width:<%= s.percentage %>%;background:<%= sp %>;"></div></div>
                    <span class="sc-tag <%= sc %>"><%= slbl %></span>
                </div>
                <% }); %>
            </div>

            <!-- Summary table -->
            <div class="tbl-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th style="text-align:center;">Present</th>
                            <th style="text-align:center;">Absent</th>
                            <th style="text-align:center;">Total</th>
                            <th>Percentage</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% subjectStats.forEach(function(s) {
                            var sc2  = s.percentage >= 75 ? 't-ok' : (s.percentage >= 60 ? 't-risk' : 't-low');
                            var slb2 = s.percentage >= 75 ? '✓ On Track' : (s.percentage >= 60 ? '⚠ At Risk' : '✗ Critical');
                            var sp2  = s.percentage >= 75 ? 'var(--success)' : (s.percentage >= 60 ? 'var(--warning)' : 'var(--danger)');
                        %>
                        <tr>
                            <td><strong><%= s.subject %></strong></td>
                            <td style="text-align:center;color:var(--success);font-weight:700;"><%= s.present %></td>
                            <td style="text-align:center;color:var(--danger);font-weight:700;"><%= s.absent %></td>
                            <td style="text-align:center;"><%= s.total %></td>
                            <td>
                                <div style="display:flex;align-items:center;gap:8px;">
                                    <strong style="color:<%= sp2 %>;min-width:42px;"><%= s.percentage %>%</strong>
                                    <div style="flex:1;max-width:70px;" class="pbar">
                                        <div class="pfill" style="width:<%= s.percentage %>%;background:<%= sp2 %>;"></div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="sc-tag <%= sc2 %>"><%= slb2 %></span></td>
                        </tr>
                        <% }); %>
                        <!-- Overall row -->
                        <tr class="tfoot-row">
                            <td><strong>OVERALL TOTAL</strong></td>
                            <td style="text-align:center;color:var(--success);font-weight:700;"><%= presentCount %></td>
                            <td style="text-align:center;color:var(--danger);font-weight:700;"><%= totalCount - presentCount %></td>
                            <td style="text-align:center;font-weight:700;"><%= totalCount %></td>
                            <td>
                                <div style="display:flex;align-items:center;gap:8px;">
                                    <strong style="color:<%= barColor %>;min-width:42px;"><%= pct %>%</strong>
                                    <div style="flex:1;max-width:70px;" class="pbar">
                                        <div class="pfill" style="width:<%= pct %>%;background:<%= barColor %>;"></div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="sc-tag <%= pct >= 75 ? 't-ok' : (pct >= 60 ? 't-risk' : 't-low') %>">
                                <%= pct >= 75 ? '✓ Good' : (pct >= 60 ? '⚠ At Risk' : '✗ Low') %>
                            </span></td>
                        </tr>
                    </tbody>
                </table>
            </div>

        <% } else { %>
            <div style="text-align:center;padding:40px 20px;color:var(--muted);">
                <i class="fas fa-book" style="font-size:2.5rem;opacity:.3;display:block;margin-bottom:10px;"></i>
                No attendance records found yet.
            </div>
        <% } %>
    </div>
</div>

<!-- Recent logs -->
<div class="card">
    <div class="card-hdr">
        <h3><i class="fas fa-clock" style="color:var(--accent);"></i> Recent Activity</h3>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <a href="/settings"           class="btn-sm btn-out"><i class="fas fa-cog"></i> Settings</a>
            <a href="/attendance-history" class="btn-sm btn-dark"><i class="fas fa-calendar-alt"></i> Full History</a>
        </div>
    </div>
    <div class="tbl-wrap">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Subject</th>
                    <th>Time Slot</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% if (records && records.length > 0) { %>
                    <% records.forEach(function(rec) {
                        var me = rec.students.find(function(s){ return s.studentId === user.rollNo; });
                    %>
                    <tr>
                        <td style="font-weight:600;white-space:nowrap;"><%= rec.date %></td>
                        <td><strong><%= rec.subject || '—' %></strong></td>
                        <td style="color:var(--muted);font-size:12px;white-space:nowrap;">
                            <i class="far fa-clock"></i> <%= rec.manualTime || 'N/A' %>
                        </td>
                        <td>
                            <% if (me) { %>
                                <span class="pill <%= me.status === 'Present' ? 'p-present' : 'p-absent' %>">
                                    <i class="fas fa-<%= me.status === 'Present' ? 'check' : 'times' %>"></i>
                                    <%= me.status %>
                                </span>
                            <% } else { %>
                                <span class="pill p-na">Not Marked</span>
                            <% } %>
                        </td>
                    </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="4" style="text-align:center;padding:50px;color:var(--muted);">
                        <i class="fas fa-folder-open" style="font-size:2rem;opacity:.3;display:block;margin-bottom:8px;"></i>
                        No records found for your roll number.
                    </td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
    <% if (records && records.length >= 50) { %>
        <div style="text-align:center;padding:12px;font-size:12px;color:var(--muted);border-top:1px solid var(--border);">
            Showing recent 50 entries. <a href="/attendance-history" style="color:var(--accent);font-weight:600;">View all →</a>
        </div>
    <% } %>
</div>

</body>
</html>
