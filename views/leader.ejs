<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leader Dashboard - Attendance</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        :root { --primary: #2c3e50; --accent: #3498db; --success: #27ae60; --danger: #e74c3c; }
        body { font-family: 'Segoe UI', sans-serif; background: #f4f7f6; padding: 20px; }
        .container { max-width: 1100px; margin: 0 auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; border-bottom: 2px solid #eee; padding-bottom: 15px; }
        .card { background: #fff; padding: 20px; border: 1px solid #ddd; border-radius: 8px; margin-bottom: 20px; }
        .grid-inputs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom: 15px; }
        input, select { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; box-sizing: border-box; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { padding: 12px; border: 1px solid #eee; text-align: left; }
        th { background: var(--primary); color: white; }
        .btn { padding: 12px 20px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; color: white; text-decoration: none; display: inline-block; }
        .btn-lock { background: var(--danger); width: 100%; margin-top: 15px; font-size: 16px; }
        .btn-history { background: var(--primary); }
        .checkbox-container { display: flex; align-items: center; justify-content: space-between; }
        .student-check { width: 20px; height: 20px; cursor: pointer; }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <div>
            <h1>Leader Attendance Portal</h1>
            <p>Welcome, <strong><%= user.name %></strong></p>
        </div>
        <div>
            <a href="/attendance-history" class="btn btn-history">📅 View History</a>
            <a href="/logout" style="color: var(--danger); margin-left: 15px; font-weight: bold; text-decoration: none;">Logout</a>
        </div>
    </div>

    <div class="card" style="background: #eef2f3; border-left: 5px solid var(--accent);">
        <h3>Quick Mark</h3>
        <div style="display: flex; gap: 10px;">
            <input type="text" id="quickInput" placeholder="Enter Roll Nos separated by commas (e.g., 101, 105, 110)">
            <button type="button" onclick="applyQuickMark()" class="btn" style="background: var(--accent);">Mark Present</button>
        </div>
    </div>

    <form action="/lock-attendance" method="POST">
        <div class="card">
            <div class="grid-inputs">
                <div>
                    <label>Lecturer Name</label>
                    <select name="lecturerEmail" required>
                        <option value="">-- Select Lecturer --</option>
                        <% allUsers.forEach(u => { %>
                            <% if (u.role === 'Lecturer') { %>
                                <option value="<%= u.email %>"><%= u.name %></option>
                            <% } %>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label>Time Slot</label>
                    <input type="text" name="manualTime" placeholder="e.g. 10:00 AM - 11:00 AM" required>
                </div>
                <div>
                    <label>Date</label>
                    <input type="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>" required>
                </div>
            </div>

            <label>Subject</label>
            <select name="subject" required style="margin-bottom: 20px;">
                <option value="">-- Choose Subject --</option>
                <% masterSubjects.forEach(sub => { %>
                    <% if (sub.name) { %>
                        <option value="<%= sub.name %>"><%= sub.name %></option>
                    <% } %>
                <% }) %>
            </select>

            <h3>Student Attendance List</h3>
            <table id="studentTable">
                <thead>
                    <tr>
                        <th>Roll No</th>
                        <th>Student Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% let studentIdx = 0; %>
                    <% allUsers.forEach(u => { %>
                        <% if (u.role !== 'Master' && u.role !== 'Lecturer' && u.role !== 'Admin') { %>
                            <tr>
                                <td><%= u.rollNo || u.rollno || 'N/A' %></td>
                                <td><%= u.name %></td>
                                <td>
                                    <div class="checkbox-container">
                                        <span>Mark Present</span>
                                        <input type="hidden" name="students[<%= studentIdx %>][id]" value="<%= u.rollNo || u.rollno %>">
                                        <input type="hidden" name="students[<%= studentIdx %>][name]" value="<%= u.name %>">
                                        <input type="checkbox" name="students[<%= studentIdx %>][status]" value="Present" class="student-check">
                                    </div>
                                </td>
                            </tr>
                            <% studentIdx++; %>
                        <% } %>
                    <% }) %>
                </tbody>
            </table>
            
            <button type="submit" class="btn btn-lock" onclick="return confirm('Confirm locking attendance for this period?')">Lock Period Attendance</button>
        </div>
    </form>
</div>

<script>
    // Quick Mark Logic
    function applyQuickMark() {
        const input = document.getElementById('quickInput').value.toLowerCase();
        const searchTerms = input.split(',').map(s => s.trim());
        const rows = document.querySelectorAll('#studentTable tbody tr');

        rows.forEach(row => {
            const rollNo = row.cells[0].innerText.toLowerCase();
            const name = row.cells[1].innerText.toLowerCase();
            const checkbox = row.querySelector('.student-check');

            if (searchTerms.some(term => (rollNo === term || name.includes(term)) && term !== "")) {
                checkbox.checked = true;
            }
        });
    }
</script>

</body>
</html>