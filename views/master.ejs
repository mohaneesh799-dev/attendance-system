<!DOCTYPE html>
<html>
<head>
    <title>Master Dashboard</title>
</head>
<body style="font-family: Arial; padding: 30px; background: #f4f4f4;">
    <nav style="background: #333; color: white; padding: 10px 20px; display: flex; justify-content: space-between; align-items: center;">
        <div><strong>Attendance System</strong></div>
        <div>
            <a href="/settings" style="color: white; margin-right: 15px; text-decoration: none;">⚙️ Settings</a>
            <a href="/logout" style="color: red; font-weight: bold; text-decoration: none;">Logout</a>
        </div>
    </nav>

    <div style="background: white; padding: 20px; border-radius: 10px; box-shadow: 0 0 10px rgba(0,0,0,0.1); margin-top: 20px;">
        <h1>Level 1: Master Control</h1>
        <hr>

        <div style="background: #fff; padding: 20px; border-radius: 10px; box-shadow: 0 0 10px rgba(0,0,0,0.1); margin-bottom: 30px;">
            <h3>📚 Manage Subjects (Timetable)</h3>
            <form action="/add-subject" method="POST" style="display: flex; gap: 10px; margin-bottom: 20px;">
                <input type="text" name="name" placeholder="Subject Name (e.g. OS)" required style="padding: 10px; flex: 2; border: 1px solid #ccc;">
                <input type="text" name="code" placeholder="Code (e.g. CE418)" required style="padding: 10px; flex: 1; border: 1px solid #ccc;">
                <button type="submit" style="background: #2ecc71; color: white; border: none; padding: 10px 20px; cursor: pointer; border-radius: 5px;">Add</button>
            </form>

            <table border="1" style="width: 100%; border-collapse: collapse; background: #fafafa;">
                <tr style="background: #eee;">
                    <th style="padding: 10px;">Subject Name</th>
                    <th style="padding: 10px;">Code</th>
                    <th style="padding: 10px;">Action</th>
                </tr>
                <% subjects.forEach(sub => { %>
                    <tr>
                        <td style="padding: 10px;"><%= sub.name %></td>
                        <td style="padding: 10px; text-align: center;"><%= sub.code %></td>
                        <td style="padding: 10px; text-align: center;">
                            <form action="/delete-subject/<%= sub._id %>" method="POST" style="display:inline;">
                                <button type="submit" onclick="return confirm('Delete this subject?')" style="background: none; border: none; color: red; cursor: pointer;">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </table>
        </div>

        <hr>

        <div style="background: #fff; padding: 20px; border-radius: 10px; box-shadow: 0 0 10px rgba(0,0,0,0.1); margin-top: 20px;">
            <h3>📤 Upload Student Master List</h3>
            <p style="font-size: 0.9em; color: #666;">Upload a CSV with headers: <strong>rollNo, name, email</strong></p>
            <form action="/upload-students" method="POST" enctype="multipart/form-data">
                <input type="file" name="studentFile" accept=".csv" required style="margin-bottom: 10px;">
                <br>
                <button type="submit" style="background: #3498db; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer;">
                    Upload & Sync Students
                </button>
            </form>
        </div>

        <hr>

        <div style="background: white; padding: 20px; border-radius: 10px; box-shadow: 0 0 10px rgba(0,0,0,0.1); margin-top: 20px;">
            <h3>👥 User Management (Total Users: <%= allUsers.length %>)</h3>
            <table border="1" style="width:100%; border-collapse: collapse; text-align: left;">
                <tr style="background-color: #f2f2f2;">
                    <th style="padding: 12px;">Name</th>
                    <th style="padding: 12px;">Email</th>
                    <th style="padding: 12px;">Current Role</th>
                    <th style="padding: 12px;">Status</th>
                    <th style="padding: 12px;">Actions</th>
                </tr>
                <% allUsers.forEach(user => { %>
                    <tr style="border-bottom: 1px solid #eee;">
                        <td style="padding: 10px;"><%= user.name || 'N/A' %></td>
                        <td style="padding: 10px;"><%= user.email %></td>
                        <td style="padding: 10px;">
                            <span style="padding: 4px 8px; border-radius: 4px; background: #e8f4fd; font-size: 0.9em;">
                                <%= user.role %>
                            </span>
                        </td>
                        <td style="padding: 10px;">
                            <% if (user.isApproved) { %>
                                <span style="color: green; font-weight: bold;">✓ Approved</span>
                            <% } else { %>
                                <span style="color: orange; font-weight: bold;">⌛ Pending</span>
                            <% } %>
                        </td>
                        <td style="padding: 10px;">
                            <div style="display: flex; gap: 10px; align-items: center;">
                                <% if (!user.isApproved) { %>
                                    <form action="/approve-user/<%= user._id %>" method="POST" style="display: flex; gap: 5px;">
                                        <select name="role" style="padding: 5px; border-radius: 3px;">
                                            <option value="Student">Student</option>
                                            <option value="Leader">Leader</option>
                                            <option value="Lecturer">Lecturer</option>

                                        </select>
                                        <button type="submit" style="background: #2ecc71; color: white; border: none; padding: 5px 10px; border-radius: 3px; cursor: pointer;">Approve</button>
                                    </form>
                                <% } %>

                                <form action="/delete-user/<%= user._id %>" method="POST" onsubmit="return confirm('Permanently delete this user?');">
                                    <button type="submit" style="background: #e74c3c; color: white; border: none; padding: 5px 10px; border-radius: 3px; cursor: pointer;">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </table>
        </div>
    </div>
</body>
</html>