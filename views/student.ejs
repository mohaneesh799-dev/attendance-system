<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Attendance Portal</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        :root { --primary: #34495e; --accent: #3498db; --success: #27ae60; --danger: #e74c3c; }
        body { font-family: 'Segoe UI', sans-serif; background-color: #f8f9fa; margin: 0; padding: 20px; }
        .dashboard-container { max-width: 900px; margin: 0 auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #eee; padding-bottom: 15px; margin-bottom: 25px; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .stat-card { padding: 20px; border-radius: 8px; text-align: center; color: white; }
        .stat-total { background: var(--primary); }
        .stat-present { background: var(--success); }
        .stat-percentage { background: var(--accent); }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { padding: 15px; text-align: left; border-bottom: 1px solid #eee; }
        th { background-color: #fcfcfc; color: var(--primary); font-weight: 600; }
        .badge { padding: 6px 12px; border-radius: 20px; font-size: 13px; font-weight: bold; }
        .badge-present { background: #d4edda; color: #155724; }
        .badge-absent { background: #f8d7da; color: #721c24; }
    </style>
</head>
<body>

<div class="dashboard-container">
    <div class="header">
        <div>
            <h1>My Attendance</h1>
            <p>Student: <strong><%= user.name %></strong> (<%= user.email %>)</p>
        </div>
        <div class="nav-links">
            <a href="/settings" style="text-decoration: none; color: var(--accent); margin-right: 15px;">Settings</a>
            <a href="/logout" style="text-decoration: none; color: var(--danger);">Logout</a>
        </div>
    </div>

    <% 
        // Logic to calculate summary stats from attendanceRecords
        let totalClasses = attendanceRecords.length;
        let presentCount = 0;
        attendanceRecords.forEach(record => {
            const me = record.students.find(s => s.studentName === user.name);
            if (me && me.status === 'Present') presentCount++;
        });
        let percentage = totalClasses > 0 ? ((presentCount / totalClasses) * 100).toFixed(1) : 0;
    %>

    <div class="stats-grid">
        <div class="stat-card stat-total">
            <h3><%= totalClasses %></h3>
            <p>Total Classes</p>
        </div>
        <div class="stat-card stat-present">
            <h3><%= presentCount %></h3>
            <p>Days Present</p>
        </div>
        <div class="stat-card stat-percentage">
            <h3><%= percentage %>%</h3>
            <p>Attendance Rate</p>
        </div>
    </div>

    <h3>Detailed Attendance History</h3>
    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Subject</th>
                <th>Period</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <% if (attendanceRecords.length > 0) { %>
                <% attendanceRecords.forEach(record => { 
                    // Find the specific entry for this student in the students array
                    const myEntry = record.students.find(s => s.studentName === user.name);
                %>
                    <tr>
                        <td><%= record.date %></td>
                        <td><%= record.subject %></td>
                        <td>Period <%= record.periodNumber %></td>
                        <td>
                            <span class="badge <%= (myEntry && myEntry.status === 'Present') ? 'badge-present' : 'badge-absent' %>">
                                <%= myEntry ? myEntry.status : 'Absent' %>
                            </span>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="4" style="text-align: center; color: #888; padding: 40px;">No attendance records found yet.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

</body>
</html>