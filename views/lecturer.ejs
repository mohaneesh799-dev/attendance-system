<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lecturer Portal — <%= user.name %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --primary: #2c3e50; --accent: #3498db; --success: #27ae60; --danger: #e74c3c; --bg: #f4f7f6; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: var(--bg); margin: 0; padding: 20px; color: #333; }
        .container { max-width: 1100px; margin: 0 auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; border-bottom: 2px solid #eee; padding-bottom: 15px; flex-wrap: wrap; gap: 10px; }
        .header h1 { margin: 0; font-size: 1.8rem; color: var(--primary); }
        .section-badge { background: var(--accent); color: white; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: bold; text-transform: uppercase; }
        .division-badge { background: #8e44ad; color: white; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: bold; text-transform: uppercase; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: #fff; padding: 20px; border-radius: 10px; border-left: 5px solid var(--accent); box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
        .stat-card small { color: #7f8c8d; text-transform: uppercase; font-weight: 600; font-size: 12px; display: block; }
        .stat-card span { font-size: 28px; font-weight: 800; color: var(--primary); margin-top: 5px; display: block; }
        .division-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }
        .tab-btn { padding: 8px 18px; border: 2px solid #ddd; border-radius: 20px; cursor: pointer; font-weight: 600; font-size: 13px; background: white; color: #555; transition: 0.2s; }
        .tab-btn.active, .tab-btn:hover { background: var(--accent); color: white; border-color: var(--accent); }
        .record-card { margin-top: 20px; border: 1px solid #e0e0e0; border-radius: 10px; overflow: hidden; }
        .record-card:hover { border-color: var(--accent); }
        .record-header { background: #f8f9fa; padding: 18px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
        table { width: 100%; border-collapse: collapse; background: white; }
        th { background: #f1f2f6; color: #57606f; font-size: 13px; text-transform: uppercase; text-align: left; padding: 12px 15px; border-bottom: 2px solid #ddd; }
        td { padding: 12px 15px; border-bottom: 1px solid #eee; font-size: 14px; }
        .status-badge { padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: bold; text-transform: uppercase; }
        .status-badge.Present { background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9; }
        .status-badge.Absent { background: #ffebee; color: #c62828; border: 1px solid #ffcdd2; }
        .btn { padding: 10px 18px; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: 0.3s; font-size: 14px; }
        .btn-history { background: var(--primary); color: white; }
        .btn-history:hover { background: #1a252f; }
        .btn-logout { background: #fdf0f0; color: var(--danger); border: 1px solid #f9d6d6; }
        .btn-logout:hover { background: var(--danger); color: white; }
        .btn-refresh { background: #f0f7ff; color: var(--accent); border: 1px solid #d0e8ff; }
        .btn-master { background: #f3e5f5; color: #8e44ad; border: 1px solid #e1bee7; }
        .btn-master:hover { background: #8e44ad; color: white; }
        .info-banner { background: #e8f4fd; border-left: 4px solid var(--accent); padding: 12px 18px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; color: #2471a3; }
        .division-group { margin-bottom: 30px; }
        .division-header { display: flex; align-items: center; gap: 12px; margin-bottom: 15px; padding-bottom: 10px; border-bottom: 2px solid #f0f0f0; }
        .division-title { font-size: 1.1rem; font-weight: 700; color: var(--primary); }
        .hidden { display: none; }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <div>
            <h1><i class="fas fa-chalkboard-teacher"></i> Lecturer Portal</h1>
            <p style="margin-top: 5px; color: #7f8c8d;">Welcome back, <strong style="color: var(--primary);"><%= user.name %></strong></p>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <% if (user.isClassTeacher) { %>
                <a href="/master" class="btn btn-master"><i class="fas fa-shield-alt"></i> Class Teacher Panel (<%= user.classTeacherSection %>)</a>
            <% } %>
            <button onclick="location.reload()" class="btn btn-refresh"><i class="fas fa-sync-alt"></i> Refresh</button>
            <a href="/settings" class="btn btn-refresh"><i class="fas fa-cog"></i> Settings</a>
            <a href="/attendance-history" class="btn btn-history"><i class="fas fa-history"></i> History</a>
            <a href="/logout" class="btn btn-logout"><i class="fas fa-power-off"></i> Logout</a>
        </div>
    </div>

    <% if (user.isClassTeacher) { %>
        <div class="info-banner">
            <i class="fas fa-star"></i> You are the <strong>Class Teacher</strong> for Division <strong><%= user.classTeacherSection %></strong>.
            Use the <strong>Class Teacher Panel</strong> button to manage students and subjects for that division.
        </div>
    <% } %>

    <div class="stats-grid">
        <div class="stat-card">
            <small>Divisions Teaching Today</small>
            <span><%= sectionsToday && sectionsToday.length > 0 ? sectionsToday.length : 0 %></span>
        </div>
        <div class="stat-card" style="border-left-color: var(--success);">
            <small>Today's Total Classes</small>
            <span><%= todayRecords ? todayRecords.length : 0 %></span>
        </div>
        <div class="stat-card" style="border-left-color: #f1c40f;">
            <small>Total Present Today</small>
            <span>
                <%= todayRecords ? todayRecords.reduce(function(s,r){ return s + (r.students||[]).filter(function(x){ return x.status==='Present'; }).length; }, 0) : 0 %>
            </span>
        </div>
    </div>

    <div class="main-body">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <h3 style="margin: 0; color: var(--primary);">Today's Attendance Logs — All Divisions</h3>
            <span class="section-badge">Live Updates</span>
        </div>
        <p style="font-size: 14px; color: #7f8c8d; margin-top: 8px;">
            Attendance submitted across all divisions where you are the assigned lecturer today.
        </p>

        <% if (todayRecords && todayRecords.length > 0) { %>
            <%
                var grouped = {};
                todayRecords.forEach(function(r) {
                    var sec = r.section || 'Unknown';
                    if (!grouped[sec]) grouped[sec] = [];
                    grouped[sec].push(r);
                });
                var divKeys = Object.keys(grouped).sort();
            %>
            <div class="division-tabs">
                <button class="tab-btn active" onclick="showDivision('all', this)">All Divisions</button>
                <% divKeys.forEach(function(sec) { %>
                    <button class="tab-btn" onclick="showDivision('<%= sec %>', this)"><%= sec %></button>
                <% }); %>
            </div>

            <% divKeys.forEach(function(sec) { %>
                <div class="division-group" data-division="<%= sec %>">
                    <div class="division-header">
                        <span class="division-badge"><%= sec %></span>
                        <span class="division-title"><%= grouped[sec].length %> class<%= grouped[sec].length > 1 ? 'es' : '' %> today</span>
                    </div>
                    <% grouped[sec].forEach(function(record) { %>
                        <div class="record-card">
                            <div class="record-header">
                                <div>
                                    <span class="section-badge" style="background: #57606f;"><%= record.subject %></span>
                                    <span style="margin-left: 10px; font-weight: 600;"><i class="far fa-clock"></i> <%= record.manualTime %></span>
                                </div>
                                <div style="font-size: 14px;">
                                    <strong>Date:</strong> <%= record.date %> &nbsp;|&nbsp;
                                    <span class="status-badge Present" style="margin-left: 5px;">
                                        <%= (record.students||[]).filter(function(s){ return s.status==='Present'; }).length %> Present
                                    </span>
                                    <span class="status-badge Absent" style="margin-left: 5px;">
                                        <%= (record.students||[]).filter(function(s){ return s.status==='Absent'; }).length %> Absent
                                    </span>
                                </div>
                            </div>
                            <div style="max-height: 350px; overflow-y: auto;">
                                <table>
                                    <thead>
                                        <tr><th>Roll No</th><th>Student Name</th><th>Status</th></tr>
                                    </thead>
                                    <tbody>
                                        <% if (record.students && record.students.length > 0) { %>
                                            <% record.students.forEach(function(student) { %>
                                                <tr>
                                                    <td style="font-family: monospace; font-weight: bold; color: var(--accent);"><%= student.studentId || 'N/A' %></td>
                                                    <%# FIX: Schema stores studentName not name. Was student.name || student.studentName (name is always undefined). %>
                                                    <td><%= student.studentName || 'Unknown' %></td>
                                                    <td><span class="status-badge <%= student.status %>"><%= student.status %></span></td>
                                                </tr>
                                            <% }); %>
                                        <% } else { %>
                                            <tr><td colspan="3" style="text-align:center;color:#999;padding:20px;">No students listed.</td></tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% }); %>

        <% } else { %>
            <div style="text-align: center; padding: 60px 20px; color: #7f8c8d; background: #fff; border: 2px dashed #ddd; border-radius: 12px; margin-top: 20px;">
                <i class="fas fa-clipboard-list" style="font-size: 3rem; margin-bottom: 15px; opacity: 0.3;"></i>
                <p style="font-size: 1.1rem; margin-bottom: 20px;">No attendance records submitted for your classes today.</p>
                <a href="/attendance-history" style="color: var(--accent); font-weight: 600; text-decoration: underline;">View previous logs in history</a>
            </div>
        <% } %>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    function showDivision(division, btn) {
        document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        document.querySelectorAll('.division-group').forEach(function(group) {
            group.classList.toggle('hidden', division !== 'all' && group.dataset.division !== division);
        });
    }
    // Expose to onclick attributes in EJS-generated markup
    window.showDivision = showDivision;
});
</script>
</body>
</html>
