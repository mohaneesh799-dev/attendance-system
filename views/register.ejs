<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Critical Access — Super Admin Registration</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *{box-sizing:border-box;margin:0;padding:0;}
        body{
            background:linear-gradient(135deg,#134e4a 0%,#0f766e 50%,#1e1b4b 100%);
            min-height:100vh;display:flex;align-items:center;justify-content:center;
            font-family:'Plus Jakarta Sans',sans-serif;padding:20px;
        }
        .register-card{
            background:#fff;padding:40px;border-radius:20px;
            box-shadow:0 24px 60px rgba(0,0,0,.38);width:100%;max-width:460px;
            border-top:5px solid #dc2626;
        }
        .shield-icon{font-size:2.8rem;color:#dc2626;margin-bottom:14px;text-align:center;}
        h3{text-align:center;font-size:1.3rem;font-weight:800;margin-bottom:4px;}
        .subtitle{text-align:center;color:#6b7280;font-size:.85rem;margin-bottom:24px;}

        .alert-danger{background:#fff0f0;color:#b91c1c;border:1px solid #fecaca;border-radius:10px;padding:11px 14px;font-size:13px;display:flex;align-items:center;gap:8px;margin-bottom:18px;}

        .security-note{font-size:.78rem;background:#fff8f8;color:#b91c1c;padding:12px 14px;border-radius:10px;border:1px solid #fecaca;margin-bottom:22px;display:flex;align-items:flex-start;gap:8px;line-height:1.6;}

        .mb-3{margin-bottom:16px;}
        .form-label{display:block;font-size:11.5px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px;}
        .input-group{display:flex;border-radius:10px;overflow:hidden;border:1.5px solid #e5e7eb;transition:.2s;}
        .input-group:focus-within{border-color:#0d9488;box-shadow:0 0 0 3px rgba(13,148,136,.12);}
        .input-group-text{background:#f3f4f6;border:none;padding:0 13px;display:flex;align-items:center;color:#9ca3af;font-size:14px;flex-shrink:0;}
        .input-group-text.bg-danger-custom{background:#dc2626;color:#fff;}
        .form-control{flex:1;border:none;padding:11px 13px;font-size:14px;font-family:inherit;background:#f9fafb;color:#111827;outline:none;}
        .form-text{font-size:11.5px;color:#9ca3af;margin-top:5px;display:block;}

        .btn-admin{
            width:100%;padding:13px;border:none;border-radius:12px;
            background:linear-gradient(135deg,#0f766e,#134e4a);color:#fff;
            font-size:15px;font-weight:700;cursor:pointer;transition:.2s;font-family:inherit;
            display:flex;align-items:center;justify-content:center;gap:8px;
        }
        .btn-admin:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(15,118,110,.35);}

        .back-link{display:block;text-align:center;margin-top:22px;font-size:13px;color:#6b7280;text-decoration:none;font-weight:600;}
        .back-link:hover{color:#0d9488;}

        @media(max-width:480px){.register-card{padding:28px 20px;}}
    </style>
</head>
<body>
<div class="register-card">
    <div class="shield-icon"><i class="fas fa-user-shield"></i></div>
    <h3>Super Admin Registration</h3>
    <p class="subtitle">Elevated System Management Portal</p>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-danger"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>

    <div class="security-note">
        <i class="fas fa-exclamation-triangle" style="flex-shrink:0;margin-top:2px;"></i>
        <span><strong>Security Alert:</strong> All Super Admin registrations are logged. Unauthorized attempts will result in account suspension.</span>
    </div>

    <form action="/register-super-admin" method="POST">
        <div class="mb-3">
            <label class="form-label">Full Name</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-user"></i></span>
                <input type="text" name="name" class="form-control" placeholder="Admin Name" required>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">System Email</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                <input type="email" name="email" class="form-control" placeholder="admin@rku.ac.in" required autocomplete="email">
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Create Password</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                <input type="password" name="password" class="form-control" placeholder="Min. 8 characters" required minlength="8" autocomplete="new-password">
            </div>
        </div>
        <div class="mb-3" style="margin-bottom:22px;">
            <label class="form-label" style="color:#dc2626;">Master Security Key</label>
            <div class="input-group">
                <span class="input-group-text bg-danger-custom"><i class="fas fa-key"></i></span>
                <input type="password" name="masterKey" class="form-control" placeholder="Enter system secret key" required autocomplete="off">
            </div>
            <span class="form-text">Ask the System Owner for this key.</span>
        </div>
        <input type="hidden" name="role" value="SuperAdmin">
        <button type="submit" class="btn-admin"><i class="fas fa-shield-check"></i> Initialize Admin Account</button>
    </form>

    <a href="/login" class="back-link"><i class="fas fa-arrow-left"></i> Return to Secure Login</a>
</div>
</body>
</html>
