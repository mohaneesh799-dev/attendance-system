<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Super Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --sidebar-width: 250px; }
        body { background-color: #f4f7f6; }
        .sidebar { width: var(--sidebar-width); height: 100vh; position: fixed; background: #2c3e50; color: white; padding-top: 20px; }
        .main-content { margin-left: var(--sidebar-width); padding: 20px; }
        .stat-card { border: none; border-radius: 10px; transition: transform 0.3s; }
        .stat-card:hover { transform: translateY(-5px); }
        .table-container { background: white; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .badge-master { background-color: #e67e22; }
        .badge-student { background-color: #3498db; }
    </style>
</head>
<body>

    <div class="sidebar d-flex flex-column p-3">
        <h4><i class="fas fa-user-shield me-2"></i> Super Admin</h4>
        <hr>
        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item"><a href="#" class="nav-link text-white active"><i class="fas fa-chart-line me-2"></i> Overview</a></li>
            <li><a href="/attendance-history" class="nav-link text-white"><i class="fas fa-history me-2"></i> All History</a></li>
            <li><a href="/logout" class="nav-link text-white mt-5"><i class="fas fa-sign-out-alt me-2"></i> Logout</a></li>
        </ul>
    </div>

    <div class="main-content">
        <header class="d-flex justify-content-between align-items-center mb-4">
            <h2>System Overview</h2>
            <span class="badge bg-dark p-2">Logged in as: <%= user.email %></span>
        </header>

        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card stat-card bg-primary text-white p-3">
                    <div class="d-flex justify-content-between">
                        <div><h5>Total Users</h5><h3><%= allUsers.length %></h3></div>
                        <i class="fas fa-users fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card stat-card bg-success text-white p-3">
                    <div class="d-flex justify-content-between">
                        <div><h5>Subjects</h5><h3><%= allSubjects.length %></h3></div>
                        <i class="fas fa-book fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card stat-card bg-warning text-white p-3">
                    <div class="d-flex justify-content-between">
                        <div><h5>Sections</h5><h3><%= [...new Set(allUsers.map(u => u.section))].length %></h3></div>
                        <i class="fas fa-layer-group fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-container">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>User Management (Global)</h4>
                <div class="input-group w-25">
                    <input type="text" id="userSearch" class="form-control" placeholder="Search by name/email...">
                </div>
            </div>
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Section</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="userTableBody">
                    <% allUsers.forEach(u => { %>
                    <tr>
                        <td><%= u.name %></td>
                        <td><%= u.email %></td>
                        <td><span class="badge <%= u.role === 'Master' ? 'badge-master' : 'badge-student' %>"><%= u.role %></span></td>
                        <td><strong><%= u.section || 'N/A' %></strong></td>
                        <td>
                            <% if(u.isApproved) { %>
                                <span class="text-success"><i class="fas fa-check-circle"></i> Approved</span>
                            <% } else { %>
                                <span class="text-danger"><i class="fas fa-clock"></i> Pending</span>
                            <% } %>
                        </td>
                        <td>
                            <div class="btn-group">
                                <form action="/delete-user/<%= u._id %>" method="POST" onsubmit="return confirm('Delete this user?')">
                                    <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                </form>
                                <a href="/edit-user/<%= u._id %>" class="btn btn-sm btn-outline-primary ms-1"><i class="fas fa-edit"></i></a>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        // Simple search filter
        document.getElementById('userSearch').addEventListener('keyup', function() {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll('#userTableBody tr');
            rows.forEach(row => {
                let text = row.innerText.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    </script>
</body>
</html>