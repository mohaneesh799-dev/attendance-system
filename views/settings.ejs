<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Account Settings — RKU</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<script>(function(){var t=localStorage.getItem('rku-theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
<style>
:root{
  --pri:#0d1b3e;--pri2:#162d5a;
  --acc:#4f7ef7;--acc2:#2563eb;
  --suc:#10b981;--dan:#ef4444;--war:#f59e0b;
  --bg:#f0f4fb;--card:#fff;--border:#e4eaf4;
  --text:#0e1526;--muted:#64748b;
  --input-bg:#f6f9ff;--input-bd:#d4daea;
  --shadow:0 4px 24px rgba(14,21,38,.09);
  --radius:16px;--radius-sm:10px;
}
[data-theme="dark"]{
  --bg:#080e1d;--card:#0e1828;--border:#172035;
  --text:#cdd9ee;--muted:#5e7898;
  --input-bg:#0a1120;--input-bd:#1b2d4a;
  --shadow:0 4px 28px rgba(0,0,0,.45);
  --pri:#060e20;--pri2:#0d1b36;
  --acc:#6b93fa;--acc2:#4f7ef7;
  --suc:#34d399;--dan:#f87171;--war:#fbbf24;
}
*{box-sizing:border-box;margin:0;padding:0;}
html,body{transition:background .25s,color .25s;}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;padding:20px 16px 50px;}

.page{max-width:620px;margin:0 auto;}

/* ── TOP BAR ── */
.topnav{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:24px;flex-wrap:wrap;gap:10px;
}
.back-link{
  display:inline-flex;align-items:center;gap:8px;
  background:var(--card);border:1.5px solid var(--border);
  color:var(--text);text-decoration:none;padding:9px 15px;
  border-radius:var(--radius-sm);font-size:13px;font-weight:700;
  box-shadow:var(--shadow);transition:.2s;
}
.back-link:hover{border-color:var(--acc);color:var(--acc);}
.page-title{font-size:1.2rem;font-weight:900;letter-spacing:-.3px;}

/* ── ALERT ── */
.msg{display:flex;align-items:center;gap:10px;padding:13px 16px;border-radius:var(--radius-sm);font-size:13.5px;font-weight:500;margin-bottom:18px;}
.msg.ok{background:rgba(16,185,129,.08);color:#047857;border:1px solid rgba(16,185,129,.2);border-left:4px solid var(--suc);}
.msg.err{background:rgba(239,68,68,.07);color:#b91c1c;border:1px solid rgba(239,68,68,.18);border-left:4px solid var(--dan);}
[data-theme="dark"] .msg.ok{background:rgba(16,185,129,.1);color:var(--suc);}
[data-theme="dark"] .msg.err{background:rgba(239,68,68,.1);color:var(--dan);}

/* ── CARD ── */
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);margin-bottom:16px;overflow:hidden;}
.card-hdr{padding:18px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:13px;}
.card-icon{width:40px;height:40px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;}
.ic-blue{background:rgba(79,126,247,.12);color:var(--acc);}
.ic-purple{background:rgba(139,92,246,.12);color:#8b5cf6;}
.ic-green{background:rgba(16,185,129,.12);color:var(--suc);}
.card-hdr-text h3{font-size:.95rem;font-weight:800;margin:0;}
.card-hdr-text p{font-size:12px;color:var(--muted);margin-top:3px;}
.card-body{padding:22px;}

/* ── FORM ── */
.fg{margin-bottom:17px;}
.fg label{display:block;font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:7px;}
.fc{
  width:100%;padding:11px 14px;border-radius:var(--radius-sm);border:1.5px solid var(--input-bd);
  font-size:14px;font-family:inherit;background:var(--input-bg);color:var(--text);
  outline:none;transition:.2s;
}
.fc:focus{border-color:var(--acc);background:var(--card);box-shadow:0 0 0 3px rgba(79,126,247,.12);}
.fc[readonly]{opacity:.55;cursor:not-allowed;}
.divider{border:none;border-top:1px solid var(--border);margin:20px 0;}

.btn-save{
  width:100%;padding:13px;border:none;border-radius:var(--radius-sm);
  font-size:15px;font-weight:800;cursor:pointer;transition:.2s;
  background:linear-gradient(135deg,var(--acc),var(--acc2));color:#fff;
  display:flex;align-items:center;justify-content:center;gap:9px;
  letter-spacing:-.2px;
}
.btn-save:hover{transform:translateY(-2px);box-shadow:0 6px 24px rgba(79,126,247,.35);}
.btn-save:active{transform:scale(.98);}

/* ── THEME SECTION ── */
.theme-row{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 12px;border-radius:var(--radius-sm);cursor:pointer;transition:.18s;
  border:1.5px solid transparent;margin-bottom:8px;
}
.theme-row:hover{background:rgba(79,126,247,.04);}
[data-theme="light"] .theme-row[data-for="light"]{background:rgba(79,126,247,.07);border-color:rgba(79,126,247,.22);}
[data-theme="dark"]  .theme-row[data-for="dark"] {background:rgba(79,126,247,.07);border-color:rgba(79,126,247,.22);}
.theme-info{display:flex;align-items:center;gap:13px;}
.theme-emoji{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;}
.te-sun{background:#fef9c3;}
.te-moon{background:#1e1b4b;}
.t-label{font-weight:700;font-size:14px;}
.t-desc{font-size:12px;color:var(--muted);margin-top:3px;}
.active-tag{font-size:11px;font-weight:700;padding:4px 10px;border-radius:20px;}
.at-light{background:#fef3c7;color:#92400e;}
.at-dark{background:rgba(107,147,250,.15);color:var(--acc);}
#lightTag{display:none;}
#darkTag{display:none;}
[data-theme="light"] #lightTag{display:inline-block;}
[data-theme="dark"]  #darkTag {display:inline-block;}

/* ── TOGGLE ── */
.tog-row{display:flex;align-items:center;gap:12px;padding-top:16px;border-top:1px solid var(--border);margin-top:14px;}
.tog-row span{font-size:13px;font-weight:600;color:var(--muted);}
.tog{width:52px;height:28px;border-radius:14px;border:none;cursor:pointer;background:#d1d5db;position:relative;transition:background .25s;outline:none;flex-shrink:0;}
.tog::after{content:'';position:absolute;width:22px;height:22px;background:#fff;border-radius:50%;top:3px;left:3px;transition:transform .25s;box-shadow:0 1px 4px rgba(0,0,0,.25);}
.tog.on{background:var(--acc);}
.tog.on::after{transform:translateX(24px);}
#themeStatus{margin-left:auto;font-size:12px;color:var(--muted);}

/* ── INFO CHIPS ── */
.info-chip{
  display:inline-flex;align-items:center;gap:6px;padding:5px 12px;
  border-radius:20px;font-size:12px;font-weight:700;
  background:rgba(79,126,247,.1);color:var(--acc);
  border:1px solid rgba(79,126,247,.2);
}

@media(max-width:480px){
  .card-body,.card-hdr{padding:16px;}
}
</style>
</head>
<body>
<div class="page">

  <%
    var _activeR = (typeof activeRole !== 'undefined' ? activeRole : user.role) || 'student';
    var _backPath = {
      'superadmin':'/super-admin-dashboard',
      'master':'/master',
      'lecturer':'/lecturer',
      'leader':'/leader',
      'student':'/student'
    }[_activeR.toLowerCase()] || '/login';
  %>

  <div class="topnav">
    <a href="<%= _backPath %>" class="back-link">
      <i class="fas fa-arrow-left"></i> Back to Dashboard
    </a>
    <span class="page-title">Account Settings</span>
  </div>

  <% if (typeof message !== 'undefined' && message) { %>
    <div class="msg <%= messageType === 'success' ? 'ok' : 'err' %>">
      <i class="fas fa-<%= messageType === 'success' ? 'circle-check' : 'circle-exclamation' %>"></i>
      <%= message %>
    </div>
  <% } %>

  <!-- Profile Card -->
  <div class="card">
    <div class="card-hdr">
      <div class="card-icon ic-blue"><i class="fas fa-user-circle"></i></div>
      <div class="card-hdr-text">
        <h3>Profile Information</h3>
        <p>Update your name, phone and password</p>
      </div>
    </div>
    <div class="card-body">
      <form action="/update-settings" method="POST">
        <div class="fg">
          <label>Full Name</label>
          <input type="text" name="name" class="fc" value="<%= user.name %>" required>
        </div>
        <div class="fg">
          <label>Email Address</label>
          <input type="email" class="fc" value="<%= user.email %>" readonly>
        </div>
        <div class="fg">
          <label>WhatsApp / Phone</label>
          <input type="text" name="phone" class="fc" value="<%= user.phone || '' %>" placeholder="e.g. 919876543210">
        </div>
        <div class="fg">
          <label>Active Role</label>
          <input type="text" class="fc" value="<%= typeof activeRole !== 'undefined' ? activeRole : user.role %>" readonly>
        </div>
        <% var _allRoles = (user.roles && user.roles.length > 0) ? user.roles : [user.role]; %>
        <% if (_allRoles.length > 1) { %>
        <div class="fg">
          <label>All Your Roles</label>
          <div style="display:flex;flex-wrap:wrap;gap:7px;padding:10px 12px;background:var(--input-bg);border:1.5px solid var(--input-bd);border-radius:var(--radius-sm);">
            <% _allRoles.forEach(function(r){ %>
              <span class="info-chip"><%= r %></span>
            <% }); %>
          </div>
          <small style="color:var(--muted);font-size:11px;margin-top:6px;display:block;">Use the role switcher in your dashboard sidebar to switch roles.</small>
        </div>
        <% } %>
        <% if (user.section) { %>
        <div class="fg">
          <label>Division / Section</label>
          <input type="text" class="fc" value="<%= user.section %>" readonly>
        </div>
        <% } %>
        <hr class="divider">
        <div style="font-size:.8rem;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:16px;display:flex;align-items:center;gap:7px;">
          <i class="fas fa-lock"></i> Change Password
        </div>
        <% if (user.googleId && !user.password) { %>
          <div class="msg ok" style="margin-bottom:14px;">
            <i class="fas fa-circle-info"></i> You signed in with Google — password change is not available.
          </div>
        <% } else { %>
          <div class="fg">
            <label>Current Password</label>
            <input type="password" name="currentPassword" class="fc" placeholder="Required to save changes">
          </div>
          <div class="fg">
            <label>New Password <span style="font-weight:400;text-transform:none;">(leave blank to keep current)</span></label>
            <input type="password" name="newPassword" class="fc" placeholder="Min. 6 characters">
          </div>
        <% } %>
        <button type="submit" class="btn-save">
          <i class="fas fa-floppy-disk"></i> Save Changes
        </button>
      </form>
    </div>
  </div>

  <!-- Appearance Card -->
  <div class="card">
    <div class="card-hdr">
      <div class="card-icon ic-purple"><i class="fas fa-palette"></i></div>
      <div class="card-hdr-text">
        <h3>Appearance</h3>
        <p>Choose your preferred interface theme</p>
      </div>
    </div>
    <div class="card-body">
      <style>
        [data-theme="light"] .theme-row[data-for="light"],
        [data-theme="dark"]  .theme-row[data-for="dark"]  {
          background: rgba(79,126,247,.07);
          border-color: rgba(79,126,247,.22);
        }
      </style>

      <div class="theme-row" data-for="light" onclick="setTheme('light')">
        <div class="theme-info">
          <div class="theme-emoji te-sun">☀️</div>
          <div>
            <div class="t-label">Light Mode</div>
            <div class="t-desc">Clean white background — ideal for daytime</div>
          </div>
        </div>
        <span class="active-tag at-light" id="lightTag">Active</span>
      </div>

      <div class="theme-row" data-for="dark" onclick="setTheme('dark')">
        <div class="theme-info">
          <div class="theme-emoji te-moon">🌙</div>
          <div>
            <div class="t-label">Dark Mode</div>
            <div class="t-desc">Deep blue-dark — reduces eye strain at night</div>
          </div>
        </div>
        <span class="active-tag at-dark" id="darkTag">Active</span>
      </div>

      <div class="tog-row">
        <span>☀️ Light</span>
        <button class="tog" id="themeToggle" type="button" aria-label="Toggle dark mode"></button>
        <span>🌙 Dark</span>
        <span id="themeStatus"></span>
      </div>
    </div>
  </div>

  <!-- Account Info -->
  <div class="card">
    <div class="card-hdr">
      <div class="card-icon ic-green"><i class="fas fa-shield-halved"></i></div>
      <div class="card-hdr-text">
        <h3>Account Information</h3>
        <p>Read-only account details</p>
      </div>
    </div>
    <div class="card-body">
      <div style="display:grid;gap:12px;">
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--border);">
          <span style="font-size:13px;color:var(--muted);font-weight:600;">Email</span>
          <span style="font-size:13.5px;font-weight:700;"><%= user.email %></span>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--border);">
          <span style="font-size:13px;color:var(--muted);font-weight:600;">Role</span>
          <span class="info-chip"><%= user.role %></span>
        </div>
        <% if (user.rollNo) { %>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--border);">
          <span style="font-size:13px;color:var(--muted);font-weight:600;">Roll No</span>
          <span style="font-size:13.5px;font-weight:700;font-family:monospace;color:var(--acc);"><%= user.rollNo %></span>
        </div>
        <% } %>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;">
          <span style="font-size:13px;color:var(--muted);font-weight:600;">Account Status</span>
          <span style="font-size:12px;font-weight:700;padding:4px 11px;border-radius:20px;<%= user.isApproved ? 'background:rgba(16,185,129,.1);color:#047857;' : 'background:rgba(245,158,11,.1);color:#b45309;' %>">
            <%= user.isApproved ? '✓ Approved' : '⏳ Pending' %>
          </span>
        </div>
      </div>
    </div>
  </div>

</div><!-- /page -->

<script>
function setTheme(t){
  document.documentElement.setAttribute('data-theme',t);
  localStorage.setItem('rku-theme',t);
  syncThemeUI();
}
function syncThemeUI(){
  var isDark=document.documentElement.getAttribute('data-theme')==='dark';
  var tog=document.getElementById('themeToggle');
  var st=document.getElementById('themeStatus');
  if(tog) tog.classList.toggle('on',isDark);
  if(st) st.textContent = isDark?'Dark mode active':'Light mode active';
}
document.addEventListener('DOMContentLoaded',function(){
  var tog=document.getElementById('themeToggle');
  if(tog) tog.addEventListener('click',function(){
    var cur=document.documentElement.getAttribute('data-theme')||'light';
    setTheme(cur==='dark'?'light':'dark');
  });
  syncThemeUI();
});
if(document.readyState==='interactive'||document.readyState==='complete') syncThemeUI();
</script>
</body>
</html>
