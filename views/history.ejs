<!DOCTYPE html>
<html>
<head>
    <title>Attendance History</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        .filter-box { background: white; padding: 20px; border-radius: 8px; margin-bottom: 20px; display: flex; gap: 15px; align-items: flex-end; }
        .history-table { width: 100%; border-collapse: collapse; background: white; }
        .history-table th, .history-table td { padding: 12px; border: 1px solid #ddd; text-align: left; }
        .status-Present { color: green; font-weight: bold; }
        .status-Absent { color: red; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Attendance History</h1>
        <a href="/<%= user.role.toLowerCase() %>">Back to Dashboard</a>

        <form action="/attendance-history" method="GET" class="filter-box">
            <div>
                <label>Start Date</label>
                <input type="date" name="startDate" value="<%= startDate %>" required>
            </div>
            <div>
                <label>End Date</label>
                <input type="date" name="endDate" value="<%= endDate %>" required>
            </div>
            <button type="submit" class="btn" style="background: #3498db; color: white; border: none; padding: 10px;">Search Records</button>
        </form>

        <table class="history-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Subject</th>
                    <th>Time Slot</th>
                    <% if (user.role !== 'Student') { %> <th>Strength</th> <% } else { %> <th>Status</th> <% } %>
                </tr>
            </thead>
            <tbody>
                <% records.forEach(rec => { %>
                    <tr>
                        <td><%= rec.date %></td>
                        <td><%= rec.subject %></td>
                        <td><%= rec.manualTime %></td>
                        <td>
                            <% if (user.role === 'Student') { %>
                                <% const me = rec.students.find(s => s.studentId === user.rollNo); %>
                                <span class="status-<%= me ? me.status : 'N/A' %>"><%= me ? me.status : 'Not Marked' %></span>
                            <% } else { %>
                                <%= rec.students.filter(s => s.status === 'Present').length %> Present
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
</html>