<!DOCTYPE html>
<html>
<head><title>Leader - Take Attendance</title></head>
<body style="font-family: Arial; padding: 20px;">
    <nav style="background: #333; color: white; padding: 10px 20px; display: flex; justify-content: space-between; align-items: center;">
    <div>
        <strong>Attendance System</strong>
    </div>
    <div>
        <a href="/settings" style="color: white; margin-right: 15px; text-decoration: none;">⚙️ Settings</a>
        <a href="/logout" style="color: #ff4d4d; text-decoration: none; font-weight: bold;">Logout</a>
    </div>
</nav>
    <h1>Class Leader Portal (Level 3)</h1>
    <p>Mark attendance for today's periods.</p>
    <hr>
    
    <form action="/lock-period" method="POST">
        <input type="hidden" name="date" value="<%= new Date().toLocaleDateString('en-GB') %>">
    <label><b>Select Period:</b></label><br>
    <select name="periodNumber" required style="padding: 8px; width: 300px;">
        <option value="">-- Select Period --</option>
        <option value="1">Period 1</option>
        <option value="2">Period 2</option>
        <option value="3">Period 3</option>
        <option value="4">Period 4</option>
        <option value="5">Period 5</option>
    </select>
    <br><br>

    <label><b>Subject Name:</b></label><br>
    <input type="text" name="subject" placeholder="e.g. Data Structures" required style="padding: 8px; width: 300px;">
    <br><br>

    <label><b>Assign This Attendance to:</b></label><br>
    <select name="lecturerEmail" required style="padding: 8px; width: 300px; margin-bottom: 20px;">
        <option value="">-- Select Lecturer --</option>
        <% users.filter(u => u.role === 'Lecturer' && u.approved).forEach(function(l) { %>
            <option value="<%= l.email %>"><%= l.name %></option>
        <% }); %>
    </select>
    <br><br>

    <table border="1" cellpadding="10" style="width: 100%; border-collapse: collapse;">
        <tr style="background: #f2f2f2;">
            <th>Roll No</th> <th>Student Name</th>
            <th>Status (Present / Absent)</th>
        </tr>
        <% students.forEach(function(s) { %>
        <tr>
            <td><%= s.rollNo %></td>
            <td><%= s.name %></td>
            <td>
                <input type="radio" name="status_<%= s._id %>" value="Present" checked> Present
                <input type="radio" name="status_<%= s._id %>" value="Absent"> Absent
            </td>
        </tr>
        <% }); %>
    </table>
    <br>

    <button type="submit" style="padding: 10px 20px; background: orange; color: white; border: none; cursor: pointer;">
        Lock This Period
    </button>
</form> ```


<hr style="margin: 40px 0;">

<div style="text-align: center; border: 2px solid #2ecc71; padding: 20px; border-radius: 10px;">
    <h3>Final Daily Submission</h3>
    <p>Use this after all periods for the day are locked.</p>
    <form action="/generate-daily-pdf" method="POST">
        <button type="submit" style="padding: 15px 30px; background: #2ecc71; color: white; border: none; cursor: pointer; font-size: 16px; font-weight: bold;">
            Submit Entire Day & Generate PDF
        </button>
    </form>
</div>
</body>
</html>