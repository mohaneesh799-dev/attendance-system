<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leader Dashboard - Attendance</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        :root { --primary: #2c3e50; --accent: #3498db; --success: #27ae60; --whatsapp: #25D366; --danger: #e74c3c; }
        body { font-family: 'Segoe UI', sans-serif; background: #f4f7f6; padding: 20px; }
        .container { max-width: 1100px; margin: 0 auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .card { background: #fff; padding: 20px; border: 1px solid #ddd; border-radius: 8px; margin-bottom: 20px; }
        .grid-inputs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom: 15px; }
        input, select { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; box-sizing: border-box; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { padding: 12px; border: 1px solid #eee; text-align: left; }
        th { background: var(--primary); color: white; }
        .btn { padding: 12px 20px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; color: white; text-decoration: none; display: inline-block; }
        .btn-whatsapp { background: var(--whatsapp); width: 100%; margin-top: 15px; font-size: 16px; }
        .quick-mark-area { background: #e8f4fd; border-left: 5px solid var(--accent); padding: 15px; margin-bottom: 20px; border-radius: 5px; }
        /* Section Badge styling */
        .section-badge { background: var(--accent); color: white; padding: 4px 12px; border-radius: 20px; font-size: 0.9rem; font-weight: bold; }
    </style>
</head>
<body>

<div class="container">
    <div class="header" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <div>
            <h1>Leader Attendance Entry</h1>
            <p>User: <strong><%= user.name %></strong> | <span class="section-badge">Section: <%= user.section %></span></p>
        </div>
        <div>
            <a href="/attendance-history" class="btn" style="background: var(--primary);">View History</a>
            <a href="/logout" style="color: var(--danger); margin-left:15px; font-weight:bold; text-decoration:none;">Logout</a>
        </div>
    </div>

    <div class="quick-mark-area">
        <h4 style="margin-top:0;">⚡ Quick Attendance Mark (<%= user.section %>)</h4>
        <div style="display: flex; gap: 10px;">
            <input type="text" id="quickInput" placeholder="Enter Roll Numbers separated by commas (e.g., 101, 105, 120)">
            <button type="button" onclick="applyQuickMark()" class="btn" style="background: var(--accent); white-space: nowrap;">Mark Present</button>
        </div>
        <small style="color: #666;">Tip: Paste roll numbers only from your section.</small>
    </div>

    <form action="/lock-attendance" method="POST">
        <input type="hidden" name="section" value="<%= user.section %>">

        <div class="card">
            <div class="grid-inputs">
                <div>
                    <label>Lecturer</label>
                    <select name="lecturerEmail" required>
                        <option value="">-- Choose Lecturer --</option>
                        <% allUsers.filter(u => u.role === 'Lecturer').forEach(l => { %>
                            <option value="<%= l.email %>"><%= l.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label>Time Slot</label>
                    <input type="text" name="manualTime" placeholder="e.g. 10:30 AM" required>
                </div>
                <div>
                    <label>Date</label>
                    <input type="date" name="date" id="currentDate" value="<%= new Date().toISOString().split('T')[0] %>" required>
                </div>
            </div>

            <label>Subject</label>
            <select name="subject" required style="margin-bottom:15px;">
                <option value="">-- Choose Subject --</option>
                <% masterSubjects.forEach(sub => { %>
                    <option value="<%= sub.name %>"><%= sub.name %></option>
                <% }) %>
            </select>

            <h3>Student Attendance List - <%= user.section %></h3>
            <table id="studentTable">
                <thead>
                    <tr>
                        <th>Roll No</th>
                        <th>Student Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% let i = 0; %>
                    <% allUsers.forEach(u => { %>
                        <% if (u.role !== 'Master' && u.role !== 'Lecturer' && u.role !== 'Admin') { %>
                            <tr>
                                <td class="roll-col"><%= u.rollNo || u.rollno || 'N/A' %></td>
                                <td><%= u.name %> <%= u.role === 'Leader' ? '(Leader/You)' : '' %></td>
                                <td>
                                    <div style="display:flex; align-items:center; gap:10px;">
                                        <input type="hidden" name="students[<%=i%>][id]" value="<%= u.rollNo || u.rollno %>">
                                        <input type="hidden" name="students[<%=i%>][name]" value="<%= u.name %>">
                                        <input type="checkbox" name="students[<%=i%>][status]" value="Present" class="student-checkbox">
                                        <span>Mark Present</span>
                                    </div>
                                </td>
                            </tr>
                            <% i++; %>
                        <% } %>
                    <% }) %>
                </tbody>
            </table>
            <button type="submit" class="btn" style="background: var(--danger); width:100%; margin-top:15px;" onclick="return confirm('Lock this attendance for <%= user.section %>?')">Lock Period Attendance</button>
        </div>
    </form>

    <div class="card">
        <h3>Daily Report Management</h3>
        <div style="display: flex; gap: 15px; align-items: flex-end;">
            <div style="flex: 1;">
                <label>Filter By Status:</label>
                <select id="reportFilter">
                    <option value="">All Students</option>
                    <option value="Present">Present Only</option>
                    <option value="Absent">Absent Only</option>
                </select>
            </div>
            <button type="button" class="btn" style="background: var(--accent);" onclick="downloadPDF()">Download PDF</button>
        </div>
        <button type="button" class="btn btn-whatsapp" onclick="submitToWhatsApp()">
            Share Report via WhatsApp
        </button>
    </div>
</div>

<script>
    function applyQuickMark() {
        const input = document.getElementById('quickInput').value;
        if (!input.trim()) return alert("Please enter roll numbers.");
        const rollsToMark = input.split(',').map(r => r.trim().toLowerCase());
        const rows = document.querySelectorAll('#studentTable tbody tr');
        let count = 0;
        rows.forEach(row => {
            const rollNumberCell = row.querySelector('.roll-col').innerText.trim().toLowerCase();
            const checkbox = row.querySelector('.student-checkbox');
            if (rollsToMark.includes(rollNumberCell)) {
                checkbox.checked = true;
                count++;
            }
        });
        if (count > 0) {
            alert(`Marked ${count} students as Present.`);
            document.getElementById('quickInput').value = ""; 
        } else {
            alert("No matching roll numbers found in this section.");
        }
    }

    function downloadPDF() {
        const date = document.getElementById('currentDate').value;
        const filter = document.getElementById('reportFilter').value;
        if (!date) return alert("Select a date");
        window.open(`/generate-day-pdf/${date}?filter=${filter}`, '_blank');
    }

    function submitToWhatsApp() {
        const date = document.getElementById('currentDate').value;
        const filter = document.getElementById('reportFilter').value;
        if (!date) return alert("Please select a date first.");
        const baseUrl = window.location.origin;
        const pdfUrl = `${baseUrl}/generate-day-pdf/${date}?filter=${filter}`;
        const message = `*Attendance Report: ${date}*\n` +
                        `Section: <%= user.section %>\n` +
                        `Status Filter: ${filter || 'All Students'}\n\n` +
                        `📄 View PDF Report:\n${pdfUrl}`;
        window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(message)}`, '_blank');
    }
</script>

</body>
</html>