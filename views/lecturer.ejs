<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lecturer Dashboard - Verification</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        :root { --primary: #2c3e50; --accent: #3498db; --success: #27ae60; --danger: #e74c3c; }
        body { font-family: 'Segoe UI', sans-serif; background: #f4f7f6; padding: 20px; }
        .container { max-width: 1100px; margin: 0 auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; border-bottom: 2px solid #eee; padding-bottom: 15px; }
        
        /* Added Section Badge Styling */
        .section-badge { background: var(--accent); color: white; padding: 3px 10px; border-radius: 4px; font-size: 12px; font-weight: bold; margin-right: 10px; text-transform: uppercase; }
        
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: #fff; padding: 20px; border-radius: 8px; border-left: 5px solid var(--accent); box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .stat-card h4 { margin: 0; color: #666; font-size: 14px; text-transform: uppercase; }
        .stat-card p { margin: 10px 0 0; font-size: 24px; font-weight: bold; color: var(--primary); }

        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { padding: 12px; border: 1px solid #eee; text-align: left; }
        th { background: var(--primary); color: white; }
        
        .status-badge { padding: 5px 10px; border-radius: 15px; font-size: 12px; font-weight: bold; }
        .Present { background: #d4edda; color: #155724; }
        .Absent { background: #f8d7da; color: #721c24; }
        
        .btn { padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; color: white; text-decoration: none; display: inline-block; }
        .btn-history { background: var(--primary); }
        .btn-logout { background: var(--danger); }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <div>
            <h1>Lecturer Verification Portal</h1>
            <p>Welcome, <strong><%= user.name %></strong> | <span style="color: var(--accent); font-weight: bold;"><%= user.section %> Department</span></p>
        </div>
        <div>
            <a href="/attendance-history" class="btn btn-history">📅 Attendance History</a>
            <a href="/logout" class="btn btn-logout" style="margin-left:10px;">Logout</a>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <h4>Total Classes Today</h4>
            <p><%= todayRecords ? todayRecords.length : 0 %></p>
        </div>
        <div class="stat-card" style="border-left-color: var(--success);">
            <h4>Active Department</h4>
            <p><%= user.section %></p>
        </div>
    </div>

    <div class="card">
        <h3>Today's Attendance Logs (Marked by Leaders)</h3>
        <p style="font-size: 14px; color: #666;">View and verify the attendance marked for your subjects today.</p>

        <% if (todayRecords && todayRecords.length > 0) { %>
            <% todayRecords.forEach(record => { %>
                <div style="margin-top: 25px; border: 1px solid #ddd; border-radius: 8px; overflow: hidden;">
                    <div style="background: #f1f1f1; padding: 15px; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <span class="section-badge"><%= record.section || 'N/A' %></span>
                            <strong>Subject:</strong> <%= record.subject %> | 
                            <strong>Time:</strong> <%= record.manualTime %> | 
                            <strong>Date:</strong> <%= record.date %>
                        </div>
                        <div class="status-badge Present">
                            <%= record.students.filter(s => s.status === 'Present').length %> Students Present
                        </div>
                    </div>
                    
                    <table>
                        <thead>
                            <tr>
                                <th>Roll No</th>
                                <th>Student Name</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% record.students.forEach(student => { %>
                                <tr>
                                    <td><%= student.studentId || 'N/A' %></td>
                                    <td><%= student.name || student.studentName %></td>
                                    <td>
                                        <span class="status-badge <%= student.status %>">
                                            <%= student.status %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% }) %>
        <% } else { %>
            <div style="text-align: center; padding: 40px; color: #7f8c8d; background: #f9f9f9; border-radius: 8px; margin-top: 20px;">
                <p>No attendance records have been locked for <strong><%= user.section %></strong> today yet.</p>
                <a href="/attendance-history" style="color: var(--accent);">Check Previous History</a>
            </div>
        <% } %>
    </div>
</div>

</body>
</html>