<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Super Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --sidebar-width: 260px; }
        body { background-color: #f4f7f6; font-family: 'Segoe UI', sans-serif; }
        .sidebar { width: var(--sidebar-width); height: 100vh; position: fixed; background: #2c3e50; color: white; padding: 20px; }
        .main-content { margin-left: var(--sidebar-width); padding: 30px; }
        .nav-link { color: rgba(255,255,255,0.7); border-radius: 5px; margin: 5px 0; }
        .nav-link:hover, .nav-link.active { background: #34495e; color: white !important; }
        .stat-card { border: none; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        .table-container { background: white; padding: 25px; border-radius: 12px; box-shadow: 0 8px 20px rgba(0,0,0,0.08); }
    </style>
</head>
<body>

    <div class="sidebar d-flex flex-column">
        <h4 class="text-center mb-4"><i class="fas fa-user-shield me-2 text-warning"></i> Control Panel</h4>
        <hr>
        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item"><a href="/super-admin-dashboard" class="nav-link active">Overview</a></li>
            <li><a href="/attendance-history" class="nav-link text-white">Global History</a></li>
        </ul>
        <hr>
        <form action="/submit-super-admin-request" method="POST" class="px-2 mb-3">
             <button type="submit" class="btn btn-sm btn-outline-warning w-100">Request elevation</button>
        </form>
        <a href="/logout" class="nav-link text-danger border border-danger text-center">Logout</a>
    </div>

    <div class="main-content">
        <header class="mb-5">
            <h2 class="fw-bold m-0">System Overview</h2>
            <small class="text-muted">Admin: <%= (typeof user !== 'undefined') ? user.email : 'Not Logged In' %></small>
        </header>

        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card stat-card bg-primary text-white p-4">
                    <p class="mb-0 opacity-75">Total Users</p>
                    <h3><%= (typeof allUsers !== 'undefined') ? allUsers.length : 0 %></h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card stat-card bg-success text-white p-4">
                    <p class="mb-0 opacity-75">Active Subjects</p>
                    <h3><%= (typeof allSubjects !== 'undefined') ? allSubjects.length : 0 %></h3>
                </div>
            </div>
        </div>

        <div class="table-container">
            <h4 class="fw-bold mb-4">User Directory</h4>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>User</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof allUsers !== 'undefined' && allUsers.length > 0) { %>
                            <% allUsers.forEach(u => { %>
                            <tr>
                                <td>
                                    <strong><%= u.name %></strong><br>
                                    <small><%= u.email %></small>
                                </td>
                                <td><%= u.role %></td>
                                <td>
                                    <span class="badge <%= u.isApproved ? 'bg-success' : 'bg-danger' %>">
                                        <%= u.isApproved ? 'Approved' : 'Pending' %>
                                    </span>
                                </td>
                                <td>
                                    <form action="/delete-user/<%= u._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete user?')">
                                        <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="4" class="text-center">No users found.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>