<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= user.section %> — Master Dashboard</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<script>(function(){var t=localStorage.getItem('rku-theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
<style>
:root{
  --pri:#0f766e;--pri2:#134e4a;
  --acc:#f59e0b;--acc2:#d97706;
  --suc:#10b981;--dan:#ef4444;--war:#f59e0b;
  --bg:#f0fdf9;--card:#fff;--border:#ccfbf1;
  --text:#0d1f1c;--muted:#5a7a76;
  --input-bg:#f0fdf9;--input-bd:#99f6e4;
  --shadow:0 2px 16px rgba(15,118,110,.07);
  --shadow-lg:0 8px 36px rgba(15,118,110,.13);
  --radius:16px;--radius-sm:10px;--sidebar-w:260px;
}
[data-theme="dark"]{
  --bg:#051714;--card:#071f1c;--border:#0d3330;
  --text:#b2e8e2;--muted:#4a6e6a;
  --input-bg:#051714;--input-bd:#0d3330;
  --shadow:0 2px 20px rgba(0,0,0,.4);
  --shadow-lg:0 8px 40px rgba(0,0,0,.6);
  --pri:#0d9488;--pri2:#0f766e;
  --acc:#fbbf24;--acc2:#f59e0b;
  --suc:#34d399;--dan:#f87171;--war:#fbbf24;
}
*{box-sizing:border-box;margin:0;padding:0;}
html,body{transition:background .25s,color .25s;}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--bg);color:var(--text);display:flex;min-height:100vh;}

/* ══ SIDEBAR ══ */
.sidebar{width:var(--sidebar-w);background:linear-gradient(180deg,var(--pri2) 0%,var(--pri) 100%);height:100vh;position:fixed;top:0;left:0;display:flex;flex-direction:column;z-index:400;overflow-y:auto;transition:transform .28s cubic-bezier(.4,0,.2,1);box-shadow:4px 0 28px rgba(0,0,0,.2);}
.sb-top{padding:22px 16px 0;}
.brand{display:flex;align-items:center;gap:11px;margin-bottom:18px;}
.brand-icon{width:42px;height:42px;flex-shrink:0;border-radius:12px;background:linear-gradient(135deg,var(--acc),#f97316);display:flex;align-items:center;justify-content:center;font-size:18px;color:#fff;box-shadow:0 4px 14px rgba(245,158,11,.4);}
.brand-name{font-size:.9rem;font-weight:800;color:#fff;}
.brand-sub{font-size:10.5px;color:rgba(255,255,255,.4);margin-top:2px;}
.user-chip{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);border-radius:var(--radius-sm);padding:12px 13px;margin-bottom:14px;}
.user-chip small{font-size:10px;color:rgba(255,255,255,.35);text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:4px;}
.user-chip strong{color:#fff;font-size:13px;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:7px;}
.section-pill{display:inline-flex;align-items:center;gap:5px;background:var(--acc);color:#fff;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700;}

.sw-block{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:var(--radius-sm);padding:10px 12px;margin-bottom:10px;}
.sw-block small{font-size:10px;color:rgba(255,255,255,.35);text-transform:uppercase;display:flex;align-items:center;gap:5px;margin-bottom:6px;}
.sw-row{display:flex;gap:6px;}
.sw-sel{flex:1;padding:6px 9px;border-radius:7px;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.08);color:#fff;font-size:12px;font-family:inherit;outline:none;cursor:pointer;}
.sw-sel option{background:#0f766e;color:#fff;}
.sw-go{padding:6px 11px;border-radius:7px;background:var(--acc);color:#fff;border:none;font-size:12px;font-weight:700;cursor:pointer;transition:.18s;}
.sw-go:hover{background:var(--acc2);}

.sb-nav{padding:0 10px 14px;flex:1;}
.nav-lbl{font-size:10px;text-transform:uppercase;letter-spacing:.6px;color:rgba(255,255,255,.28);padding:10px 8px 4px;}
.nav-link{display:flex;align-items:center;gap:10px;padding:10px 11px;border-radius:var(--radius-sm);margin-bottom:2px;color:rgba(255,255,255,.52);text-decoration:none;font-size:13px;font-weight:600;transition:.18s;border:none;background:none;cursor:pointer;width:100%;text-align:left;}
.nav-link:hover{background:rgba(255,255,255,.08);color:#fff;}
.nav-link.active{background:rgba(245,158,11,.22);color:#fde68a;border-left:3px solid var(--acc);padding-left:8px;}
.nav-link i{width:18px;text-align:center;flex-shrink:0;font-size:13.5px;}
.nav-link.danger{color:rgba(248,113,113,.65);}
.nav-link.danger:hover{background:rgba(239,68,68,.12);color:var(--dan);}
.nav-link.export{color:rgba(52,211,153,.65);}
.nav-link.export:hover{background:rgba(16,185,129,.12);color:var(--suc);}
.sb-foot{padding:11px 14px;border-top:1px solid rgba(255,255,255,.07);}
.clock-sb{font-size:.78rem;color:rgba(255,255,255,.3);text-align:center;font-variant-numeric:tabular-nums;}

/* ══ OVERLAY + HAM ══ */
.sb-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:350;}
.sb-overlay.open{display:block;}
.ham{display:none;position:fixed;top:14px;left:14px;z-index:500;background:var(--pri2);border:none;color:#fff;padding:10px 13px;border-radius:var(--radius-sm);font-size:18px;cursor:pointer;box-shadow:0 3px 14px rgba(0,0,0,.35);}

/* ══ MOBILE TOPBAR ══ */
.mob-topbar{display:none;position:fixed;top:0;left:0;right:0;height:54px;z-index:300;background:var(--pri2);padding:0 16px 0 60px;align-items:center;justify-content:space-between;box-shadow:0 2px 12px rgba(0,0,0,.2);}
.mob-topbar span{color:#fff;font-size:13.5px;font-weight:700;}
.btn-theme-sm{background:rgba(255,255,255,.1);border:none;color:rgba(255,255,255,.7);padding:7px 11px;border-radius:7px;cursor:pointer;font-size:14px;transition:.18s;}

/* ══ MAIN ══ */
.main{margin-left:var(--sidebar-w);flex:1;padding:28px 28px 60px;min-width:0;}

/* ══ PAGE HEADER ══ */
.pg-hdr{background:linear-gradient(135deg,var(--pri2) 0%,var(--pri) 55%,#0d9488 100%);border-radius:var(--radius);padding:22px 26px;margin-bottom:24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;box-shadow:0 6px 28px rgba(15,118,110,.3);position:relative;overflow:hidden;}
.pg-hdr::before{content:'';position:absolute;right:-50px;top:-50px;width:180px;height:180px;border-radius:50%;background:rgba(255,255,255,.04);pointer-events:none;}
.pg-hdr h1{font-size:1.3rem;font-weight:900;color:#fff;letter-spacing:-.2px;}
.pg-hdr p{font-size:13px;color:rgba(255,255,255,.65);margin-top:4px;}
.hdr-right{display:flex;align-items:center;gap:10px;}
.btn-theme{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);color:#fff;padding:7px 11px;border-radius:var(--radius-sm);cursor:pointer;font-size:14px;transition:.2s;}
.btn-theme:hover{background:rgba(255,255,255,.2);}

/* ══ STATS ══ */
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px;}
.stat-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:18px;box-shadow:var(--shadow);transition:.22s;display:flex;align-items:center;gap:14px;}
.stat-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg);}
.stat-icon{width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;}
.stat-body small{font-size:10.5px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);font-weight:700;display:block;margin-bottom:3px;}
.stat-body h2{font-size:1.85rem;font-weight:900;line-height:1;}

/* ══ CARD ══ */
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);margin-bottom:20px;overflow:hidden;}
.card-hdr{padding:16px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;background:var(--input-bg);}
.card-hdr h3{font-size:.95rem;font-weight:800;display:flex;align-items:center;gap:8px;margin:0;}
.card-body{padding:22px;}

/* ══ FORM FIELDS ══ */
.fc{padding:10px 13px;border:1.5px solid var(--input-bd);border-radius:var(--radius-sm);font-size:13.5px;font-family:inherit;background:var(--input-bg);color:var(--text);outline:none;transition:.18s;}
.fc:focus{border-color:var(--pri);box-shadow:0 0 0 3px rgba(15,118,110,.12);}
select.fc option{background:var(--card);color:var(--text);}

.subject-form{display:flex;gap:10px;margin-bottom:18px;flex-wrap:wrap;}
.subject-form input{flex:1;min-width:180px;}

/* ══ TABLE ══ */
.tbl-wrap{overflow-x:auto;}
table{width:100%;border-collapse:collapse;min-width:460px;}
thead th{background:var(--input-bg);padding:11px 15px;text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);border-bottom:2px solid var(--border);white-space:nowrap;}
tbody td{padding:12px 15px;border-bottom:1px solid var(--border);font-size:13.5px;vertical-align:middle;}
tbody tr:last-child td{border-bottom:none;}
tbody tr:hover td{background:rgba(15,118,110,.025);}

/* ══ BADGES ══ */
.badge{padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;}
.b-student{background:rgba(15,118,110,.12);color:var(--pri);}
.b-lecturer{background:rgba(16,185,129,.12);color:var(--suc);}
.b-leader{background:rgba(245,158,11,.12);color:var(--war);}
.b-master{background:rgba(239,68,68,.1);color:var(--dan);}
.b-pending{background:rgba(245,158,11,.1);color:#b45309;border:1px solid rgba(245,158,11,.2);}
.b-active{color:var(--suc);font-size:12px;font-weight:700;display:inline-flex;align-items:center;gap:4px;}

/* ══ BUTTONS ══ */
.btn{display:inline-flex;align-items:center;gap:7px;padding:8px 16px;border:none;border-radius:var(--radius-sm);font-size:13px;font-weight:700;cursor:pointer;transition:.18s;text-decoration:none;white-space:nowrap;font-family:inherit;}
.btn:hover{opacity:.88;transform:translateY(-1px);}
.btn:active{transform:scale(.98);}
.btn-pri{background:var(--pri);color:#fff;}
.btn-acc{background:var(--acc);color:#fff;}
.btn-suc{background:var(--suc);color:#fff;}
.btn-dan{background:rgba(239,68,68,.1);color:var(--dan);border:1px solid rgba(239,68,68,.2);}
.btn-dan:hover{background:var(--dan);color:#fff;}
.btn-ghost{background:var(--input-bg);color:var(--text);border:1.5px solid var(--input-bd);}
.btn-ghost:hover{border-color:var(--pri);color:var(--pri);}

/* ══ BULK BAR ══ */
.bulk-bar{position:sticky;top:0;z-index:20;background:var(--input-bg);border:1.5px solid var(--border);border-radius:var(--radius-sm);padding:12px 16px;display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:14px;box-shadow:0 2px 8px rgba(0,0,0,.06);}
.bulk-bar select{flex:1;min-width:140px;}

/* ══ SEARCH ══ */
.search-wrap{position:relative;width:280px;max-width:100%;}
.search-wrap i{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:13px;pointer-events:none;}
.search-wrap input{width:100%;padding-left:34px;}

/* ══ TAB PILLS ══ */
.tab-btn{padding:6px 14px;border:1.5px solid var(--input-bd);border-radius:20px;cursor:pointer;font-size:12.5px;font-weight:700;background:var(--card);color:var(--muted);transition:.18s;font-family:inherit;}
.tab-btn:hover,.tab-btn.active{background:var(--pri);color:#fff;border-color:var(--pri);}
.tab-btn.warn{border-color:rgba(245,158,11,.35);color:var(--war);}
.tab-btn.warn.active,.tab-btn.warn:hover{background:var(--war);color:#fff;border-color:var(--war);}

/* ══ CSV IMPORT ══ */
.import-card{border:2px dashed rgba(15,118,110,.25)!important;background:rgba(15,118,110,.02)!important;}
.import-form{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:14px;}
.import-form input[type="file"]{flex:1;min-width:180px;padding:10px 12px;border:1.5px solid var(--input-bd);border-radius:var(--radius-sm);background:var(--card);color:var(--text);font-family:inherit;font-size:13px;}

/* ══ ALERTS ══ */
.alert{display:flex;align-items:center;gap:10px;padding:13px 16px;border-radius:var(--radius-sm);margin-bottom:18px;font-size:13.5px;animation:slideIn .3s ease;}
@keyframes slideIn{from{opacity:0;transform:translateY(-6px);}to{opacity:1;transform:none;}}
.alert-ok{background:rgba(16,185,129,.08);color:#047857;border:1px solid rgba(16,185,129,.2);border-left:4px solid var(--suc);}
.alert-err{background:rgba(239,68,68,.07);color:#b91c1c;border:1px solid rgba(239,68,68,.18);border-left:4px solid var(--dan);}
[data-theme="dark"] .alert-ok{background:rgba(16,185,129,.1);color:var(--suc);}
[data-theme="dark"] .alert-err{background:rgba(239,68,68,.1);color:var(--dan);}

/* ══ RESPONSIVE ══ */
@media(max-width:1060px){.stats-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:768px){
  .sidebar{transform:translateX(-100%);}
  .sidebar.open{transform:translateX(0);}
  .main{margin-left:0;padding:68px 14px 40px;}
  .ham{display:flex;}
  .mob-topbar{display:flex;}
  .stats-grid{grid-template-columns:1fr 1fr;gap:10px;}
  .stat-card{padding:14px;}
  .stat-icon{width:40px;height:40px;font-size:1rem;}
  .stat-body h2{font-size:1.5rem;}
  .card-body,.card-hdr{padding:14px 16px;}
  .pg-hdr{padding:18px 16px;border-radius:14px;}
  .bulk-bar{flex-direction:column;align-items:stretch;}
  .bulk-bar select,.bulk-bar .btn{width:100%;justify-content:center;}
  .search-wrap{width:100%;}
}
@media(max-width:420px){
  .stats-grid{grid-template-columns:1fr;}
  .subject-form{flex-direction:column;}
}
</style>
</head>
<body>

<!-- Hamburger -->
<button class="ham" id="hamBtn" aria-label="Menu"><i class="fas fa-bars"></i></button>

<!-- Mobile Topbar -->
<div class="mob-topbar" id="mobTopbar">
  <span><i class="fas fa-shield-halved" style="color:var(--acc);margin-right:6px;"></i> Master — <%= user.section %></span>
  <button id="themeToggleMob" class="btn-theme-sm" aria-label="Toggle theme"><i class="fas fa-moon" id="themeIconMob"></i></button>
</div>

<!-- Sidebar Overlay -->
<div class="sb-overlay" id="sidebarOverlay"></div>

<!-- Sidebar -->
<aside class="sidebar" id="sidebar">
  <div class="sb-top">
    <div class="brand">
      <div class="brand-icon"><i class="fas fa-shield-halved"></i></div>
      <div>
        <div class="brand-name">MASTER</div>
        <div class="brand-sub">Command Center</div>
      </div>
    </div>
    <div class="user-chip">
      <small>Authorized Faculty</small>
      <strong><%= user.name %></strong>
      <span class="section-pill"><i class="fas fa-layer-group" style="font-size:10px;"></i> <%= user.section %></span>
    </div>

    <% var masterRoles = user.roles && user.roles.length > 1 ? user.roles : null; %>
    <% if (masterRoles) { %>
    <div class="sw-block">
      <small><i class="fas fa-shuffle"></i> Switch Role</small>
      <form action="/switch-role" method="POST" class="sw-row">
        <select name="targetRole" class="sw-sel">
          <% masterRoles.forEach(function(r){ %>
            <option value="<%= r %>" <%= r===user.role?'selected':'' %>><%= r %></option>
          <% }); %>
        </select>
        <button type="submit" class="sw-go">Go</button>
      </form>
    </div>
    <% } %>

    <% var masterSections = (user.sections && user.sections.length > 1) ? user.sections : null; %>
    <% if (masterSections) { %>
    <div class="sw-block">
      <small><i class="fas fa-layer-group"></i> Change Division</small>
      <form action="/switch-section" method="POST" class="sw-row">
        <select name="targetSection" class="sw-sel">
          <% masterSections.forEach(function(s){ %>
            <option value="<%= s %>" <%= s===user.section?'selected':'' %>>
              <% if (s === user.section) { %>[Active] <% } %><%= s %>
            </option>
          <% }); %>
        </select>
        <button type="submit" class="sw-go" title="Switch Division"><i class="fas fa-arrow-right"></i></button>
      </form>
    </div>
    <% } %>
  </div>

  <nav class="sb-nav">
    <div class="nav-lbl">Navigation</div>
    <a href="/master" class="nav-link active"><i class="fas fa-house"></i> Dashboard</a>
    <a href="/attendance-history" class="nav-link"><i class="fas fa-clock-rotate-left"></i> Attendance History</a>
    <a href="/settings" class="nav-link"><i class="fas fa-gear"></i> Settings</a>
    <a href="/export-attendance" class="nav-link export"><i class="fas fa-file-csv"></i> Export CSV</a>
    <div class="nav-lbl" style="margin-top:8px;">Account</div>
    <a href="/logout" class="nav-link danger"><i class="fas fa-power-off"></i> Logout</a>
  </nav>

  <div class="sb-foot">
    <div class="clock-sb" id="sidebarClock">--:--:--</div>
  </div>
</aside>

<!-- Main Content -->
<main class="main">

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-ok"><i class="fas fa-circle-check"></i> <%= success %></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-err"><i class="fas fa-circle-exclamation"></i> <%= error %></div>
  <% } %>

  <!-- Page Header -->
  <div class="pg-hdr">
    <div>
      <h1><i class="fas fa-shield-halved" style="opacity:.8;margin-right:8px;"></i> Section Command Center</h1>
      <p>Managing all records for <strong style="color:#fff;"><%= user.section %></strong></p>
    </div>
    <div class="hdr-right">
      <span id="desktopClock" style="font-size:13px;color:rgba(255,255,255,.6);font-variant-numeric:tabular-nums;"></span>
      <button id="themeToggle" class="btn-theme" aria-label="Toggle theme"><i class="fas fa-moon" id="themeIcon"></i></button>
    </div>
  </div>

  <!-- Stats -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(15,118,110,.12);color:var(--pri);"><i class="fas fa-users"></i></div>
      <div class="stat-body"><small>Total Users</small><h2><%= stats.total %></h2></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(239,68,68,.1);color:var(--dan);"><i class="fas fa-user-clock"></i></div>
      <div class="stat-body"><small>Pending Approval</small><h2 style="color:var(--dan);"><%= stats.pending %></h2></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(16,185,129,.1);color:var(--suc);"><i class="fas fa-book-open"></i></div>
      <div class="stat-body"><small>Subjects</small><h2 style="color:var(--suc);"><%= stats.subjects %></h2></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon" style="background:rgba(245,158,11,.1);color:var(--war);"><i class="fas fa-user-graduate"></i></div>
      <div class="stat-body"><small>Students</small><h2 style="color:var(--war);"><%= stats.students %></h2></div>
    </div>
  </div>

  <!-- Subject Management -->
  <div class="card">
    <div class="card-hdr">
      <h3><i class="fas fa-book" style="color:var(--acc);"></i> Subject Management</h3>
    </div>
    <div class="card-body">
      <form action="/add-subject" method="POST" class="subject-form">
        <input type="hidden" name="section" value="<%= user.section %>">
        <input type="text" name="subjectName" class="fc" placeholder="New Subject Name (e.g. Mathematics)" required style="flex:1;min-width:180px;">
        <button type="submit" class="btn btn-acc"><i class="fas fa-plus"></i> Add Subject</button>
      </form>

      <% if (masterSubjects && masterSubjects.length > 0) { %>
        <div class="tbl-wrap">
          <table>
            <thead><tr><th><i class="fas fa-book-open"></i> Subject Name</th><th style="text-align:right;">Actions</th></tr></thead>
            <tbody>
              <% masterSubjects.forEach(function(sub) { %>
              <tr>
                <td>
                  <strong><%= sub.name %></strong>
                  <% if (sub.code) { %><span style="font-size:11.5px;color:var(--muted);margin-left:8px;">(<%= sub.code %>)</span><% } %>
                </td>
                <td style="text-align:right;">
                  <form action="/delete-subject/<%= sub._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete subject: <%= sub.name %>?')">
                    <button type="submit" class="btn btn-dan" style="padding:6px 12px;font-size:12px;">
                      <i class="fas fa-trash-alt"></i> Remove
                    </button>
                  </form>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div style="text-align:center;padding:30px;color:var(--muted);">
          <i class="fas fa-book" style="font-size:2rem;opacity:.2;display:block;margin-bottom:10px;"></i>
          <p>No subjects added yet. Use the form above to add one.</p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- User Management -->
  <div class="card">
    <div class="card-hdr">
      <h3><i class="fas fa-users" style="color:var(--acc);"></i> User Management</h3>
    </div>
    <div class="card-body">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:16px;">
        <span style="font-size:13px;color:var(--muted);">Manage, approve and assign roles to users in this section.</span>
        <div class="search-wrap">
          <i class="fas fa-search"></i>
          <input type="text" id="userSearch" class="fc" placeholder="Search name or email…">
        </div>
      </div>

      <div style="display:flex;gap:7px;flex-wrap:wrap;margin-bottom:16px;" id="roleTabs">
        <button type="button" class="tab-btn active" onclick="filterRole('all',this)">All (<%= stats.total %>)</button>
        <button type="button" class="tab-btn" onclick="filterRole('Student',this)">
          <i class="fas fa-graduation-cap" style="color:var(--acc);"></i> Students (<%= stats.students %>)
        </button>
        <% var _pendUsers = allUsers.filter(function(u){ return !u.isApproved; }); %>
        <% if (_pendUsers.length > 0) { %>
        <button type="button" class="tab-btn warn" onclick="filterRole('pending',this)">
          ⏳ Pending (<%= _pendUsers.length %>)
        </button>
        <% } %>
        <% ['Leader','Lecturer','Master'].forEach(function(r){
           var _rc = allUsers.filter(function(u){ return u.role===r; }).length;
           if (_rc > 0) { %>
        <button type="button" class="tab-btn" onclick="filterRole('<%= r %>',this)"><%= r %>s (<%= _rc %>)</button>
        <% }}); %>
      </div>

      <form action="/bulk-approve" method="POST">
        <input type="hidden" name="section" value="<%= user.section %>">
        <div class="bulk-bar">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13.5px;font-weight:700;">
            <input type="checkbox" id="selectAll" style="width:16px;height:16px;accent-color:var(--pri);cursor:pointer;">
            Select All
          </label>
          <select name="targetRole" required class="fc" style="flex:1;min-width:140px;">
            <option value="" disabled selected>Assign Role…</option>
            <option value="Student">Student</option>
            <option value="Leader">Leader</option>
            <option value="Lecturer">Lecturer</option>
          </select>
          <button type="submit" class="btn btn-suc">
            <i class="fas fa-user-check"></i> Bulk Update &amp; Approve
          </button>
        </div>

        <div class="tbl-wrap">
          <table id="userTable">
            <thead>
              <tr>
                <th style="width:44px;"></th>
                <th>User Details</th>
                <th>Role &amp; Status</th>
                <th style="text-align:center;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (allUsers && allUsers.length > 0) { %>
                <% allUsers.forEach(function(u) { %>
                <tr class="u-row" data-role="<%= u.role %>" data-pend="<%= !u.isApproved ? 'y' : 'n' %>">
                  <td>
                    <input type="checkbox" name="userIds[]" value="<%= u._id %>" class="user-cb" style="width:16px;height:16px;accent-color:var(--pri);cursor:pointer;">
                  </td>
                  <td>
                    <strong><%= u.name %></strong>
                    <div style="font-size:12px;color:var(--muted);"><i class="fas fa-envelope" style="opacity:.5;font-size:10px;"></i> <%= u.email %></div>
                    <% if (u.rollNo) { %>
                    <div style="font-size:11.5px;color:var(--pri);font-family:monospace;font-weight:700;">Roll: <%= u.rollNo %></div>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge b-<%= (u.role||'').toLowerCase() %>"><%= u.role || 'Unassigned' %></span>
                    <% if (u.isApproved) { %>
                      <span class="b-active" style="margin-left:8px;"><i class="fas fa-circle-check"></i> Active</span>
                    <% } else { %>
                      <span class="badge b-pending" style="margin-left:6px;">⏳ Pending</span>
                    <% } %>
                  </td>
                  <td style="text-align:center;">
                    <form action="/delete-user/<%= u._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Permanently delete <%= u.name %>?')">
                      <button type="submit" class="btn btn-dan" style="padding:6px 11px;font-size:12px;" title="Delete User">
                        <i class="fas fa-trash-alt"></i>
                      </button>
                    </form>
                  </td>
                </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="4" style="text-align:center;padding:50px 20px;color:var(--muted);">
                    <i class="fas fa-user-slash" style="font-size:2rem;opacity:.2;display:block;margin-bottom:12px;"></i>
                    No users found in this section.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </form>
    </div>
  </div>

  <!-- Bulk CSV Import -->
  <div class="card import-card">
    <div class="card-hdr">
      <h3><i class="fas fa-file-import" style="color:var(--pri);"></i> Bulk Student Import (CSV)</h3>
    </div>
    <div class="card-body">
      <p style="color:var(--muted);font-size:13.5px;">
        Quickly add multiple students. The CSV must have headers:
        <code style="background:var(--input-bg);padding:2px 8px;border-radius:5px;font-size:12.5px;border:1px solid var(--border);">name, email, studentId</code>
      </p>
      <form action="/upload-users" method="POST" enctype="multipart/form-data" class="import-form">
        <input type="hidden" name="section" value="<%= user.section %>">
        <input type="file" name="csvFile" accept=".csv" required>
        <button type="submit" class="btn btn-acc"><i class="fas fa-upload"></i> Upload &amp; Auto-Approve</button>
      </form>
    </div>
  </div>

</main>

<script>
(function(){
  function setTheme(t){
    document.documentElement.setAttribute('data-theme',t);
    localStorage.setItem('rku-theme',t);
    syncIcons(t);
  }
  function syncIcons(t){
    var isDark=(t||'light')==='dark';
    var cls=isDark?'fas fa-sun':'fas fa-moon';
    ['themeIcon','themeIconMob'].forEach(function(id){var el=document.getElementById(id);if(el) el.className=cls;});
  }
  function updateClock(){
    var now=new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',second:'2-digit'});
    ['desktopClock','sidebarClock'].forEach(function(id){var el=document.getElementById(id);if(el) el.textContent=now;});
  }
  function openSidebar(){document.getElementById('sidebar').classList.add('open');document.getElementById('sidebarOverlay').classList.add('open');}
  function closeSidebar(){document.getElementById('sidebar').classList.remove('open');document.getElementById('sidebarOverlay').classList.remove('open');}

  document.addEventListener('DOMContentLoaded',function(){
    syncIcons(document.documentElement.getAttribute('data-theme'));
    ['themeToggle','themeToggleMob'].forEach(function(id){
      var el=document.getElementById(id);
      if(el) el.addEventListener('click',function(){
        var cur=document.documentElement.getAttribute('data-theme')||'light';
        setTheme(cur==='dark'?'light':'dark');
      });
    });
    var hamBtn=document.getElementById('hamBtn');
    var overlay=document.getElementById('sidebarOverlay');
    if(hamBtn) hamBtn.addEventListener('click',openSidebar);
    if(overlay) overlay.addEventListener('click',closeSidebar);
    updateClock(); setInterval(updateClock,1000);

    var _curRole='all';
    window.filterRole=function(role,btn){
      _curRole=role;
      document.querySelectorAll('#roleTabs .tab-btn').forEach(function(b){b.classList.remove('active');});
      if(btn) btn.classList.add('active');
      applyRoleFilter();
    };
    function applyRoleFilter(){
      var q=(document.getElementById('userSearch')?document.getElementById('userSearch').value:'').toLowerCase();
      document.querySelectorAll('#userTable tbody tr.u-row').forEach(function(r){
        var rm=_curRole==='all'||(_curRole==='pending'&&r.dataset.pend==='y')||r.dataset.role===_curRole;
        var qm=!q||r.textContent.toLowerCase().includes(q);
        r.style.display=(rm&&qm)?'':'none';
      });
    }
    var searchEl=document.getElementById('userSearch');
    if(searchEl) searchEl.addEventListener('input',applyRoleFilter);
    var selAll=document.getElementById('selectAll');
    if(selAll) selAll.addEventListener('change',function(){
      var checked=this.checked;
      document.querySelectorAll('.user-cb').forEach(function(cb){if(cb.closest('tr').style.display!=='none') cb.checked=checked;});
    });
    document.querySelectorAll('.user-cb').forEach(function(cb){
      cb.addEventListener('change',function(){if(!this.checked){var sa=document.getElementById('selectAll');if(sa) sa.checked=false;}});
    });
    document.querySelectorAll('.alert').forEach(function(a){
      setTimeout(function(){a.style.transition='opacity .5s';a.style.opacity='0';setTimeout(function(){if(a.parentNode)a.parentNode.removeChild(a);},500);},5000);
    });
  });
  if(document.readyState!=='loading') syncIcons(document.documentElement.getAttribute('data-theme'));
})();
</script>
</body>
</html>
