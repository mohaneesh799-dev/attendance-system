<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leader Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .container { padding: 20px; font-family: sans-serif; }
        .panel { background: #f4f4f4; padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #ddd; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #ccc; padding: 10px; text-align: left; }
        th { background-color: #eee; }
        .btn { padding: 10px 15px; border: none; cursor: pointer; border-radius: 4px; color: white; text-decoration: none; display: inline-block; }
        .btn-lock { background-color: #d9534f; }
        .btn-pdf { background-color: #007bff; }
        .btn-view { background-color: #6c757d; }
        .btn-whatsapp { background-color: #25D366; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Leader Dashboard</h1>
        <p>Welcome, <%= user.name %></p>

        <div class="panel">
            <h3>Quick Attendance Panel</h3>
            <p>Type Student Names or Roll Numbers (separated by commas) to mark them Present:</p>
            <input type="text" id="quickInput" placeholder="e.g. Navaneeth, 102, Reddy" style="width: 70%; padding: 10px;">
            <button type="button" class="btn btn-pdf" onclick="markQuickAttendance()">Mark Present</button>
        </div>

        <form action="/lock-attendance" method="POST" id="attendanceForm">
            <div class="panel">
                <h3>Step 1: Select Lecturer & Period</h3>
                <label>Assign to Lecturer:</label>
                <select name="lecturerEmail" required>
                    <option value="">-- Select Lecturer --</option>
                    <% allUsers.filter(u => u.role === 'Lecturer').forEach(lecturer => { %>
                        <option value="<%= lecturer.email %>"><%= lecturer.name %></option>
                    <% }); %>
                </select>

                <label style="margin-left: 20px;">Subject:</label>
                <input type="text" name="subject" placeholder="e.g. DSA" required>
                
                <label style="margin-left: 20px;">Date:</label>
                <input type="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>">
            </div>

            <h3>Step 2: Mark Student Attendance</h3>
            <table>
                <thead>
                    <tr>
                        <th>Student Name / Roll No</th>
                        <th>Present?</th>
                    </tr>
                </thead>
                <tbody id="studentTable">
                    <% allUsers.filter(u => u.role === 'Student').forEach((student, index) => { %>
                        <tr>
                            <td>
                                <%= student.name %>
                                <input type="hidden" name="students[<%= index %>][id]" value="<%= student._id %>">
                                <input type="hidden" name="students[<%= index %>][name]" value="<%= student.name %>">
                            </td>
                            <td style="text-align: center;">
                                <input type="checkbox" name="students[<%= index %>][status]" value="Present" class="attendance-check">
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>

            <br>
            <button type="submit" class="btn btn-lock">Lock Attendance & Send to Lecturer</button>
        </form>

        <hr>

        <div class="panel">
            <h3>Step 3: Daily Summary & Submission</h3>
            <div style="display: flex; gap: 10px; align-items: center;">
                <form action="/generate-pdf" method="POST" style="display: inline;">
                    <button type="submit" class="btn btn-pdf">Generate Daily PDF</button>
                </form>

                <a href="/view-pdf" target="_blank" class="btn btn-view">Check PDF</a>

                <a id="whatsappBtn" href="#" class="btn btn-whatsapp">Submit to Master via WhatsApp</a>
            </div>
            
            <h4>Today's Locked Subjects List:</h4>
            <table>
                <thead>
                    <tr>
                        <th>Subject</th>
                        <th>Lecturer</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof todayRecords !== 'undefined' && todayRecords.length > 0) { %>
                        <% todayRecords.forEach(record => { %>
                            <tr>
                                <td><%= record.subject %></td>
                                <td><%= record.lecturerEmail %></td>
                                <td><span style="color: green; font-weight: bold;">Locked</span></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="3">No subjects locked yet for today.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        // Logic for Quick Attendance Panel
        function markQuickAttendance() {
            const input = document.getElementById('quickInput').value.toLowerCase();
            const searchTerms = input.split(',').map(s => s.trim());
            
            const rows = document.querySelectorAll('#studentTable tr');
            rows.forEach(row => {
                const studentData = row.cells[0].innerText.toLowerCase();
                const checkbox = row.querySelector('.attendance-check');
                
                // If the name or roll number matches any term in the input
                if (searchTerms.some(term => term !== "" && studentData.includes(term))) {
                    checkbox.checked = true;
                    row.style.backgroundColor = "#eaffea"; // Visual feedback
                }
            });
        }

        // Logic for WhatsApp Link
        document.getElementById('whatsappBtn').addEventListener('click', function(e) {
            const masterPhone = "919876543210"; // REPLACE WITH MASTER'S PHONE (include country code)
            const url = window.location.origin + "/view-pdf";
            const text = encodeURIComponent(`Hello Master, the daily attendance report is ready.\nYou can view it here: ${url}`);
            this.href = `https://wa.me/${masterPhone}?text=${text}`;
        });
    </script>
</body>
</html>